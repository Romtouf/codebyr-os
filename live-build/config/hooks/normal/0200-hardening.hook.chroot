#!/bin/sh
# Codebyr OS — durcissement appliqué à l'image (Phase 1).
# La sécurité est le défaut : l'utilisateur n'a rien à configurer.
set -e

echo "P: Codebyr — durcissement du système"

# — AppArmor en enforce dès le démarrage —
systemctl enable apparmor.service || true

# — Pare-feu nftables : entrée fermée par défaut —
# Les règles sont livrées par codebyr-tools (voir le fichier lui-même) : écrites
# ici jusqu'à la 1.20.0, elles n'atteignaient jamais une machine installée.
install -m 0755 /usr/share/codebyr/nftables.conf /etc/nftables.conf
systemctl enable nftables.service || true

# — Mises à jour de sécurité automatiques —
cat > /etc/apt/apt.conf.d/20auto-upgrades <<'EOF'
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
EOF
systemctl enable unattended-upgrades.service || true

# — Durcissement noyau (sysctl) —
cat > /etc/sysctl.d/90-codebyr-hardening.conf <<'EOF'
kernel.kptr_restrict=2
kernel.dmesg_restrict=1
kernel.yama.ptrace_scope=1
net.ipv4.conf.all.rp_filter=1
net.ipv4.conf.all.accept_redirects=0
net.ipv6.conf.all.accept_redirects=0
net.ipv4.conf.all.send_redirects=0
fs.protected_hardlinks=1
fs.protected_symlinks=1
fs.protected_fifos=1
fs.protected_regular=2
EOF

systemctl enable systemd-timesyncd.service || true
echo "P: Codebyr — durcissement terminé"
