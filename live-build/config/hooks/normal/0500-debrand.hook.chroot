#!/bin/sh
# Codebyr OS — supprime les derniers restes de branding Debian visibles.
set -e

echo "P: Codebyr — dé-branding Debian"

# — Version de l'image (déposée par build.sh, cf. hook 0100) —
VER="1.0"
[ -r /etc/codebyr/version ] && VER="$(tr -d ' \t\r\n' < /etc/codebyr/version)"

# — Identité complète (os-release) —
# Livrée par le paquet codebyr-tools, qui la détourne de base-files : voir
# packaging/build-deb.sh et packaging/codebyr-tools.preinst. Le hook 1000
# vérifie qu'elle est bien en place à la fin de la construction.

# — lsb-release (lu par lsb_release, certains outils système) —
cat > /etc/lsb-release <<EOF
DISTRIB_ID=Codebyr
DISTRIB_RELEASE=$VER
DISTRIB_CODENAME=codebyr
DISTRIB_DESCRIPTION="Codebyr OS $VER"
EOF

# — Clavier système AZERTY (console + défaut X/Wayland) —
# « caps:shiftlock » : Verr. Maj à la manière de Windows (« & » → « 1 »), comme
# dans la session GNOME (90_codebyr.gschema.override).
cat > /etc/default/keyboard <<'EOF'
XKBMODEL="pc105"
XKBLAYOUT="fr"
XKBVARIANT=""
XKBOPTIONS="caps:shiftlock"
BACKSPACE="guess"
EOF
# Le cache clavier de la console doit être plus RÉCENT que ce fichier. Sinon,
# en préparant l'image de démarrage, setupcon le juge périmé, recompile la
# disposition dans un fichier temporaire au nom tiré au hasard, et le recopie
# tel quel dans l'initrd (etc/console-setup/tmpkbd.XXXXXX) : deux constructions,
# deux initrd. Le cache refait porte en outre « caps:shiftlock », que l'ancien
# ignorait.
if command -v setupcon >/dev/null 2>&1; then
	setupcon --force --save-only
fi

# — Remplace l'emblème/logo Debian par le Sceau Codebyr (là où il s'afficherait) —
LOGO=/usr/share/icons/hicolor/scalable/apps/codebyr-logo.svg
if [ -f "$LOGO" ]; then
	find /usr/share/icons -iname "emblem-debian*.svg" -exec cp -f "$LOGO" {} \; 2>/dev/null || true
	# distributor-logo éventuel
	find /usr/share/icons -iname "*distributor-logo*.svg" -exec cp -f "$LOGO" {} \; 2>/dev/null || true
	if command -v rsvg-convert >/dev/null 2>&1; then
		# « find -exec sh -c » : POSIX (ces hooks tournent sous dash) et sûr
		# même si un chemin contient une espace. $0 porte le logo.
		find /usr/share/icons -iname "emblem-debian*.png" -exec sh -c '
			for f do
				sz=$(basename "$(dirname "$(dirname "$f")")" | cut -dx -f1)
				[ -n "$sz" ] && [ "$sz" -eq "$sz" ] 2>/dev/null && \
					rsvg-convert -w "$sz" -h "$sz" "$0" -o "$f" 2>/dev/null || true
			done' "$LOGO" {} + 2>/dev/null || true
	fi
fi

# — Logo Debian + version « Debian 13 » du greeter → logo Codebyr « codebyr OS » —
GL=/usr/share/backgrounds/codebyr/greeter-logo.svg
DL=/usr/share/desktop-base/debian-logos
if [ -f "$GL" ] && command -v rsvg-convert >/dev/null 2>&1; then
	for h in 64 128 256; do
		[ -e "$DL/logo-text-version-$h.png" ] && \
			rsvg-convert -h "$h" "$GL" -o "$DL/logo-text-version-$h.png" 2>/dev/null || true
	done
	[ -e "$DL/logo-text-version.svg" ] && cp -f "$GL" "$DL/logo-text-version.svg" || true
	# Autres logos Debian carrés (image simple) -> le Sceau
	# (on exclut logo-text-version* déjà traité en logo textuel juste au-dessus)
	find "$DL" -iname "logo-*.png" ! -iname "logo-text-version*" -exec sh -c '
		for f do
			sz=$(basename "$f" .png | sed "s/[^0-9]//g")
			[ -n "$sz" ] && rsvg-convert -w "$sz" -h "$sz" "$0" -o "$f" 2>/dev/null || true
		done' "$LOGO" {} + 2>/dev/null || true
fi
# Autres logos Debian visibles (pixmaps, emblème « vendor »)
[ -f /usr/share/pixmaps/debian-logo.png ] && command -v rsvg-convert >/dev/null 2>&1 && \
	rsvg-convert -w 96 -h 96 "$LOGO" -o /usr/share/pixmaps/debian-logo.png 2>/dev/null || true
find /usr/share/icons/vendor -iname "emblem-vendor*.svg" \
	-exec cp -f "$LOGO" {} \; 2>/dev/null || true

# — Remplace les fonds Debian (connexion / verrouillage) par le fond Codebyr —
BG=/usr/share/backgrounds/codebyr/codebyr-sombre.svg
if [ -f "$BG" ]; then
	find /usr/share/desktop-base \
		\( -path "*login*" -name "*.svg" -o -path "*lockscreen*" -name "*.svg" \) \
		-exec cp -f "$BG" {} \; 2>/dev/null || true
fi

# — Rafraîchit le cache d'icônes —
gtk-update-icon-cache -f /usr/share/icons/hicolor 2>/dev/null || true

echo "P: Codebyr — dé-branding terminé"
