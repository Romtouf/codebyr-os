#!/bin/sh
# Codebyr OS — active le canal de mise à jour APT (apt.codebyr.dev) dans l'image.
#
# S'exécute en dernier : les fichiers Codebyr sont déjà posés
# (includes.chroot_after_packages) et toutes les dépendances de codebyr-tools
# sont déjà installées.
#
# ORDRE IMPORTANT : on n'écrit le sources.list Codebyr qu'APRÈS avoir généré le
# trousseau. Un sources.list vers un dépôt signé sans son trousseau ferait
# échouer tout « apt update » du build.
set -e

KEY_ASC="/usr/share/keyrings/codebyr.asc"
KEYRING="/usr/share/keyrings/codebyr-archive-keyring.gpg"

# 1) Faire de codebyr-tools un VRAI paquet dpkg : il adopte les fichiers déjà
#    posés et devient suivi par apt/unattended-upgrades. Contenu identique
#    (même source) → aucune modification, juste l'enregistrement dpkg.
DEB="$(ls /opt/codebyr/codebyr-tools_*_all.deb 2>/dev/null | head -n1)"
if [ -n "$DEB" ]; then
	dpkg -i "$DEB" || apt-get -y -f install
	rm -f "$DEB"
	rmdir /opt/codebyr 2>/dev/null || true
	echo "P: Codebyr — codebyr-tools installé comme paquet (MAJ par apt actives)."
else
	echo "P: Codebyr — paquet codebyr-tools non embarqué, MAJ auto indisponibles." >&2
fi

# 1 bis) Identité du système. Elle est livrée par le paquet (voir
# packaging/build-deb.sh), plus par les hooks de branding : on vérifie donc
# ici, après son installation, qu'elle est bien en place. Une image qui se
# présenterait comme Debian partirait sans que personne ne le remarque.
if ! grep -q '^ID=codebyr$' /etc/os-release 2>/dev/null; then
	echo "E: Codebyr — /etc/os-release ne désigne pas Codebyr OS (paquet codebyr-tools absent ?)." >&2
	exit 1
fi
echo "P: Codebyr — identité du système : $(. /etc/os-release && echo "$PRETTY_NAME")."

# 1 ter) Socket du service des comptes d'Espaces.
#
# Le postinst du paquet l'active — mais il se garde derrière
# « [ -d /run/systemd/system ] », faux dans un chroot de construction. Sur une
# machine installée depuis l'ISO, aucun postinst ne repasse : sans ce lien, la
# socket n'existe jamais, et cocher « Compte séparé, par Espace » échouerait à
# la première ouverture avec « connexion refusée ». Constaté en inspectant
# l'ISO 1.15.0 : /etc/systemd/system/sockets.target.wants était vide.
#
# Lien manuel plutôt que « systemctl enable » : peu fiable en chroot, comme
# pour codebyr-invite-reset (hook 0400).
#
# Rien ne tourne pour autant au démarrage : la socket écoute, le service ne
# démarre qu'à la première connexion d'un Espace qui demande un compte dédié.
if [ -f /usr/lib/systemd/system/codebyr-uid.socket ]; then
	mkdir -p /etc/systemd/system/sockets.target.wants
	ln -sf /usr/lib/systemd/system/codebyr-uid.socket \
	       /etc/systemd/system/sockets.target.wants/codebyr-uid.socket
	echo "P: Codebyr — socket codebyr-uid activée au démarrage."
fi

# 2) Trousseau apt PUIS sources.list (jamais l'inverse).
if [ -f "$KEY_ASC" ]; then
	gpg --dearmor < "$KEY_ASC" > "$KEYRING"
	chmod 0644 "$KEYRING"
	rm -f "$KEY_ASC"
	cat > /etc/apt/sources.list.d/codebyr.sources <<'SRC'
Types: deb
URIs: https://apt.codebyr.dev
Suites: ./
Signed-By: /usr/share/keyrings/codebyr-archive-keyring.gpg
SRC
	echo "P: Codebyr — canal de mise à jour APT activé (apt.codebyr.dev)."
else
	echo "P: Codebyr — clé publique absente, canal MAJ non activé." >&2
fi

# 3) Le réglage APT « résilient » de la CONSTRUCTION ne part pas dans l'image.
#
# Il fait insister apt (20 nouvelles tentatives de 2 minutes) parce que le
# réseau de construction coupe par moments. Posé par includes.chroot_before_
# packages, il restait sur chaque machine installée : un dépôt injoignable y
# bloquait apt jusqu'à 40 minutes au lieu de quelques secondes. Constaté le
# 28/09/2026 : le serveur du projet coupé par une panne de courant, une
# installation a échoué sur le délai de 10 minutes de l'installeur.
#
# Ce hook passe en dernier : plus aucune installation de paquet ne suit.
rm -f /etc/apt/apt.conf.d/99codebyr-resilient.conf
echo "P: Codebyr — réglage APT de construction retiré de l'image."
