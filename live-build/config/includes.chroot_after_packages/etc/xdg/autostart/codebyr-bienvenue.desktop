[Desktop Entry]
Type=Application
Name=Welcome to Codebyr OS
Name[fr]=Bienvenue dans Codebyr OS
Comment=Welcome tour at first startup
Comment[fr]=Tour de bienvenue au premier démarrage
Exec=codebyr-bienvenue
Icon=io.codebyr.Bienvenue
Terminal=false
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=3
NoDisplay=true
