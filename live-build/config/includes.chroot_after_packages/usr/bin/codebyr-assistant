#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
codebyr-assistant — l'assistant de sécurité de Codebyr OS.
Explique en clair les situations de sécurité du quotidien. 100% local, privé.
"""
import glob
import json
import os

import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gtk, Gio  # noqa: E402

REGISTRY = "/etc/codebyr/espaces.json"
USER_REGISTRY = os.path.expanduser("~/.config/codebyr/espaces.json")

CONNAITRE = [
    ("Qu'est-ce qu'un Espace ?",
     "Un Espace est un compartiment séparé. Les applications de « Banque » et celles "
     "de « Navigation » ne partagent ni dossier personnel, ni fichiers temporaires, "
     "ni bus de communication : ce que vous téléchargez dans l'un n'existe pas dans "
     "l'autre. Chaque Espace a sa couleur : le liseré autour d'une fenêtre vous dit "
     "d'un coup d'œil à quel compartiment elle appartient. Si un Espace attrape "
     "quelque chose, le dégât reste confiné à ce compartiment."),
    ("Pourquoi certains sites sont bloqués dans Banque ?",
     "Le navigateur de l'Espace Banque ne peut ouvrir QUE les sites que vous avez "
     "déclarés comme étant ceux de votre banque. Tout le reste est refusé — y compris "
     "un lien d'hameçonnage reçu par courriel et ouvert par mégarde dans cet Espace. "
     "Un site bloqué dans Banque, c'est la protection qui marche, pas une panne."),
    ("À quoi sert l'Espace Jetable ?",
     "Il s'autodétruit dès que vous le fermez. Idéal pour ouvrir un lien ou un "
     "fichier douteux : s'il est piégé, le piège disparaît avec l'Espace. Une pièce "
     "jointe y est même ouverte SANS réseau : elle ne peut rien envoyer dehors."),
    ("Est-ce que Codebyr OS me rend invulnérable ?",
     "Non, et personne ne devrait vous le promettre. Codebyr réduit fortement les "
     "dégâts d'un piège en l'enfermant dans un compartiment. Mais les Espaces "
     "reposent sur les protections du noyau Linux, pas sur des machines virtuelles "
     "séparées : une faille grave du noyau permettrait d'en sortir. Continuez donc à "
     "vous méfier des pièces jointes et à vérifier l'adresse des sites — Codebyr est "
     "un filet de sécurité, pas une raison de sauter sans regarder."),
]

REAGIR = [
    ("Un écran rouge dit « site suspect » — que faire ?",
     "C'est le bouclier anti-hameçonnage de Codebyr OS. Ce site imite votre banque "
     "sans en être le vrai site. NE SAISISSEZ JAMAIS vos identifiants ici. Fermez "
     "l'onglet. Pour votre vraie banque, utilisez toujours l'Espace Banque."),
    ("Une application demande ma caméra ou mon micro — est-ce normal ?",
     "Posez-vous une question simple : est-ce cohérent avec ce que fait l'appli ? "
     "Un logiciel d'appel vidéo qui demande la caméra : normal. Un site d'actualité "
     "ou un jeu qui la réclame : méfiance, refusez. Dans le doute, refusez — vous "
     "pourrez toujours autoriser plus tard si besoin."),
    ("Comment ouvrir un lien douteux sans risque ?",
     "Menu du Sceau (en haut à droite) → « Ouvrir un lien en Jetable ». Le lien "
     "s'ouvre dans une bulle éphémère : même piégé, il ne touche pas à vos données, "
     "et tout disparaît à la fermeture."),
    ("Je pense avoir été infecté — que faire ?",
     "Pas de panique : le problème est confiné à un seul Espace. 1) Fermez l'Espace "
     "concerné (menu Sceau → l'Espace → « Fermer cet Espace »). 2) Videz ses données, "
     "ou mieux : « Revenir à un instantané… » d'avant le problème. Les autres Espaces "
     "ne sont pas touchés."),
    ("Je prête mon ordinateur — comment protéger mes données ?",
     "Menu du Sceau → « Mode invité (prêter le PC) ». La personne arrive dans une "
     "session séparée, sous un autre compte : votre dossier personnel lui est fermé "
     "(droits 0700), et sa session est effacée dès qu'elle se déconnecte. Elle n'a "
     "pas besoin de mot de passe, et ne peut pas devenir administrateur."),
]


def _domaines_banque():
    # La copie UTILISATEUR fait foi si elle existe : c'est elle que « Configuration
    # Codebyr » écrit. Lire /etc seul faisait afficher « aucune banque » à un
    # utilisateur qui venait pourtant d'enregistrer la sienne.
    path = USER_REGISTRY if os.path.exists(USER_REGISTRY) else REGISTRY
    try:
        with open(path, encoding="utf-8") as f:
            data = json.load(f)
        for e in data.get("espaces", []):
            r = e.get("reseau") or {}
            if r.get("mode") == "liste-blanche":
                return [d.removeprefix("*.") for d in (r.get("domaines") or [])]
    except (OSError, ValueError):
        pass
    return []


def _espaces_ouverts():
    rundir = os.path.join(
        os.environ.get("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid()), "codebyr")
    ids = set()
    for f in glob.glob(os.path.join(rundir, "pid-*")):
        try:
            with open(f, encoding="utf-8") as h:
                ids.add(h.read().strip())
        except OSError:
            pass
    return sorted(ids)


class Fenetre(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Assistant de sécurité")
        self.set_default_size(720, 620)

        page = Adw.PreferencesPage()

        intro = Adw.PreferencesGroup(
            title="Bonjour 👋",
            description="Je suis l'assistant de Codebyr OS. Je réponds en clair aux "
                        "questions de sécurité du quotidien. Tout reste sur votre "
                        "ordinateur : je ne consulte aucun serveur.")
        page.add(intro)

        etat = Adw.PreferencesGroup(title="En ce moment")
        # État RÉEL, jamais rassurant par défaut : le bouclier ne surveille que les
        # domaines déclarés. Sans banque enregistrée, il n'a rien à comparer — le
        # dire est plus utile qu'un « Actif » de façade.
        doms = _domaines_banque()
        if doms:
            etat.add(self._info(
                "Bouclier anti-hameçonnage",
                "Actif : il vous alerte si un site imite l'un de vos %d site(s) "
                "protégé(s), dans vos Espaces de navigation." % len(doms),
                "security-high-symbolic"))
            etat.add(self._info(
                "Espace Banque", "Navigateur restreint à : %s. Tout autre site y est "
                "refusé." % ", ".join(doms), "network-wireless-symbolic"))
        else:
            etat.add(self._info(
                "Bouclier anti-hameçonnage",
                "En attente : aucun site de banque n'est encore enregistré. Ouvrez "
                "« Configuration Codebyr » pour ajouter le vôtre — sans lui, le "
                "bouclier n'a rien à surveiller.", "dialog-warning-symbolic"))
            etat.add(self._info(
                "Espace Banque", "Aucun site autorisé pour l'instant : le navigateur "
                "de cet Espace n'ouvrira rien tant que vous n'aurez pas déclaré votre "
                "banque.", "dialog-warning-symbolic"))
        ouverts = _espaces_ouverts()
        etat.add(self._info(
            "Espaces ouverts",
            (", ".join(ouverts) if ouverts else "Aucun Espace ouvert pour l'instant."),
            "view-grid-symbolic"))
        page.add(etat)

        g1 = Adw.PreferencesGroup(title="Comprendre Codebyr OS")
        for q, a in CONNAITRE:
            g1.add(self._qa(q, a))
        page.add(g1)

        g2 = Adw.PreferencesGroup(title="Réagir à une alerte")
        for q, a in REAGIR:
            g2.add(self._qa(q, a))
        page.add(g2)

        tv = Adw.ToolbarView()
        header = Adw.HeaderBar()
        header.set_title_widget(Adw.WindowTitle(title="Assistant de sécurité",
                                                subtitle="Codebyr OS"))
        tv.add_top_bar(header)
        tv.set_content(page)
        self.set_content(tv)

    def _qa(self, question, reponse):
        exp = Adw.ExpanderRow(title=question)
        lbl = Gtk.Label(label=reponse, wrap=True, xalign=0)
        lbl.set_margin_top(6)
        lbl.set_margin_bottom(12)
        lbl.set_margin_start(14)
        lbl.set_margin_end(14)
        lbl.add_css_class("body")
        exp.add_row(lbl)
        return exp

    def _info(self, titre, sous_titre, icone):
        row = Adw.ActionRow(title=titre, subtitle=sous_titre)
        row.add_prefix(Gtk.Image.new_from_icon_name(icone))
        return row


class Assistant(Adw.Application):
    def __init__(self):
        super().__init__(application_id="io.codebyr.Assistant",
                         flags=Gio.ApplicationFlags.FLAGS_NONE)

    def do_activate(self):
        win = self.props.active_window
        if not win:
            win = Fenetre(self)
        win.present()


if __name__ == "__main__":
    Assistant().run(None)
