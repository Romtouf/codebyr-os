#!/bin/sh
# codebyr-durcir-poste — durcissements qui doivent être VRAIS sur le système
# installé, pas seulement dans l'image live.
#
# Appelé depuis trois endroits, volontairement :
#   1. hook 0400 (construction de l'ISO)      → l'image live est déjà correcte ;
#   2. codebyr-nettoyage-installation         → le système fraîchement installé ;
#   3. postinst de codebyr-tools              → les machines DÉJÀ déployées,
#                                               rattrapées par « apt ».
# D'où l'exigence d'idempotence absolue : ce script doit pouvoir tourner cent
# fois sans rien casser, et ne JAMAIS échouer (un postinst qui sort en erreur
# bloque la mise à jour de tout le parc).
#
# Usage : codebyr-durcir-poste   (root requis)
set -e

# ── Travaux dans un dossier personnel : SOUS L'IDENTITÉ de son propriétaire ──
# Tout ce qui écrit dans un dossier personnel se fait au nom de celui à qui il
# appartient, jamais en root : chaque chemin qu'on y suit — un lien, un dossier
# déclaré dans ses réglages — c'est lui qui l'a choisi.
#
# Jusqu'à la 1.17.1, root y créait le dossier des modèles et le lui remettait
# (« chown »), au chemin que ses réglages déclaraient. Il suffisait d'y écrire
# « $HOME/../../etc » pour se voir remettre /etc à la mise à jour suivante —
# c'est-à-dire tout le système, depuis n'importe quel compte de la machine,
# l'invité compris. Sous l'identité de l'utilisateur, un tel chemin ne mène
# qu'où il pouvait déjà écrire.
#
# Le script se relance lui-même pour ces travaux, par setpriv (voir
# sous_l_identite plus bas) : root n'y entre jamais.
if [ "${1:-}" = "--sous-l-identite" ]; then
	[ "$(id -u)" != "0" ] || exit 0
	dossier="${3:-}"
	[ -d "$dossier" ] || exit 0
	case "${2:-}" in
		modeles)
			# Le nom du dossier dépend de la langue : on suit la déclaration
			# de xdg-user-dirs quand elle existe, sinon le nom français.
			cible="$(sed -n 's/^XDG_TEMPLATES_DIR="\?\$HOME\/\([^"]*\)"\?/\1/p' \
				"$dossier/.config/user-dirs.dirs" 2>/dev/null | head -n1)"
			[ -n "$cible" ] || cible="Modèles"
			mkdir -p "$dossier/$cible" 2>/dev/null || exit 0
			for m in /usr/share/codebyr/modeles/*; do
				[ -f "$m" ] || continue
				place="$dossier/$cible/$(basename "$m")"
				# Jamais d'écrasement : qui a personnalisé le sien l'a fait exprès.
				if [ -e "$place" ] || [ -L "$place" ]; then continue; fi
				cp "$m" "$place" 2>/dev/null || true
			done
			;;
		avatar)
			# Seul l'avatar resté celui de Debian, octet pour octet, est
			# remplacé : une photo choisie par l'utilisateur ne l'est jamais.
			face="$dossier/.face"
			if [ ! -f "$face" ] || [ -L "$face" ]; then exit 0; fi
			cmp -s "$face" /etc/skel/.face.desktop-base || exit 0
			[ -f /etc/skel/.face ] || exit 0
			if cp /etc/skel/.face "$face.codebyr-neuf" 2>/dev/null \
					&& mv -f "$face.codebyr-neuf" "$face" 2>/dev/null; then
				echo "codebyr : avatar Debian de « $(id -un) » remplacé par le Sceau."
			else
				rm -f "$face.codebyr-neuf" 2>/dev/null || true
			fi
			;;
	esac
	exit 0
fi

[ "$(id -u)" = "0" ] || { echo "codebyr-durcir-poste : root requis." >&2; exit 0; }

# Lance l'un des travaux ci-dessus sous l'identité d'un compte :
#   sous_l_identite <uid> <gid> <travail> <dossier personnel>
# setpriv change les trois identifiants (réel, effectif, sauvegardé) : le
# noyau retire alors toutes les capacités de root. « --no-new-privs » : aucun
# programme lancé ensuite ne peut en regagner. « --reset-env » : rien de
# l'environnement de root ne passe, ni la lecture de /etc/passwd en cours
# (entrée « /dev/null »). Sans setpriv, on ne fait rien plutôt que de le faire
# en root.
SCRIPT="$(readlink -f "$0" 2>/dev/null || echo "$0")"
sous_l_identite() {
	[ -x /usr/bin/setpriv ] || return 0
	/usr/bin/setpriv --reuid="$1" --regid="$2" --clear-groups --no-new-privs --reset-env \
		-- /bin/sh "$SCRIPT" --sous-l-identite "$3" "$4" < /dev/null || true
}

PAM_GDM="/etc/pam.d/gdm-password"
MARQUEUR="Codebyr — Mode invité"

# ── 1) Dossiers personnels privés ────────────────────────────────────────────
# Sans ceci, le compte « Invité » (ou tout autre compte local) lit les fichiers
# de l'utilisateur principal : le défaut Debian est 0755. L'image live posait
# bien un 700 sur /home/user, mais ce compte est supprimé à l'installation et
# celui créé par Calamares n'héritait de rien. C'était un écart entre la
# promesse (« l'invité ne voit AUCUN de vos fichiers ») et la réalité.
while IFS=: read -r nom _ uid _ _ home _; do
	[ "$uid" -ge 1000 ] 2>/dev/null || continue
	[ "$uid" -lt 65534 ] || continue
	case "$home" in /home/*) ;; *) continue ;; esac
	[ -d "$home" ] || continue
	mode="$(stat -c '%a' "$home" 2>/dev/null || echo 700)"
	[ "$mode" = "700" ] && continue
	chmod 700 "$home" 2>/dev/null || true
	echo "codebyr : dossier personnel de « $nom » rendu privé (0700, était $mode)."
done < /etc/passwd

# ── 1 bis) Modèles de documents ──────────────────────────────────────────────
# GNOME Fichiers n'affiche « Nouveau document » que si le dossier Modèles
# contient quelque chose. Vide, il ne reste que « Nouveau dossier », et créer un
# fichier texte oblige à ouvrir un terminal pour taper « touch » — sur un
# système qui vise des gens qui n'ouvriront jamais de terminal.
#
# /etc/skel ne sert qu'aux comptes créés APRÈS ; on remplit donc aussi ceux qui
# existent déjà — sous leur identité (voir « --sous-l-identite » plus haut).
#
# ── 1 ter) Avatar ───────────────────────────────────────────────────────────
# Les comptes créés avant la 1.17.2 ont reçu de /etc/skel la spirale Debian
# comme avatar, sur l'écran de connexion et de verrouillage. Ils reçoivent le
# Sceau — sauf ceux qui ont choisi leur image.
#
# Le dossier doit appartenir au compte : un dossier personnel partagé ou
# confié à un autre n'est pas le sien à remplir.
while IFS=: read -r nom _ uid gid _ home _; do
	[ "$uid" -ge 1000 ] 2>/dev/null || continue
	[ "$uid" -lt 65534 ] || continue
	case "$home" in /home/*) ;; *) continue ;; esac
	[ -d "$home" ] || continue
	[ "$(stat -c '%u' "$home" 2>/dev/null)" = "$uid" ] || continue
	sous_l_identite "$uid" "$gid" modeles "$home"
	sous_l_identite "$uid" "$gid" avatar "$home"
done < /etc/passwd

# ── 2) Compte invité : plus aucun mot de passe utilisable ────────────────────
# Avant : « invite » / « invite » — le même mot de passe, public, sur TOUTES les
# machines Codebyr. Désormais :
#   · le champ mot de passe vaut « * » → aucun mot de passe ne peut correspondre,
#     donc ni SSH, ni su, ni sudo, ni polkit ne peuvent s'authentifier ;
#   · une seule ligne PAM autorise la session GDM de « invite » sans mot de passe.
# Le mode invité reste donc un clic, mais il n'ouvre plus rien d'autre.
if id invite >/dev/null 2>&1; then
	# a) La règle PAM D'ABORD : sans elle, verrouiller le mot de passe
	#    empêcherait l'invité de se connecter du tout.
	pam_ok=0
	if [ -f "$PAM_GDM" ]; then
		if grep -q "$MARQUEUR" "$PAM_GDM"; then
			pam_ok=1
		else
			cp -a "$PAM_GDM" "$PAM_GDM.avant-codebyr" 2>/dev/null || true
			# Insertion avant la première ligne « auth » qui n'est pas
			# pam_nologin (on ne court-circuite pas l'interdiction de session).
			# « sufficient » est sûr pour les autres comptes : l'ÉCHEC d'un
			# module sufficient est ignoré, la pile normale se poursuit.
			awk -v marq="# $MARQUEUR : session sans mot de passe (voir codebyr-durcir-poste)." '
				BEGIN { pose = 0 }
				{
					if (!pose && $1 == "auth" && $0 !~ /pam_nologin/) {
						print marq
						print "auth\tsufficient\tpam_succeed_if.so user = invite quiet"
						pose = 1
					}
					print
				}
				END { if (!pose) exit 3 }
			' "$PAM_GDM" > "$PAM_GDM.codebyr-tmp" && mv "$PAM_GDM.codebyr-tmp" "$PAM_GDM" && pam_ok=1
			rm -f "$PAM_GDM.codebyr-tmp"
			[ "$pam_ok" = "1" ] && echo "codebyr : session invité sans mot de passe (règle PAM posée)."
		fi
	fi

	# b) Le mot de passe public ne disparaît QUE si l'invité peut encore entrer.
	if [ "$pam_ok" = "1" ]; then
		if grep -q '^invite:\*:' /etc/shadow 2>/dev/null; then
			:
		else
			usermod -p '*' invite 2>/dev/null \
				&& echo "codebyr : mot de passe du compte invité neutralisé (« * »)."
		fi
	else
		echo "codebyr : règle PAM invité non posée — mot de passe laissé tel quel" >&2
		echo "          (mieux vaut un invité accessible qu'un invité inutilisable)." >&2
	fi
fi

# ── 3) Espace d'échange chiffré : la ligne que l'installeur laisse à moitié ──
# Constaté le 28/09/2026 sur une installation neuve de la 1.16.0 ; vrai de toute
# installation chiffrée avec espace d'échange depuis la 1.13.0.
#
# Calamares chiffre l'espace d'échange à part, et prévoit de l'ouvrir avec un
# fichier de clé rangé sur le disque principal (« keyscript=/bin/cat »). Ce
# fichier n'est pas créé quand /boot est séparé et en clair — le choix de
# Codebyr, voir partition.conf. Restait une ligne « none … keyscript=/bin/cat »,
# et une zone de reprise « resume=… » sur la ligne du noyau : à chaque démarrage,
# l'image de démarrage tentait d'ouvrir l'espace d'échange, échouait deux fois
# avec un message qui fait croire à une phrase de passe refusée, puis
# continuait SANS espace d'échange.
#
# La réparation est la méthode ordinaire de Debian : une clé tirée au hasard à
# chaque démarrage. Rien à stocker ni à taper, et le contenu de l'espace
# d'échange devient illisible dès l'extinction. Le prix : pas de mise en veille
# prolongée — elle ne fonctionnait pas davantage, et GNOME ne la propose pas.
#
# Le disque principal n'est JAMAIS touché. Une partition n'est réparée que si
# elle remplit toutes ces conditions : sa ligne porte la signature exacte du
# défaut, elle est chiffrée (LUKS), /etc/fstab l'utilise comme espace
# d'échange, et rien d'autre ne la tient ouverte. Elle est ensuite désignée par
# son identifiant de PARTITION : son identifiant LUKS disparaîtra au premier
# démarrage, quand elle sera reformatée en espace d'échange.
#
# CODEBYR_INSTALLATION=1 (posé par codebyr-nettoyage-installation) : Calamares
# régénère lui-même l'image de démarrage juste après ; on ne le fait pas deux
# fois. GRUB, lui, a déjà été configuré : on le régénère dans tous les cas.

# Vrai si la partition est tenue ouverte sous un AUTRE nom que le sien.
# Pendant l'installation, Calamares la tient ouverte sous son propre nom.
tenue_ailleurs() {
	for tenant in /sys/class/block/"$(basename "$1")"/holders/*; do
		[ -e "$tenant" ] || continue
		[ "$(cat "$tenant/dm/name" 2>/dev/null || true)" = "$2" ] || return 0
	done
	return 1
}

a_reparer=""
if [ -f /etc/crypttab ]; then
	while read -r nom source cle options _reste; do
		case "$nom" in ''|'#'*) continue ;; esac
		[ "$cle" = "none" ] || continue
		case ",$options," in *,keyscript=/bin/cat,*) ;; *) continue ;; esac
		case "$source" in UUID=?*) uuid="${source#UUID=}" ;; *) continue ;; esac
		partition="$(blkid -U "$uuid" 2>/dev/null || true)"
		[ -n "$partition" ] || continue
		[ "$(blkid -s TYPE -o value "$partition" 2>/dev/null || true)" = "crypto_LUKS" ] || continue
		awk -v d="/dev/mapper/$nom" '$1 == d && $3 == "swap" { t = 1 } END { exit !t }' \
			/etc/fstab 2>/dev/null || continue
		if tenue_ailleurs "$partition" "$nom"; then continue; fi
		partuuid="$(blkid -s PARTUUID -o value "$partition" 2>/dev/null || true)"
		[ -n "$partuuid" ] || continue
		a_reparer="$a_reparer $nom|$partuuid|$partition"
	done < /etc/crypttab
fi

for triplet in $a_reparer; do
	nom="${triplet%%|*}"
	reste="${triplet#*|}"
	partuuid="${reste%%|*}"
	partition="${reste#*|}"
	[ -e /etc/crypttab.avant-codebyr ] || cp -a /etc/crypttab /etc/crypttab.avant-codebyr 2>/dev/null || true
	awk -v n="$nom" -v p="$partuuid" '
		$1 == n { print n " PARTUUID=" p " /dev/urandom plain,cipher=aes-xts-plain64,size=512,swap,discard"; next }
		{ print }
	' /etc/crypttab > /etc/crypttab.codebyr-tmp \
		&& mv /etc/crypttab.codebyr-tmp /etc/crypttab || { rm -f /etc/crypttab.codebyr-tmp; continue; }
	chmod 600 /etc/crypttab 2>/dev/null || true
	# Les en-têtes LUKS de l'ancien volume survivent à « mkswap » : l'Utilitaire
	# de disques présenterait encore la partition comme un volume chiffré
	# « verrouillé ». On efface ces seules signatures (-t crypto_LUKS). Aucun
	# risque nouveau : la ligne ci-dessus la reformate à chaque démarrage.
	# « -f » : pendant l'installation, Calamares la tient encore ouverte ; le
	# volume ouvert garde sa clé en mémoire, l'effacement ne le trouble pas.
	wipefs -q -a -f -t crypto_LUKS "$partition" >/dev/null 2>&1 || true
	if [ -f /etc/default/grub ] && grep -q "resume=/dev/mapper/$nom" /etc/default/grub; then
		[ -e /etc/default/grub.avant-codebyr ] || cp -a /etc/default/grub /etc/default/grub.avant-codebyr 2>/dev/null || true
		sed -i -e "s| resume=/dev/mapper/$nom||g" -e "s|resume=/dev/mapper/$nom ||g" \
			-e "s|resume=/dev/mapper/$nom||g" /etc/default/grub 2>/dev/null || true
	fi
	if [ ! -e /etc/initramfs-tools/conf.d/resume ] \
			|| grep -q "$nom" /etc/initramfs-tools/conf.d/resume 2>/dev/null; then
		mkdir -p /etc/initramfs-tools/conf.d 2>/dev/null || true
		echo "RESUME=none" > /etc/initramfs-tools/conf.d/resume 2>/dev/null || true
	fi
	echo "codebyr : espace d'échange « $nom » réparé (clé aléatoire à chaque démarrage)."
done

if [ -n "$a_reparer" ]; then
	if command -v update-grub >/dev/null 2>&1; then
		update-grub >/dev/null 2>&1 \
			|| echo "codebyr : update-grub a échoué — relancez-le à la main." >&2
	fi
	if [ "${CODEBYR_INSTALLATION:-0}" != "1" ] && command -v update-initramfs >/dev/null 2>&1; then
		update-initramfs -u -k all >/dev/null 2>&1 \
			|| echo "codebyr : update-initramfs a échoué — relancez-le à la main." >&2
	fi
fi

# ── 4) Le réglage APT de la construction, resté sur les machines ────────────
# Voir le hook 1000 : ce fichier servait à construire l'image, et s'y trouvait
# encore. Un dépôt injoignable bloquait alors apt jusqu'à 40 minutes. On ne le
# retire que s'il porte bien son en-tête : un fichier du même nom écrit par
# l'administrateur de la machine n'est pas le nôtre.
RESILIENT=/etc/apt/apt.conf.d/99codebyr-resilient.conf
if [ -f "$RESILIENT" ] \
		&& head -n 1 "$RESILIENT" | grep -q '^// Codebyr OS — APT résilient pendant la construction\.$'; then
	rm -f "$RESILIENT" \
		&& echo "codebyr : réglage APT de construction retiré (délais d'apt ordinaires)."
fi

exit 0
