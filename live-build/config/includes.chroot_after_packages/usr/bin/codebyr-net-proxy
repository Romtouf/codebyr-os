#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
codebyr-net-proxy — filtre réseau à liste blanche pour un Espace.

N'autorise QUE les domaines passés en argument ; tout le reste est bloqué.
Sans aucun domaine, TOUT est bloqué (échec fermé — jamais l'inverse).
Gère HTTPS (méthode CONNECT) et HTTP simple. Écoute sur 127.0.0.1.

Un domaine refusé est noté dans le JOURNAL (option --journal) : c'est ce qui
permet à « Configuration Codebyr » de proposer ensuite « ce site a été bloqué,
voulez-vous l'autoriser ? ». Sans cela, un site bancaire qui charge une
ressource sur un domaine tiers (CDN, 3-D Secure, captcha) semble simplement
cassé, et l'utilisateur n'a aucun moyen de comprendre pourquoi.

Usage : codebyr-net-proxy <port> [--journal <fichier>] [<domaine> ...]
        codebyr-net-proxy --fd <n> [--journal <fichier>] [<domaine> ...]

La forme « --fd » reçoit du parent une socket DÉJÀ en écoute. Elle supprime
deux défauts de la forme « --port » : la course entre le choix du port libre et
sa prise effective (un autre programme pouvait s'y glisser), et le cas où le
navigateur démarrait plus vite que le filtre et tombait sur un port muet.
"""
import os
import select
import socket
import sys
import threading

TAILLE = 65536

JOURNAL = None
_VUS = set()
_VERROU = None


def journaliser(host):
    """Note un domaine refusé, une seule fois, pour « Configuration Codebyr »."""
    if not JOURNAL or not host:
        return
    with _VERROU:
        if host in _VUS:
            return
        _VUS.add(host)
    try:
        os.makedirs(os.path.dirname(JOURNAL), exist_ok=True)
        with open(JOURNAL, "a", encoding="utf-8") as f:
            f.write(host + "\n")
    except OSError:
        pass


def hote_propre(brut):
    """Normalise un nom d'hôte : minuscules, sans point final, sans crochets.

    Les crochets viennent des adresses IPv6 littérales : « CONNECT [::1]:443 »
    donne « [::1] », que getaddrinfo refuse. Sans ce nettoyage, un Espace à
    liste blanche ne pouvait joindre aucune adresse IPv6 écrite en clair."""
    h = (brut or "").strip().lower().strip(".")
    if h.startswith("[") and h.endswith("]"):
        h = h[1:-1]
    return h


def autorise(host, patterns):
    host = hote_propre(host)
    for p in patterns:
        p = p.lower().strip()
        if p.startswith("*."):
            base = p[2:]
            if host == base or host.endswith("." + base):
                return True
        elif host == p:
            return True
    return False


def tunnel(a, b):
    try:
        while True:
            r, _, _ = select.select([a, b], [], [], 60)
            if not r:
                break
            for s in r:
                data = s.recv(TAILLE)
                if not data:
                    return
                (b if s is a else a).sendall(data)
    except OSError:
        pass


def echapper(texte):
    """Le nom d'hôte vient du site visité : il n'entre jamais tel quel dans du
    HTML. Ce sont trois lignes, et c'est la différence entre une page
    d'information et une page qu'on peut détourner."""
    return (str(texte or "")
            .replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
            .replace('"', "&quot;"))


PAGE = u"""<!doctype html><html lang="fr"><meta charset="utf-8">
<title>Site bloqué — Codebyr</title>
<style>
 body{margin:0;min-height:100vh;display:flex;align-items:center;
      justify-content:center;background:#0A1318;color:#E7EEF1;
      font-family:system-ui,sans-serif;padding:24px}
 .c{max-width:34rem;text-align:center}
 h1{font-size:1.6rem;margin:.6rem 0}
 p{line-height:1.6;color:#B9C7CE}
 code{background:#16242c;padding:.15rem .4rem;border-radius:5px;color:#E7EEF1}
 .t{display:inline-block;margin-bottom:.4rem;padding:.2rem .7rem;border-radius:99px;
    background:#2FA36B22;color:#2FA36B;font-size:.8rem;font-weight:700}
</style>
<div class="c"><span class="t">Espace à réseau restreint</span>
<h1>%s</h1><p>%s</p></div>"""


def bloque(client, host, patterns=()):
    if patterns:
        titre = u"Ce site n'est pas celui de votre banque"
        detail = (u"L'Espace Banque ne peut joindre que les adresses que vous "
                  u"avez déclarées. <code>%s</code> n'en fait pas partie.<br><br>"
                  u"Si votre banque a réellement besoin de ce site pour "
                  u"fonctionner, ouvrez <b>Configuration Codebyr</b> : il vous "
                  u"sera proposé dans la liste des sites bloqués."
                  % echapper(host))
    else:
        titre = u"Aucun site n'est encore autorisé ici"
        detail = (u"Ouvrez <b>Configuration Codebyr</b> et ajoutez l'adresse de "
                  u"votre banque. Elle sera alors la seule joignable dans cet "
                  u"Espace — c'est ce qui rend un lien d'hameçonnage inoffensif "
                  u"quand il s'ouvre ici par mégarde.")
    corps = (PAGE % (titre, detail)).encode("utf-8")
    entete = (b"HTTP/1.1 403 Forbidden\r\n"
              b"Content-Type: text/html; charset=utf-8\r\n"
              b"Content-Length: " + str(len(corps)).encode() + b"\r\n"
              b"Connection: close\r\n\r\n")
    try:
        client.sendall(entete + corps)
    except OSError:
        pass


def gerer(client, patterns):
    try:
        client.settimeout(30)
        premier = client.recv(TAILLE)
        if not premier:
            client.close()
            return
        ligne = premier.split(b"\r\n", 1)[0].decode("latin-1", "replace")
        parts = ligne.split()
        if len(parts) < 2:
            client.close()
            return
        methode, cible = parts[0], parts[1]

        if methode.upper() == "CONNECT":
            # « [2001:db8::1]:443 » : on coupe APRÈS le crochet fermant, sinon
            # le découpage tombe au milieu de l'adresse IPv6.
            if cible.startswith("[") and "]" in cible:
                hote_brut, _, reste = cible.partition("]")
                host = hote_propre(hote_brut + "]")
                port = int(reste.lstrip(":")) if reste.lstrip(":") else 443
            else:
                host = hote_propre(cible.rsplit(":", 1)[0])
                port = int(cible.rsplit(":", 1)[1]) if ":" in cible else 443
            if not autorise(host, patterns):
                journaliser(host)
                bloque(client, host, patterns)
                client.close()
                return
            amont = socket.create_connection((host, port), timeout=15)
            client.sendall(b"HTTP/1.1 200 Connection established\r\n\r\n")
            client.settimeout(None)
            tunnel(client, amont)
            amont.close()
        else:
            # HTTP simple : extraire l'hôte (Host: ou URL absolue)
            host = ""
            for l in premier.split(b"\r\n"):
                if l.lower().startswith(b"host:"):
                    brut = l.split(b":", 1)[1].strip().decode("latin-1")
                    if brut.startswith("[") and "]" in brut:
                        brut = brut.partition("]")[0] + "]"
                    elif ":" in brut:
                        brut = brut.rsplit(":", 1)[0]
                    host = hote_propre(brut)
                    break
            if not autorise(host, patterns):
                journaliser(host)
                bloque(client, host, patterns)
                client.close()
                return
            amont = socket.create_connection((host, 80), timeout=15)
            amont.sendall(premier)
            client.settimeout(None)
            tunnel(client, amont)
            amont.close()
    except (OSError, ValueError):
        pass
    finally:
        try:
            client.close()
        except OSError:
            pass


def main(argv):
    global JOURNAL, _VERROU
    args = argv[1:]
    if not args:
        sys.stderr.write(__doc__)
        return 2

    srv = None
    if args[0] == "--fd" and len(args) >= 2:
        # Socket héritée du parent : elle écoute déjà, rien à ouvrir.
        srv = socket.socket(fileno=int(args[1]))
        args = args[2:]
    else:
        port = int(args[0])
        args = args[1:]

    if len(args) >= 2 and args[0] == "--journal":
        JOURNAL = args[1]
        args = args[2:]
    _VERROU = threading.Lock()
    patterns = args

    if srv is None:
        srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        srv.bind(("127.0.0.1", port))
        srv.listen(64)
    port = srv.getsockname()[1]
    sys.stderr.write("codebyr-net-proxy : filtre actif sur 127.0.0.1:%d (%d domaine(s))\n"
                     % (port, len(patterns)))
    while True:
        try:
            client, _ = srv.accept()
        except OSError:
            break
        threading.Thread(target=gerer, args=(client, patterns), daemon=True).start()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
