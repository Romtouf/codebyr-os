#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
codebyr-space — lance des applications dans un Espace isolé (Codebyr OS, Phase 2 v1).

Chaque Espace a :
  - sa propre couleur (langage visuel, voir la charte) ;
  - son propre dossier personnel isolé (données séparées entre Espaces) ;
  - un marqueur de fenêtre « codebyr-<id> » pour que l'extension GNOME
    colore ses fenêtres.

Isolation : bubblewrap obligatoire ; aucun lancement sans bac à sable. Le bus de session de
l'hôte n'entre JAMAIS dans un Espace (voir wrap_bwrap).

La liste des actions est produite à partir de la table ACTIONS : « --help » ne
peut donc pas se désynchroniser de ce que le programme sait réellement faire.
"""
import glob
import json
import os
import re
import secrets
import shlex
import shutil
import signal
import socket
import subprocess
import sys
import tarfile
import tempfile
import threading
import time
import unicodedata

# Module partagé de lecture/écriture du registre (voir /usr/share/codebyr/).
# CODEBYR_LIB permet de le charger ailleurs — tests, développement.
sys.path.insert(0, os.environ.get("CODEBYR_LIB", "/usr/share/codebyr"))
import applications  # noqa: E402
import autotest  # noqa: E402
import bac_a_sable  # noqa: E402
import compte_dedie  # noqa: E402
import comptes  # noqa: E402
import fichiers_surs
import modeles  # noqa: E402
import provenance  # noqa: E402
import registre  # noqa: E402
import relais_notifications  # noqa: E402

DATA_ROOT = os.path.expanduser("~/.local/share/codebyr/espaces")
# Le sas d'un Espace : c'est là qu'atterrit tout fichier venu du dehors. Nom
# écrit à un seul endroit — il l'était à deux, ce qui est la façon habituelle
# dont deux moitiés d'un même système finissent par ne plus se parler.
PARTAGE = "Partagé"
# Sous-dossier de « Partagé » où arrive une pièce jointe examinée dans un Espace
# à compte dédié (voir _lancer).
PIECE_JOINTE = "Pièce jointe du"


def journal(message):
    """Trace une action dans le journal système (« journalctl -t codebyr »).

    Sans trace, un utilisateur qui signale « ça n'a pas marché » ne peut être
    aidé par personne. On note l'Espace et l'action — jamais le nom du fichier
    ouvert ni l'adresse visitée : ce serait consigner sur disque exactement ce
    que les Espaces servent à cloisonner."""
    try:
        import syslog
        syslog.openlog("codebyr", syslog.LOG_PID, syslog.LOG_USER)
        syslog.syslog(syslog.LOG_INFO, message)
        syslog.closelog()
    except Exception:
        pass    # un journal absent ne doit jamais empêcher un lancement


def load_espaces():
    """Les Espaces, valeurs par défaut du système recouvertes par les choix
    de l'utilisateur (voir registre.charger)."""
    return registre.espaces()


# En dessous de ce seuil, un Jetable risque de saturer la mémoire avant que
# l'utilisateur ne comprenne ce qui se passe.
JETABLE_MINIMUM = 512 * 1024 * 1024


def espace_home(esp):
    if esp.get("ephemere"):
        # Le dossier d'un Espace jetable vit dans /tmp, donc en mémoire vive :
        # rien de ce qu'on y ouvre n'atteint jamais le disque. C'est exactement
        # la promesse du Jetable, et cela vaut mieux qu'un fichier récupérable
        # sur un disque non chiffré. Le revers est qu'un téléchargement
        # volumineux se paie en RAM — autant le dire avant, pas pendant.
        try:
            libre = shutil.disk_usage(tempfile.gettempdir()).free
            if libre < JETABLE_MINIMUM:
                message = ("Il reste %d Mo de mémoire pour l'Espace jetable. "
                           "Évitez d'y télécharger de gros fichiers."
                           % (libre // (1024 * 1024)))
                sys.stderr.write("codebyr-space : %s\n" % message)
                _prevenir("Espace jetable : mémoire limitée", message)
        except OSError:
            pass
        return tempfile.mkdtemp(prefix="codebyr-jetable-%s-" % esp["id"])
    home = os.path.join(DATA_ROOT, esp["id"], "home")
    fichiers_surs.mkdir(home)
    return home


def build_command(esp, home, app_cmd):
    """Construit la ligne de commande, avec marqueur de fenêtre par Espace."""
    wm_class = "codebyr-" + esp["id"]
    prog = os.path.basename(app_cmd[0])

    # Firefox : classe de fenêtre par Espace (colore la fenêtre).
    # Pas de --profile : le dossier personnel isolé de l'Espace (HOME) suffit à
    # séparer le profil, et un chemin --profile serait invalide dans le bac à
    # sable bubblewrap (d'où l'erreur « Profile missing »).
    if "firefox" in prog:
        return app_cmd + ["--class", wm_class, "--name", wm_class]
    return app_cmd


def cmd_list(espaces):
    print("Espaces disponibles :")
    for e in espaces.values():
        tag = "  (éphémère)" if e.get("ephemere") else ""
        print("  \033[1m%-12s\033[0m %s  %s%s" % (e["id"], e["couleur"], e["nom"], tag))


def _preparer_profil_firefox(home, port):
    """Pré-configure le profil Firefox de l'Espace pour passer par le filtre réseau."""
    ffbase = os.path.join(home, ".mozilla", "firefox")
    ffdir = os.path.join(ffbase, "codebyr.default")
    fichiers_surs.mkdir(ffdir)
    ini = os.path.join(ffbase, "profiles.ini")
    if not os.path.exists(ini):
        with fichiers_surs.ouvrir(ini, "w", encoding="utf-8") as f:
            f.write("[Profile0]\nName=codebyr\nIsRelative=1\nPath=codebyr.default\n"
                    "Default=1\n\n[General]\nStartWithLastProfile=1\nVersion=2\n")
    prefs = [
        'user_pref("network.proxy.type", 1);',
        'user_pref("network.proxy.http", "127.0.0.1");',
        'user_pref("network.proxy.http_port", %d);' % port,
        'user_pref("network.proxy.ssl", "127.0.0.1");',
        'user_pref("network.proxy.ssl_port", %d);' % port,
        'user_pref("network.proxy.share_proxy_settings", true);',
        'user_pref("network.proxy.allow_hijacking_localhost", true);',
        'user_pref("network.trr.mode", 5);',
    ]
    _ajouter_prefs(os.path.join(ffdir, "user.js"), prefs)


OUVREUR = "io.codebyr.Ouvrir.desktop"


def types_ouvreur(chemin_desktop):
    """Les types MIME que l'ouvreur Codebyr prend en charge.

    Lus DANS le .desktop plutôt que recopiés ici. Cette liste existerait sinon
    à deux endroits, et ce projet sait ce que deviennent les listes livrées en
    double — c'est ainsi que quatre lectures du registre ont divergé.
    """
    try:
        with open(chemin_desktop, encoding="utf-8") as f:
            for ligne in f:
                if ligne.startswith("MimeType="):
                    return [t for t in ligne.split("=", 1)[1].strip().split(";") if t]
    except OSError:
        pass
    return []


def associer_ouvreur(contenu, types, ouvreur=OUVREUR):
    """Ajoute nos associations à un mimeapps.list, sans écraser les siennes.

    Décision pure pour être testable — elle touche à un fichier de préférences
    que l'utilisateur a le droit d'avoir rempli lui-même. Un type déjà associé
    est laissé tel quel : quelqu'un qui a choisi son visionneuse de PDF a fait
    un choix, et le lui reprendre au nom de la sécurité est le genre de geste
    qui fait désinstaller un système.
    """
    lignes = (contenu or "").splitlines()
    try:
        debut = lignes.index("[Default Applications]")
    except ValueError:
        lignes = lignes + ([""] if lignes and lignes[-1] else []) + ["[Default Applications]"]
        debut = len(lignes) - 1
    fin = len(lignes)
    for i in range(debut + 1, len(lignes)):
        if lignes[i].startswith("["):
            fin = i
            break
    deja = {ligne.split("=", 1)[0].strip()
            for ligne in lignes[debut + 1:fin] if "=" in ligne}
    ajouts = ["%s=%s" % (t, ouvreur) for t in types if t not in deja]
    if not ajouts:
        return contenu or ""
    return "\n".join(lignes[:fin] + ajouts + lignes[fin:]) + "\n"


def _preparer_ouverture(home, chemin_desktop=None):
    """Fait de l'ouvreur Codebyr le gestionnaire par défaut DANS l'Espace.

    C'est là, et seulement là, que la question a un sens : on y sait où l'on
    est, donc on peut dire qu'un fichier vient d'ailleurs. Sur le bureau il n'y
    a pas d'« ici », et rien n'est modifié.
    """
    types = types_ouvreur(chemin_desktop
                          or os.path.join("/usr/share/applications", OUVREUR))
    if not types:
        return
    cible = os.path.join(home, ".config", "mimeapps.list")
    try:
        fichiers_surs.mkdir(os.path.dirname(cible))
        contenu = ""
        if os.path.exists(cible):
            with fichiers_surs.ouvrir(cible, encoding="utf-8") as f:
                contenu = f.read()
        nouveau = associer_ouvreur(contenu, types)
        if nouveau != contenu:
            with fichiers_surs.ouvrir(cible, "w", encoding="utf-8") as f:
                f.write(nouveau)
    except OSError:
        pass    # un défaut de préférence ne doit jamais empêcher un lancement


def _prevenir(titre, message):
    """Dit quelque chose à l'utilisateur du bureau, sans dépendance dure.

    Un message sur la sortie standard d'un programme lancé depuis un menu ne
    sera jamais lu par personne."""
    if not shutil.which("notify-send"):
        return
    try:
        # « --app-name » : sans lui, GNOME affiche « notify-send » en en-tête,
        # c'est-à-dire le nom du programme qui envoie. Sur un système dont
        # l'argument est la lisibilité, une notification signée du nom d'un
        # outil en ligne de commande décrédibilise le message qu'elle porte.
        subprocess.Popen(["notify-send", "--app-name=Codebyr",
                          "--icon=dialog-information",
                          titre, message],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


def journal_refus(esp_id):
    """Fichier où le filtre note les domaines qu'il a refusés dans cet Espace.

    « Configuration Codebyr » le relit pour proposer de les autoriser : c'est la
    réponse au cas concret « ma banque ne s'affiche plus » (site bancaire qui
    charge un CDN, un prestataire 3-D Secure ou un captcha sur un autre domaine).
    Convention de chemin partagée avec codebyr-config — si elle change ici,
    elle change là-bas."""
    return os.path.join(DATA_ROOT, esp_id, "domaines-refuses.txt")


def _demarrer_filtre_reseau(esp, home, app_cmd, chemin_socket=None, compte_dedie_=False):
    """Si l'Espace a une liste blanche et lance Firefox : démarre le filtre
    et configure le navigateur pour l'utiliser. Renvoie le processus proxy.

    Liste VIDE = tout est bloqué, jamais « tout est permis ». Un Espace déclaré
    à liste blanche dont la liste n'est pas encore remplie doit échouer FERMÉ :
    l'utilisateur voit une page de blocage qui lui dit d'ajouter sa banque,
    au lieu de croire à tort qu'il est protégé."""
    reseau = esp.get("reseau") or {}
    if reseau.get("mode") != "liste-blanche":
        return None
    domaines = reseau.get("domaines") or []
    srv = None
    try:
        # On ouvre NOUS-MÊMES la socket d'écoute et on la transmet au filtre :
        # plus de course entre « trouver un port libre » et « s'y installer »,
        # et le port écoute déjà quand le navigateur démarre.
        srv = socket.socket(socket.AF_UNIX if chemin_socket else socket.AF_INET,
                            socket.SOCK_STREAM)
        srv.bind(chemin_socket if chemin_socket else ("127.0.0.1", 0))
        if compte_dedie_:
            # Dans le dépôt, que seuls le bureau et cet Espace traversent.
            os.chmod(chemin_socket, 0o666)
        srv.listen(64)
        port = 17890 if chemin_socket else srv.getsockname()[1]

        # Le profil est configuré AVANT de lancer le filtre, volontairement : si
        # le filtre ne démarre pas, le navigateur pointe vers un port muet et ne
        # joint plus rien. L'ordre inverse laissait l'Espace Banque avec un accès
        # Internet complet quand le filtre manquait à l'appel.
        #
        # Sous compte dédié, c'est l'Espace qui l'a déjà fait, plus tôt et dans
        # le même ordre : le bureau n'a plus accès à son dossier.
        if "firefox" in os.path.basename(app_cmd[0]) and not compte_dedie_:
            _preparer_profil_firefox(home, port)

        # Le dossier du journal des refus existe AVANT le filtre. Son profil
        # AppArmor l'autorise à écrire ce fichier, pas à créer de dossier — et
        # c'est voulu. Pour un Espace ordinaire le dossier existait déjà, créé
        # avec ses données ; pour un Espace à compte dédié, personne ne le
        # créait : les refus avaient bien lieu, mais n'étaient notés nulle part,
        # et « Configuration Codebyr » ne pouvait plus proposer d'autoriser le
        # domaine qui manque à la banque. Constaté le 14/09/2026.
        try:
            fichiers_surs.mkdir(os.path.dirname(journal_refus(esp["id"])))
        except OSError as exc:
            sys.stderr.write("codebyr-space : journal des refus indisponible (%s)\n" % exc)

        proc = subprocess.Popen(["codebyr-net-proxy", "--fd", str(srv.fileno()),
                                 "--journal", journal_refus(esp["id"])] + domaines,
                                pass_fds=(srv.fileno(),))
        if domaines:
            print("Réseau restreint : seuls %d domaine(s) autorisé(s) dans %s."
                  % (len(domaines), esp["nom"]))
        else:
            print("Réseau restreint : AUCUN site autorisé dans %s pour l'instant. "
                  "Ajoutez celui de votre banque dans « Configuration Codebyr »."
                  % esp["nom"])
            # En HTTPS, le navigateur affiche SA propre page d'erreur : notre
            # explication n'arrive jamais à l'écran. Or c'est le premier
            # contact d'un nouvel utilisateur avec la fonctionnalité phare —
            # il clique sur Banque, rien ne s'affiche, et il n'a aucune idée
            # de pourquoi. Une notification, elle, passe quel que soit le
            # protocole.
            _prevenir("Espace %s : aucun site autorisé" % esp["nom"],
                      "Ouvrez « Configuration Codebyr » pour déclarer votre "
                      "banque. Tant qu'elle n'est pas déclarée, cet Espace "
                      "n'ouvre aucun site — c'est voulu.")
        return proc
    except OSError as exc:
        sys.stderr.write("codebyr-space : filtre réseau indisponible (%s) — "
                         "le navigateur de cet Espace ne joindra aucun site.\n" % exc)
        raise
    finally:
        # Le filtre a sa propre copie de la socket : la nôtre n'a plus lieu d'être.
        if srv is not None:
            srv.close()


BOUCLIER_DIR = "/usr/share/codebyr/antiphishing"
BOUCLIER_ID = "antiphishing@codebyr.io"


def _domaines_proteges(espaces):
    """Domaines des banques protégées (liste blanche des Espaces à réseau restreint)."""
    out = []
    for e in espaces.values():
        r = e.get("reseau") or {}
        if r.get("mode") == "liste-blanche":
            for d in (r.get("domaines") or []):
                d = d.strip().removeprefix("*.")
                if d and d not in out:
                    out.append(d)
    return out


def _ecrire_stockage_manage(home, doms):
    """Écrit le manifeste de STOCKAGE MANAGÉ Firefox : les domaines protégés sont
    fournis en DONNÉE (pas injectés dans le code), pour que l'extension reste
    statique et signable. Firefox lit ce fichier par utilisateur sous Linux."""
    msdir = os.path.join(home, ".mozilla", "managed-storage")
    fichiers_surs.mkdir(msdir)
    manifeste = {
        "name": BOUCLIER_ID,
        "description": "Domaines bancaires protégés par Codebyr.",
        "type": "storage",
        "data": {"domaines": doms},
    }
    with fichiers_surs.ouvrir(os.path.join(msdir, BOUCLIER_ID + ".json"), "w", encoding="utf-8") as f:
        json.dump(manifeste, f, ensure_ascii=False)


def _ajouter_prefs(chemin, prefs):
    """Ajoute des « user_pref » à un user.js SANS le faire grossir sans fin.

    Ce fichier était réécrit en mode « ajout » à chaque lancement d'Espace : au
    bout de quelques centaines d'ouvertures, Firefox relisait la même
    préférence des centaines de fois. On dédoublonne, et on écrit une seule fois."""
    existantes = []
    try:
        with fichiers_surs.ouvrir(chemin, encoding="utf-8") as f:
            existantes = [l.rstrip("\n") for l in f if l.strip()]
    except OSError:
        pass
    def cle(ligne):
        resultat = re.match(r'\s*user_pref\("([^"\n]+)"\s*,', ligne)
        return resultat.group(1) if resultat else None
    gerees = {cle(p) for p in prefs} - {None}
    existantes = [l for l in existantes if cle(l) not in gerees]
    existantes.extend(dict.fromkeys(prefs))
    with fichiers_surs.ouvrir(chemin, "w", encoding="utf-8") as f:
        f.write("\n".join(existantes) + "\n")


def _installer_bouclier(esp, home, espaces):
    """Installe le bouclier anti-hameçonnage dans le profil Firefox d'un Espace
    de navigation : avertit si un site imite une banque protégée.

    Les domaines passent par le stockage managé : le code de l'extension reste
    STATIQUE, donc signable par Mozilla. Seul un .xpi SIGNÉ est installé.

    Il n'existe volontairement PLUS de repli « .xpi non signé » : il obligeait à
    poser xpinstall.signatures.required=false, c'est-à-dire à désactiver la
    vérification des signatures d'extensions dans le profil — un affaiblissement
    réel du navigateur pour installer une protection. Sans .xpi signé, on
    n'installe rien, et on le dit."""
    _installer_bouclier_pour(home, _domaines_proteges(espaces))


def _installer_bouclier_pour(home, doms):
    """Le bouclier, à partir de la seule liste des domaines protégés.

    Séparé pour pouvoir être posé DEPUIS un Espace à compte dédié : celui-ci
    ne peut pas lire le registre de l'utilisateur, on ne lui transmet que la
    liste dont il a besoin.
    """
    if not doms or not os.path.isdir(BOUCLIER_DIR):
        return
    ffbase = os.path.join(home, ".mozilla", "firefox")
    ffdir = os.path.join(ffbase, "codebyr.default")
    extdir = os.path.join(ffdir, "extensions")
    fichiers_surs.mkdir(extdir)
    ini = os.path.join(ffbase, "profiles.ini")
    if not os.path.exists(ini):
        with fichiers_surs.ouvrir(ini, "w", encoding="utf-8") as f:
            f.write("[Profile0]\nName=codebyr\nIsRelative=1\nPath=codebyr.default\n"
                    "Default=1\n\n[General]\nStartWithLastProfile=1\nVersion=2\n")

    # Domaines fournis en donnée (l'extension reste statique → signable).
    _ecrire_stockage_manage(home, doms)

    # .xpi signé par Mozilla, s'il y en a un (nom quelconque : AMO le génère).
    signe = None
    signed_dir = os.path.join(BOUCLIER_DIR, "signed")
    if os.path.isdir(signed_dir):
        for f in sorted(os.listdir(signed_dir)):
            if f.endswith(".xpi"):
                signe = os.path.join(signed_dir, f)
                break
    if signe is None:
        sys.stderr.write(
            "codebyr-space : bouclier anti-hameçonnage indisponible (aucune "
            "extension signée dans %s/signed). Aucune protection installée — et "
            "aucun réglage de sécurité de Firefox abaissé.\n" % BOUCLIER_DIR)
        return

    _ajouter_prefs(os.path.join(ffdir, "user.js"), [
        'user_pref("extensions.autoDisableScopes", 0);',
        'user_pref("extensions.enabledScopes", 15);',
    ])

    with open(signe, "rb") as src, fichiers_surs.ouvrir(
            os.path.join(extdir, BOUCLIER_ID + ".xpi"), "wb") as dst:
        shutil.copyfileobj(src, dst)
    print("Bouclier anti-hameçonnage actif [signé] "
          "(%d domaine(s) de banque protégé(s))." % len(doms))


def _visionneuse_pour(nom):
    """Choisit une visionneuse CONCRÈTE selon le type de fichier, pour ouvrir une
    pièce jointe sans passer par xdg-open/gvfs — qui échoue dans le bac à sable
    blindé et hors-ligne (pas de service de lancement, pas de fuse)."""
    ext = os.path.splitext(nom)[1].lower()

    def premier(*cands):
        for c in cands:
            if shutil.which(c):
                return [c]
        return None

    v = None
    if ext == ".pdf":
        v = premier("evince", "papers", "xpdf", "qpdfview")
    elif ext in (".png", ".jpg", ".jpeg", ".gif", ".bmp", ".webp",
                 ".svg", ".tiff", ".tif", ".ico"):
        v = premier("loupe", "eog")
    elif ext in (".html", ".htm", ".xhtml", ".mhtml"):
        v = premier("firefox-esr", "firefox")
    elif ext in (".odt", ".doc", ".docx", ".xls", ".xlsx", ".ods",
                 ".ppt", ".pptx", ".odp", ".rtf", ".csv"):
        v = premier("libreoffice", "soffice")
    elif ext in (".zip", ".7z", ".rar", ".tar", ".gz", ".xz", ".bz2"):
        v = premier("file-roller", "engrampa")
    # Défaut (texte, sans extension, type inconnu) : éditeur de texte.
    if v is None:
        v = premier("gnome-text-editor", "gedit", "evince", "papers")
    return v or ["xdg-open"]


def _refuser_compte_dedie(esp, raison):
    """Un Espace à compte dédié qui ne peut pas s'ouvrir tel quel ne s'ouvre pas.

    Jamais de repli sous le compte du bureau : ce serait retirer à l'Espace, en
    silence, la protection qu'on lui a promise (voir compte_dedie.py).
    """
    sys.stderr.write("codebyr-space : %s ne s'ouvre pas — %s.\n" % (esp["nom"], raison))
    _prevenir("Espace %s : ouverture refusée" % esp["nom"], raison[:1].upper() + raison[1:] + ".")
    journal("Espace %s : compte dédié, ouverture refusée (%s)" % (esp["id"], raison))
    return 1


def cmd_launch(espaces, esp_id, extra, fichier=None):
    esp = espaces.get(esp_id)
    if not esp:
        sys.stderr.write("Espace inconnu : %s\n" % esp_id)
        return 2
    if not shutil.which("bwrap"):
        _prevenir("Isolation indisponible", "bubblewrap manque : lancement refusé. Réparez le paquet codebyr-tools.")
        sys.stderr.write("bubblewrap absent : lancement refusé.\n")
        return 1
    if fichier and not os.path.isfile(fichier):
        sys.stderr.write("Fichier introuvable : lancement refusé.\n")
        return 2
    if not compte_dedie.demande(esp):
        # Réglage « compte » retiré après un passage sous compte dédié : les
        # données récentes sont chez l'Espace, on les rapatrie d'abord.
        if not _rapatrier_depuis_compte_dedie(esp):
            return _refuser_compte_dedie(
                esp, "ses données récentes n'ont pas pu revenir de son compte dédié")
        return _lancer(espaces, esp, extra, fichier, None)

    # Tout ce qui peut refuser l'ouverture se décide AVANT de demander le
    # compte au service : rien à défaire si l'on s'arrête ici.
    app_prevue = extra if extra else applications.resoudre(
        esp.get("app", "org.gnome.Nautilus.desktop"))
    refus = compte_dedie.incompatibilites(
        esp, fichier, est_flatpak=os.path.basename(app_prevue[0]) == "flatpak")
    if refus:
        return _refuser_compte_dedie(esp, refus[0])
    # Une pièce jointe s'examine sans réseau, donc sans son (voir _lancer) : le
    # compte doit être préparé en conséquence, sans socket PipeWire.
    hors_ligne = (esp.get("reseau") or {}).get("mode") in ("coupe", "hors-ligne") \
        or bool(fichier)
    try:
        session = compte_dedie.Session(
            esp["id"],
            os.path.basename(os.environ.get("WAYLAND_DISPLAY") or "wayland-0"),
            esp.get("audio", True) is not False and not hors_ligne,
            *bac_a_sable.plafonds_de(esp),
            # Jetable : son dossier est un tmpfs, monté par le service à
            # l'ouverture et démonté à la fermeture — rien n'atteint le disque.
            ephemere=bool(esp.get("ephemere")))
    except compte_dedie.Indisponible as exc:
        return _refuser_compte_dedie(esp, str(exc))
    try:
        return _lancer(espaces, esp, extra, fichier, session)
    finally:
        # Rendre la tenue, quel que soit le chemin de sortie : le service
        # referme l'Espace quand sa dernière application est partie.
        session.rendre()


def _lancer(espaces, esp, extra, fichier, session):
    """Le lancement proprement dit. `session` : compte dédié tenu, ou None."""
    home = session.home if session else espace_home(esp)
    # Dans un Espace, un fichier venu d'ailleurs s'ouvre sous cloche. Câblé au
    # lancement plutôt qu'à la création : un Espace existant en profite aussi,
    # sans quoi le correctif n'atteindrait que les Espaces créés après lui.
    envoi = None
    if session:
        # Le dossier de l'Espace n'est plus accessible au bureau — c'est tout
        # l'objet du compte dédié. Ce qui s'y prépare (associations, modèles,
        # profil de navigateur, bouclier) est donc fait PAR l'Espace, sur
        # ordre, plus bas (voir cmd_interne_preparer).
        #
        # Sa boîte de départ, préparée par le service hors de son dossier,
        # apparaît au même endroit que pour un Espace ordinaire.
        envoi = session.envois
        if not _espace_courant():
            relever_envois(espaces)
    elif not esp.get("ephemere"):
        _preparer_ouverture(home)
        # « Nouveau document » n'existe dans Fichiers que si le dossier Modèles
        # contient quelque chose. Chaque Espace a le sien : sans cela, créer un
        # fichier texte y oblige à passer par un terminal.
        modeles.installer(home)
        # La boîte d'envoi de CET Espace, et la relève de ce que les autres ont
        # déposé. Les deux se font ICI, depuis l'hôte : c'est le seul endroit
        # d'où l'on voit tous les Espaces, et le moment où l'on va justement
        # chercher ses fichiers.
        envoi = boite_envoi(esp["id"])
        try:
            fichiers_surs.mkdir(envoi)
        except OSError:
            envoi = None
        if not _espace_courant():
            relever_envois(espaces)
    use_bwrap = True  # vérifié avant toute préparation ; jamais de repli non isolé
    runtime_home = os.path.expanduser("~") if use_bwrap else home

    # Niveau d'isolation : « renforce » déclaré dans le registre (ex. Banque),
    # ou imposé automatiquement pour l'examen d'une pièce jointe.
    renforce = esp.get("blindage") == "renforce"
    hors_ligne = (esp.get("reseau") or {}).get("mode") in ("coupe", "hors-ligne")
    # Son : le socket PipeWire donne aussi accès au MICRO. Un Espace peut le
    # refuser dans le registre ("audio": false) — c'est le cas de Banque, qui
    # n'a aucun besoin de son et représente la cible la plus sensible.
    audio = esp.get("audio", True) is not False
    # Carte graphique : même logique que le son (voir bac_a_sable.wrap_bwrap).
    gpu = esp.get("gpu", True) is not False

    # Fichier partagé dans l'Espace (ouverture jetable d'une pièce jointe) :
    # copié dans l'Espace pour être visible dans le bac à sable isolé.
    if fichier and os.path.isfile(fichier):
        nom = os.path.basename(fichier)
        try:
            if session:
                # Le bureau n'écrit pas chez l'Espace : la pièce jointe va dans
                # sa boîte d'arrivée, dans un lot au nom choisi ici, que
                # l'Espace recueillira tel quel dans « Partagé » juste avant
                # l'ouverture. Le chemin final est donc connu d'avance.
                # Horodaté ET tiré au sort : deux pièces jointes ouvertes dans la
                # même seconde ne doivent pas se retrouver dans le même lot, où
                # la seconde prendrait un autre nom que celui qu'on ouvrira.
                dossier = "%s %s-%s" % (PIECE_JOINTE, time.strftime("%Y-%m-%d %Hh%M%S"),
                                       secrets.token_hex(2))
                lot = os.path.join(session.arrivees, dossier)
                fichiers_surs.mkdir(lot)
                with fichiers_surs.dossier(lot) as fd:
                    # L'Espace doit pouvoir le vider ; seuls lui et le bureau
                    # traversent la boîte d'arrivée.
                    os.fchmod(fd, 0o777)
                nom = fichiers_surs.copier_unique(fichier, lot, nom, mode=0o644)
                relatif = os.path.join(PARTAGE, dossier, nom)
            else:
                partage = os.path.join(home, PARTAGE)
                fichiers_surs.mkdir(partage)
                nom = fichiers_surs.copier_unique(fichier, partage, nom)
                relatif = os.path.join(PARTAGE, nom)
        except OSError as exc:
            sys.stderr.write("codebyr-space : copie du fichier impossible (%s)\n" % exc)
            return 1
        if not extra:
            chemin = os.path.join(runtime_home, relatif)
            extra = _visionneuse_pour(nom) + [chemin]
        # Sous cloche : une pièce jointe s'examine blindée ET sans réseau.
        renforce = True
        hors_ligne = True
        gpu = False

    app_cmd = extra if extra else applications.resoudre(esp.get("app", "org.gnome.Nautilus.desktop"))
    # Une application Flatpak s'isole DÉJÀ dans son propre bac à sable : on ne
    # peut ni l'enfermer dans le nôtre (sandbox imbriqué = échec), ni lui donner
    # un bus de session privé (elle a besoin du vrai bus pour ses portails).
    est_flatpak = os.path.basename(app_cmd[0]) == "flatpak" or app_cmd[0].endswith("/flatpak")
    if est_flatpak and (renforce or hors_ligne or esp.get("ephemere") or
                        (esp.get("reseau") or {}).get("mode") == "liste-blanche"):
        _prevenir("Application incompatible avec cet Espace",
                  "Les permissions Flatpak ne garantissent pas le blindage ou le réseau demandé. Utilisez une application native.")
        return 1
    cmd = build_command(esp, home, app_cmd)

    # Bus de session privé par Espace : les apps « mono-instance » (Fichiers,
    # éditeur…) démarrent alors un vrai processus isolé au lieu de rouvrir une
    # fenêtre de la session partagée — ce qui rétablit l'isolation ET le liseré.
    # Ce bus privé n'est pas un confort : c'est LUI qui remplace le bus de
    # session de l'hôte, que le bac à sable n'expose plus (voir wrap_bwrap).
    if not est_flatpak:
        if shutil.which("dbus-run-session"):
            cmd = ["dbus-run-session", "--"] + cmd
        else:
            sys.stderr.write("codebyr-space : dbus-run-session absent — l'application "
                             "n'aura aucun bus de session (paquet « dbus » manquant ?).\n")

    env = dict(os.environ)
    # Le service de notifications n'est déclaré QUE pour les Espaces : son
    # fichier .service vit dans un dossier de données à part, ajouté ici. Sur
    # le bureau, c'est GNOME Shell qui fournit ce nom, et rien ne le remplace.
    env["XDG_DATA_DIRS"] = "/usr/share/codebyr/bus:" + env.get(
        "XDG_DATA_DIRS", "/usr/local/share:/usr/share")
    env["CODEBYR_ESPACE"] = esp["id"]
    env["CODEBYR_ESPACE_COULEUR"] = esp["couleur"]
    # Sous Wayland, c'est MOZ_APP_REMOTINGNAME qui fixe l'app_id de Firefox
    # (donc la « classe » que lit l'extension pour colorer la fenêtre).
    if "firefox" in os.path.basename(app_cmd[0]):
        env["MOZ_APP_REMOTINGNAME"] = "codebyr-" + esp["id"]
        # Force Firefox à utiliser NOTRE profil (profiles.ini Default=1) au lieu
        # d'en créer un « dédié par installation » — sinon les réglages proxy du
        # filtre réseau ne s'appliquent pas.
        env["MOZ_LEGACY_PROFILES"] = "1"
        env["MOZ_ALLOW_DOWNGRADE"] = "1"

    ephemere = esp.get("ephemere")
    liste_blanche = (esp.get("reseau") or {}).get("mode") == "liste-blanche"
    if session:
        env["CODEBYR_COMPTE_DEDIE"] = "1"
        # Le déménagement passe AVANT la préparation : celle-ci complète les
        # associations de fichiers de l'Espace, elle doit donc trouver celles
        # qu'il avait déjà.
        if not _demenager_vers_compte_dedie(esp, session):
            return _refuser_compte_dedie(
                esp, "ses données n'ont pas pu le suivre sous son propre compte "
                "(elles sont intactes à leur ancien emplacement)")
        # AVANT le filtre réseau, et c'est voulu : le profil du navigateur doit
        # pointer vers le filtre avant que celui-ci existe. Dans l'ordre
        # inverse, un filtre absent laissait Banque avec Internet en entier.
        if not _preparer_depuis_l_espace(session, espaces, app_cmd,
                                         liste_blanche and not hors_ligne):
            return _refuser_compte_dedie(
                esp, "son dossier n'a pas pu être préparé (voir le journal)")
    # Notifications : une socket par Espace, servie par l'hôte tant que
    # l'Espace vit. Le service qui la joint tourne DANS l'Espace, sur son bus
    # privé — celui-ci n'est jamais remplacé (voir relais_notifications.py).
    if session:
        # Dans le dépôt, que le compte de l'Espace traverse ; un nom par
        # lanceur, car deux applications du même Espace s'y côtoient.
        notif_tmp = None
        notif = os.path.join(session.depot, "notif-%d" % os.getpid())
    else:
        notif_tmp = tempfile.TemporaryDirectory(prefix="codebyr-notif-")
        notif = os.path.join(notif_tmp.name, "notif")
    try:
        notif_srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        notif_srv.bind(notif)
        if session:
            # Le dépôt fait le tri (seuls le bureau et cet Espace le
            # traversent) ; sur la socket, il faut le droit d'écrire pour s'y
            # connecter.
            os.chmod(notif, 0o666)
        notif_srv.listen(8)
        threading.Thread(
            target=relais_notifications.servir,
            args=(notif_srv, esp["nom"]),
            kwargs={"journal": journal}, daemon=True).start()
    except OSError as exc:
        # Sans notifications, l'Espace s'ouvre quand même : elles sont un
        # confort, pas une frontière de sécurité.
        sys.stderr.write("codebyr-space : notifications indisponibles (%s)\n" % exc)
        notif_srv = None
        notif = None
    proxy = None
    filtre = None
    filtre_tmp = None
    if liste_blanche and not hors_ligne:
        if session:
            filtre = os.path.join(session.depot, "proxy-%d" % os.getpid())
        else:
            filtre_tmp = tempfile.TemporaryDirectory(prefix="codebyr-filtre-")
            filtre = os.path.join(filtre_tmp.name, "proxy")
        try:
            proxy = _demarrer_filtre_reseau(esp, home, app_cmd, filtre,
                                            compte_dedie_=bool(session))
        except OSError:
            if filtre_tmp:
                filtre_tmp.cleanup()
            _prevenir("Filtre indisponible", "Lancement refusé : le réseau restreint ne peut pas être établi.")
            return 1
        cmd = ["python3", "/usr/share/codebyr/relais_reseau.py",
               "/run/codebyr-proxy", "17890", "--"] + cmd
    if est_flatpak:
        appid = app_cmd[-1] if len(app_cmd) >= 2 else ""
        if session:
            # Sous compte dédié, c'est l'Espace qui lance — son compte, son
            # dossier d'exécution, son bus, son installation Flatpak. Le bureau
            # ne peut rien lire de tout cela : il ne vérifie donc pas où
            # l'application est installée, il la nomme et laisse flatpak
            # chercher chez l'Espace d'abord, puis sur la machine.
            env = _env_flatpak_dedie(esp, session, env)
            run = cmd
            print("Application Flatpak dans l'Espace %s, sous son compte." % esp["nom"])
            _prevenir("Permissions Flatpak",
                      "Ses accès aux fichiers et au réseau dépendent des "
                      "permissions de cette application, dans les limites du "
                      "compte de l'Espace.")
            journal("Espace %s : application Flatpak %s sous compte dédié"
                    % (esp["id"], appid or "?"))
        elif appid and _flatpak_app_dans_espace(esp["id"], appid):
            # Installée DANS l'Espace : installation Flatpak dédiée +
            # données isolées (HOME de l'Espace → ~/.var/app séparé).
            env["FLATPAK_USER_DIR"] = _espace_flatpak_dir(esp["id"])
            env["HOME"] = home
            run = cmd
            print("Application Flatpak dédiée à %s : permissions Flatpak applicables." % esp["nom"])
            _prevenir("Permissions Flatpak", "Installation dédiée ; les accès aux fichiers et au réseau dépendent des permissions de cette application.")
        else:
            # App Flatpak SYSTÈME : installée pour toute la machine. Elle a son
            # propre bac à sable Flatpak, mais ses données sont communes à tous
            # les Espaces — ce qu'elle enregistre depuis Travail, elle le
            # retrouve depuis Personnel.
            #
            # L'avertissement existait, dans le terminal : c'est-à-dire nulle
            # part, pour quelqu'un qui a cliqué dans un menu. L'utilisateur
            # croyait son application cloisonnée alors qu'elle ne l'est pas, et
            # le liseré coloré le lui confirmait à tort.
            run = cmd
            nom_app = os.path.basename(app_cmd[-1] if len(app_cmd) >= 2
                                       else app_cmd[0])
            print("Note : application Flatpak système — son propre bac à sable "
                  "Flatpak ; le liseré de l'Espace reste indicatif.")
            _prevenir(
                "%s n'est pas cloisonnée dans %s" % (nom_app, esp["nom"]),
                "Cette application est installée pour toute la machine : ses "
                "données sont les mêmes dans tous les Espaces. Pour l'isoler, "
                "installez-la DANS l'Espace depuis « Configuration Codebyr ».")
            journal("Espace %s : application Flatpak système %s (non cloisonnée)"
                    % (esp["id"], nom_app))
    else:
        run = bac_a_sable.wrap_bwrap(home, cmd, env, renforce=renforce, hors_ligne=hors_ligne,
                         audio=audio, envoi=envoi, filtre=filtre, gpu=gpu,
                         notifications=notif,
                         # Le dossier d'un Espace dédié apparaît au MÊME chemin
                         # qu'avant (celui du bureau) : les applications gardent
                         # des chemins absolus — dossier de téléchargement de
                         # Firefox, fichiers récents, signets. Déménagés vers un
                         # autre chemin, ils pointeraient dans le vide.
                         runtime_espace=session.runtime if session else None)
        if renforce:
            if not session:
                # Sous compte dédié, les plafonds sont déjà posés par le service
                # sur l'Espace ENTIER ; « systemd-run --user » ne traverserait
                # de toute façon pas le changement de compte.
                run = bac_a_sable.plafonner_ressources(run, *bac_a_sable.plafonds_de(esp))
            detail = "Blindage actif" + (" · hors-ligne (aucun réseau)" if hors_ligne else "")
            print("🛡  %s dans l'Espace %s." % (detail, esp["nom"]))
        if not audio:
            print("🎤 Son et micro coupés dans l'Espace %s." % esp["nom"])

    print("Ouverture de « %s » dans l'Espace %s…" % (os.path.basename(cmd[0]), esp["nom"]))
    journal("Espace %s : ouverture de %s%s%s%s"
            % (esp["id"], os.path.basename(app_cmd[0]),
               " [blindage]" if renforce else "",
               " [hors-ligne]" if hors_ligne else "",
               "" if use_bwrap or est_flatpak else " [SANS bac à sable]"))
    # Répertoire d'exécution partagé avec l'extension GNOME : on y note
    # « ce processus (et ses enfants) appartient à tel Espace », pour que
    # l'extension colore la fenêtre par filiation, même sans marqueur de classe.
    rundir = _rundir()
    try:
        os.makedirs(rundir, exist_ok=True)
    except OSError:
        pass
    _nettoyer_marqueurs()

    # Bouclier anti-hameçonnage dans TOUS les navigateurs, y compris celui de
    # l'Espace Banque. On l'en excluait au motif que sa liste blanche suffit —
    # mais cette liste est saisie à la main par l'utilisateur. Le jour où un
    # domaine imitateur y entre par erreur, plus rien ne le signale : la liste
    # blanche le laisse passer, et le bouclier n'était pas là pour crier.
    # Or l'erreur humaine est précisément la menace que cette fonctionnalité
    # existe pour couvrir.
    #
    # Sous compte dédié, l'Espace l'a déjà installé lui-même, dans son dossier.
    if "firefox" in os.path.basename(app_cmd[0]) and not session:
        try:
            _installer_bouclier(esp, home, espaces)
        except OSError as exc:
            sys.stderr.write("codebyr-space : bouclier indisponible (%s)\n" % exc)

    marqueurs = []

    def marquer(pid):
        """Note « ce processus appartient à tel Espace » pour l'extension GNOME."""
        mapfile = os.path.join(rundir, "pid-%d" % pid)
        birthfile = os.path.join(rundir, "birth-%d" % pid)
        marqueurs.append(birthfile)
        try:
            naissance = _naissance_processus(pid)
            if not naissance:
                raise OSError("Processus terminé avant son enregistrement")
            with fichiers_surs.ouvrir(birthfile, "w", encoding="ascii") as f:
                f.write(naissance)
            with open(mapfile, "w", encoding="utf-8") as f:
                f.write(esp["id"])
            marqueurs.append(mapfile)
        except OSError:
            pass

    try:
        if session:
            # Exécuté par le premier processus de l'Espace, sous SON compte :
            # le bureau ne peut pas devenir un autre compte, et root ne voit
            # jamais la commande (voir codebyr-espace-init).
            try:
                rc = compte_dedie.executer(session.ordres, run, env,
                                           au_lancement=marquer)
            except compte_dedie.Indisponible as exc:
                _prevenir("Espace %s : ouverture impossible" % esp["nom"], str(exc))
                rc = 1
        else:
            proc = subprocess.Popen(run, env=env)
            marquer(proc.pid)
            rc = proc.wait()
    finally:
        if proxy:
            try:
                proxy.terminate()
                proxy.wait(timeout=5)
            except (OSError, subprocess.TimeoutExpired):
                pass
        if filtre_tmp:
            filtre_tmp.cleanup()
        if notif_srv:
            notif_srv.close()
        if notif_tmp:
            notif_tmp.cleanup()
        if session:
            # Nos sockets dans le dépôt : l'Espace survit peut-être à ce
            # lanceur (une autre de ses fenêtres), le dépôt aussi.
            for chemin in (notif, filtre):
                if chemin:
                    try:
                        os.unlink(chemin)
                    except OSError:
                        pass
        for chemin in marqueurs:
            try:
                os.remove(chemin)
            except OSError:
                pass
        if ephemere and os.path.isdir(home) and home.startswith(tempfile.gettempdir()):
            shutil.rmtree(home, ignore_errors=True)
            print("Espace jetable détruit.")
    return rc


INTERNE_PREPARER = "interne-preparer"
PORT_FILTRE_INTERNE = 17890


def _preparer_depuis_l_espace(session, espaces, app_cmd, filtre_reseau):
    """Fait préparer le dossier de l'Espace PAR l'Espace. Renvoie True si fait.

    Le bureau n'a plus accès à ce dossier : ce qui s'y écrivait à chaque
    ouverture est demandé au premier processus de l'Espace, qui l'exécute sous
    le compte de l'Espace. Hors du bac à sable — il écrit dans son propre
    dossier, rien de plus — mais sans que le bac à sable puisse l'atteindre :
    la socket d'ordres n'y est jamais montée.

    C'est aussi plus sûr qu'avant : le bureau écrivait dans un dossier que
    l'Espace contrôle, où un lien symbolique posé par l'Espace pouvait le
    faire écrire ailleurs. Un Espace qui se piège lui-même n'atteint plus que
    ses propres fichiers.
    """
    charge = {
        "firefox": "firefox" in os.path.basename(app_cmd[0]),
        "filtre_reseau": bool(filtre_reseau),
        "domaines_proteges": _domaines_proteges(espaces),
    }
    env = {"PATH": "/usr/bin:/bin", "LANG": os.environ.get("LANG", "C.UTF-8"),
           "HOME": session.home,
           "CODEBYR_LIB": os.environ.get("CODEBYR_LIB", "/usr/share/codebyr")}
    try:
        code = compte_dedie.executer(
            session.ordres,
            ["/usr/bin/python3", os.path.realpath(__file__), INTERNE_PREPARER,
             json.dumps(charge)],
            env)
    except compte_dedie.Indisponible as exc:
        sys.stderr.write("codebyr-space : préparation impossible (%s)\n" % exc)
        return False
    return code == 0


def _recueillir_arrivees(home, arrivees):
    """Recopie chez l'Espace ce que le bureau lui a envoyé, puis vide la boîte.

    Exécuté PAR l'Espace. Il RECOPIE plutôt que de déplacer : un fichier
    déplacé garderait le bureau pour propriétaire, et l'Espace ne pourrait pas
    le modifier. La provenance suit la copie.

    Un lot (sous-dossier, pour une pièce jointe) arrive sous le même nom dans
    « Partagé » : c'est ce qui permet au lanceur d'ouvrir le fichier à un
    chemin connu d'avance. Renvoie le nombre de fichiers recueillis.
    """
    import stat as stat_
    try:
        with fichiers_surs.dossier(arrivees) as fd:
            noms = sorted(os.listdir(fd))
    except FileNotFoundError:
        return 0
    partage = os.path.join(home, PARTAGE)
    recus = 0

    def recueillir(chemin, dossier_cible, nom):
        origine = None
        try:
            origine = os.getxattr(chemin, provenance.ATTRIBUT,
                                  follow_symlinks=False).decode("ascii")
        except (OSError, UnicodeDecodeError):
            pass
        if origine and not provenance.identifiant_valide(origine):
            origine = None
        fichiers_surs.mkdir(dossier_cible)
        fichiers_surs.copier_unique(chemin, dossier_cible, nom, origine)
        os.unlink(chemin)
        return 1

    for nom in noms:
        if nom.startswith(".codebyr-"):
            continue        # écriture du bureau encore en cours
        chemin = os.path.join(arrivees, nom)
        st = os.lstat(chemin)
        if stat_.S_ISREG(st.st_mode):
            recus += recueillir(chemin, partage, nom)
        elif stat_.S_ISDIR(st.st_mode):
            for sous in sorted(os.listdir(chemin)):
                interne = os.path.join(chemin, sous)
                if not sous.startswith(".codebyr-") and stat_.S_ISREG(os.lstat(interne).st_mode):
                    recus += recueillir(interne, os.path.join(partage, nom), sous)
            try:
                os.rmdir(chemin)
            except OSError:
                pass
    return recus


def _ouvreur_associe(home):
    """L'ouvreur Codebyr est-il bien le gestionnaire déclaré dans ce dossier ?"""
    try:
        with fichiers_surs.ouvrir(os.path.join(home, ".config", "mimeapps.list"),
                                  encoding="utf-8") as f:
            return OUVREUR in f.read()
    except OSError:
        return False


MARQUEUR_DEMENAGEMENT = "compte-dedie.json"
# Marge exigée en plus de la taille des données avant de déménager : le
# déménagement COPIE, et un disque plein au milieu laisserait l'Espace sans
# rien d'utilisable des deux côtés.
MARGE_DEMENAGEMENT = 200 * 1024 * 1024


def _marqueur_demenagement(esp_id):
    """Côté bureau : « les données de cet Espace sont parties vers son compte »."""
    return os.path.join(DATA_ROOT, esp_id, MARQUEUR_DEMENAGEMENT)


def _commande_interne(action, *args):
    return ["/usr/bin/python3", os.path.realpath(__file__), action] + list(args)


def _env_interne(session):
    return {"PATH": "/usr/bin:/bin", "LANG": os.environ.get("LANG", "C.UTF-8"),
            "HOME": session.home,
            "CODEBYR_LIB": os.environ.get("CODEBYR_LIB", "/usr/share/codebyr")}


def _taille_sans_suivre(chemin):
    total = 0
    for dossier, _sous, fichiers in os.walk(chemin):
        for nom in fichiers:
            try:
                total += os.lstat(os.path.join(dossier, nom)).st_size
            except OSError:
                pass
    return total


def _ordre_interne(session, action, produire=None, consommer=None, args=()):
    """Fait exécuter un ordre interne par l'Espace, avec un flux si besoin.

    `produire(flux)` écrit ce que l'Espace lira sur son entrée standard ;
    `consommer(flux)` lit ce qu'il écrit sur sa sortie. L'un ou l'autre, dans
    un fil à part : un tuyau plein bloquerait sinon les deux bouts.

    Renvoie (code, erreurs). Le bout transmis est TOUJOURS refermé ici, même
    si l'ordre échoue : sans cela, le fil attendait à jamais un correspondant
    disparu (vu dans le WSL le 14/09/2026).
    """
    erreurs = []
    options = {}
    a_fermer = None
    fil = None
    if produire or consommer:
        lecture, ecriture = os.pipe()
        if produire:
            options["entree"], a_fermer, mien, sens = lecture, lecture, ecriture, "wb"
        else:
            options["sortie"], a_fermer, mien, sens = ecriture, ecriture, lecture, "rb"
        travail = produire or consommer

        def dans_un_fil():
            try:
                with os.fdopen(mien, sens) as flux:
                    travail(flux)
            except BrokenPipeError:
                erreurs.append("l'Espace a cessé de lire")
            except (OSError, tarfile.TarError, ValueError) as exc:
                erreurs.append(str(exc))

        fil = threading.Thread(target=dans_un_fil, daemon=True)
        fil.start()
    try:
        code = compte_dedie.executer(session.ordres,
                                     _commande_interne(action, *args),
                                     _env_interne(session), **options)
    except compte_dedie.Indisponible as exc:
        code = None
        erreurs.append(str(exc))
    finally:
        if a_fermer is not None:
            os.close(a_fermer)
    if fil:
        fil.join()
    return code, erreurs


def _session_pour_un_geste(esp):
    """Ouvre l'Espace le temps d'un geste sur ses données (sans son)."""
    return compte_dedie.Session(
        esp["id"], os.path.basename(os.environ.get("WAYLAND_DISPLAY") or "wayland-0"),
        False, *bac_a_sable.plafonds_de(esp), ephemere=bool(esp.get("ephemere")))


def _emballer(dossier, noms):
    """Fabrique qui écrit l'archive d'un dossier dans un flux, sans suivre de lien."""
    def produire(flux):
        with tarfile.open(fileobj=flux, mode="w|") as tar:
            for nom in noms:
                tar.add(os.path.join(dossier, nom), arcname="./" + nom,
                        filter=_entree_archivable)
    return produire


def _demenager_vers_compte_dedie(esp, session):
    """Première ouverture sous compte dédié : les données de l'Espace le suivent.

    Sans cela, l'Espace s'ouvrirait VIDE, et l'utilisateur croirait avoir tout
    perdu — ses documents, son profil de navigateur, ses téléchargements.

    Ce que ce déménagement garantit :
    · root ne lit rien : le BUREAU emballe ce qu'il a le droit de lire, et
      l'ESPACE déballe chez lui, par un tuyau (voir codebyr-espace-init) ;
      tarfile ne suit pas les liens : un lien posé dans l'Espace part comme
      lien, jamais comme le fichier qu'il désigne ;
    · il COPIE, n'efface rien : les anciennes données restent en place, et
      retirer le réglage « compte » les fait revenir, à jour (voir
      _rapatrier_depuis_compte_dedie) ;
    · il ne se fait qu'une fois, et un échec empêche l'ouverture — un Espace
      qui s'ouvrirait vide après un déménagement raté serait le pire résultat.

    Renvoie True si l'Espace peut s'ouvrir.
    """
    ancien = os.path.join(DATA_ROOT, esp["id"], "home")
    if os.path.exists(_marqueur_demenagement(esp["id"])):
        return True
    try:
        noms = sorted(os.listdir(ancien))
    except FileNotFoundError:
        return True                 # Espace jamais ouvert : rien à emporter
    if not noms:
        return True
    taille = _taille_sans_suivre(ancien)
    libre = shutil.disk_usage(os.path.dirname(os.path.dirname(session.home))).free
    if libre < taille + MARGE_DEMENAGEMENT:
        sys.stderr.write("codebyr-space : place insuffisante pour déménager %s "
                         "(%d Mo à copier, %d Mo libres).\n"
                         % (esp["nom"], taille // 2**20, libre // 2**20))
        return False
    _prevenir("Espace %s : déménagement de ses données" % esp["nom"],
              "Première ouverture sous son propre compte : ses fichiers le "
              "suivent. Rien n'est effacé. Cela peut prendre un moment.")
    code, erreurs = _ordre_interne(session, INTERNE_IMPORTER,
                                   produire=_emballer(ancien, noms))
    if code == MIGRATION_FAITE:
        erreurs = []                # l'Espace avait déjà reçu ses données
    elif code != 0 or erreurs:
        sys.stderr.write("codebyr-space : déménagement de %s interrompu (%s) — "
                         "les données sont intactes à leur ancien emplacement.\n"
                         % (esp["nom"], "; ".join(erreurs) or "code %s" % code))
        journal("Espace %s : déménagement vers le compte dédié échoué" % esp["id"])
        return False
    with fichiers_surs.ouvrir(_marqueur_demenagement(esp["id"]), "w", encoding="utf-8") as f:
        json.dump({"compte": session.compte, "date": time.strftime("%Y-%m-%d %H:%M:%S")}, f)
    journal("Espace %s : données déménagées vers son compte dédié" % esp["id"])
    return True


def _rapatrier_depuis_compte_dedie(esp):
    """Le réglage « compte » a été retiré : les données reviennent, à jour.

    Les anciennes données étaient restées en place, mais figées au jour du
    déménagement. Rouvrir l'Espace dessus ferait disparaître, sans un mot, tout
    ce qui a été fait depuis sous son compte. On rapatrie donc d'abord ce que
    l'Espace détient — c'est lui qui emballe, le bureau qui déballe, selon la
    règle des données d'Espace — et l'état figé est mis de côté, pas effacé.

    Sans le service des comptes, impossible de demander ses données à l'Espace :
    l'ouverture est refusée plutôt que de montrer l'état figé comme s'il était
    le bon. Renvoie True si l'Espace peut s'ouvrir.
    """
    if not os.path.exists(_marqueur_demenagement(esp["id"])):
        return True
    try:
        session = _session_pour_un_geste(esp)
    except compte_dedie.Indisponible as exc:
        sys.stderr.write("codebyr-space : les données récentes de %s sont restées "
                         "dans son compte dédié, et %s.\n" % (esp["nom"], exc))
        return False
    parent = os.path.join(DATA_ROOT, esp["id"])
    home = os.path.join(parent, "home")
    sauvegarde = None
    try:
        with tempfile.TemporaryDirectory(prefix=".retour-", dir=parent) as stage:
            neuf = os.path.join(stage, "home")
            os.mkdir(neuf, 0o700)

            def deballer(flux):
                with tarfile.open(fileobj=flux, mode="r|") as tar:
                    _extraire_archive(tar, neuf, _filtre_dossier_d_espace)

            code, erreurs = _ordre_interne(session, INTERNE_EXPORTER, consommer=deballer)
            if code != 0 or erreurs:
                raise ValueError("; ".join(erreurs) or "export refusé (code %s)" % code)
            with fichiers_surs.dossier(parent):
                if os.path.lexists(home):
                    if os.path.islink(home):
                        raise ValueError("Dossier personnel symbolique refusé")
                    sauvegarde = tempfile.mkdtemp(prefix="avant-retour-", dir=parent)
                    os.rmdir(sauvegarde)
                    os.rename(home, sauvegarde)
                try:
                    os.rename(neuf, home)
                except OSError:
                    if sauvegarde:
                        os.rename(sauvegarde, home)
                    raise
        code, erreurs = _ordre_interne(session, INTERNE_RENDU)
        if code != 0:
            raise ValueError("l'Espace n'a pas pu noter le retour de ses données")
        os.unlink(_marqueur_demenagement(esp["id"]))
    except (OSError, ValueError) as exc:
        sys.stderr.write("codebyr-space : retour des données de %s interrompu (%s) ; "
                         "rien n'a été effacé.\n" % (esp["nom"], exc))
        return False
    finally:
        session.rendre()
    journal("Espace %s : données revenues de son compte dédié" % esp["id"])
    print("Données de %s revenues de son compte dédié%s." % (
        esp["nom"], " ; état précédent conservé : %s" % sauvegarde if sauvegarde else ""))
    return True


def _geste_dans_l_espace(esp, action, produire=None, consommer=None, args=()):
    """Ouvre l'Espace, fait exécuter un ordre interne, le rend. Renvoie (code, erreurs)."""
    try:
        session = _session_pour_un_geste(esp)
    except compte_dedie.Indisponible as exc:
        return None, [str(exc)]
    try:
        return _ordre_interne(session, action, produire=produire,
                              consommer=consommer, args=args)
    finally:
        session.rendre()


def _exporter_compte_dedie(esp, dest=None):
    """Sauvegarde d'un Espace dédié : c'est lui qui emballe, le bureau compresse.

    Même archive que pour un Espace ordinaire (.tar.gz), donc restaurable de la
    même façon. Écrite d'abord sous un nom provisoire : une sauvegarde
    interrompue ne doit jamais passer pour une sauvegarde complète.
    """
    os.makedirs(BACKUP_DIR, exist_ok=True)
    chemin = dest or os.path.join(
        BACKUP_DIR, "%s-%s.tar.gz" % (esp["id"], time.strftime("%Y%m%d-%H%M")))
    provisoire = chemin + ".partielle"

    def compresser(flux):
        import gzip
        with gzip.open(provisoire, "wb") as gz:
            shutil.copyfileobj(flux, gz)

    code, erreurs = _geste_dans_l_espace(esp, INTERNE_EXPORTER, consommer=compresser)
    if code != 0 or erreurs:
        try:
            os.unlink(provisoire)
        except OSError:
            pass
        sys.stderr.write("codebyr-space : sauvegarde de %s interrompue (%s).\n"
                         % (esp["nom"], "; ".join(erreurs) or "code %s" % code))
        return 1
    os.replace(provisoire, chemin)
    print("Espace %s sauvegardé : %s" % (esp["nom"], chemin))
    return 0


def _restaurer_compte_dedie(espaces, esp, source):
    """Restauration d'un Espace dédié : le bureau lit l'archive, l'Espace remet.

    L'Espace est fermé d'abord, comme pour un Espace ordinaire. L'archive est
    entièrement déballée avant qu'on touche à quoi que ce soit, et l'état
    d'avant est mis de côté dans l'Espace (.codebyr/avant-restauration-…).
    """
    if _espace_courant() == esp["id"]:
        sys.stderr.write("Fermez cet Espace puis restaurez depuis le bureau.\n")
        return 1
    cmd_close(espaces, esp["id"])

    def decompresser(flux):
        import gzip
        with gzip.open(source, "rb") as gz:
            shutil.copyfileobj(gz, flux)

    code, erreurs = _geste_dans_l_espace(esp, INTERNE_RESTAURER, produire=decompresser)
    if code != 0 or erreurs:
        sys.stderr.write("Restauration refusée, anciennes données conservées : %s\n"
                         % ("; ".join(erreurs) or "code %s" % code))
        return 1
    print("Espace %s restauré. L'état précédent est conservé dans l'Espace." % esp["nom"])
    return 0


def _effacer_compte_dedie(espaces, esp):
    """Efface les données d'un Espace dédié, des deux côtés. Renvoie True si fait.

    Chez l'Espace, c'est lui qui efface (voir cmd_interne_effacer). Côté bureau,
    l'état figé du déménagement part aussi : sans cela, la prochaine ouverture
    ferait déménager à nouveau les données qu'on vient d'effacer.
    """
    cmd_close(espaces, esp["id"])
    code, erreurs = _geste_dans_l_espace(esp, INTERNE_EFFACER)
    if code != 0 or erreurs:
        sys.stderr.write("codebyr-space : effacement de %s incomplet (%s).\n"
                         % (esp["nom"], "; ".join(erreurs) or "code %s" % code))
        return False
    shutil.rmtree(os.path.join(DATA_ROOT, esp["id"]), ignore_errors=True)
    return True


def cmd_interne_preparer(brut):
    """Prépare le dossier d'un Espace, depuis l'Espace, sous son propre compte.

    Appelé par le lanceur à travers le premier processus de l'Espace, jamais à
    la main. Refuse de tourner ailleurs que sous un compte d'Espace : sur le
    bureau, il écrirait dans le mauvais dossier.
    """
    import pwd
    compte = pwd.getpwuid(os.getuid())
    if not comptes.decomposer(compte.pw_name):
        sys.stderr.write("codebyr-space : préparation réservée au compte d'un Espace.\n")
        return 2
    try:
        charge = json.loads(brut)
        if not isinstance(charge, dict):
            raise ValueError("charge illisible")
    except ValueError as exc:
        sys.stderr.write("codebyr-space : %s\n" % exc)
        return 2
    # Le dossier du COMPTE, pas celui que l'environnement annonce.
    home = compte.pw_dir
    try:
        # Sa boîte d'arrivée se déduit de son NOM DE COMPTE, que le noyau
        # garantit — pas d'un chemin qu'on lui transmettrait.
        proprietaire, esp_id = comptes.decomposer(compte.pw_name)
        recus = _recueillir_arrivees(home, comptes.chemin_arrivees(proprietaire, esp_id))
        if recus:
            journal("Espace %s : %d fichier(s) recueilli(s)" % (esp_id, recus))
        _preparer_ouverture(home)
        # _preparer_ouverture se tait sur ses échecs, et c'est juste pour un
        # réglage de confort. Mais ces associations sont ce qui ouvre SOUS
        # CLOCHE un fichier venu d'ailleurs : leur absence est une protection
        # perdue. Constaté le 14/09/2026 — elles n'étaient pas posées, et la
        # préparation se disait réussie. On vérifie donc le résultat, pas
        # l'absence d'erreur.
        if types_ouvreur(os.path.join("/usr/share/applications", OUVREUR)) \
                and not _ouvreur_associe(home):
            raise OSError("associations de fichiers non posées dans %s" % home)
        modeles.installer(home)
        if charge.get("firefox"):
            if charge.get("filtre_reseau"):
                _preparer_profil_firefox(home, PORT_FILTRE_INTERNE)
            doms = [d for d in (charge.get("domaines_proteges") or [])
                    if isinstance(d, str) and d]
            _installer_bouclier_pour(home, doms)
    except OSError as exc:
        sys.stderr.write("codebyr-space : préparation du dossier impossible (%s)\n" % exc)
        return 1
    return 0


INTERNE_IMPORTER = "interne-importer"
INTERNE_EXPORTER = "interne-exporter"
# Dans le dossier d'un Espace à compte dédié : ce que Codebyr y tient pour
# lui-même, jamais emporté dans un déménagement ni une sauvegarde.
DOSSIER_INTERNE = ".codebyr"
MIGRATION_FAITE = 3


def _compte_d_espace_courant():
    """Le compte sous lequel on tourne, s'il est celui d'un Espace ; sinon None."""
    import pwd
    import comptes
    compte = pwd.getpwuid(os.getuid())
    return compte if comptes.est_compte_d_espace(compte.pw_name) else None


def cmd_interne_importer():
    """Reçoit sur l'entrée standard les données d'un Espace, et les pose chez lui.

    Exécuté PAR l'Espace, sous son compte : il n'écrit que dans son propre
    dossier, et ce qu'il reçoit passe par la même règle que toute restauration
    (voir _extraire_archive).

    Une seule fois : un second déménagement écraserait ce que l'Espace a fait
    depuis le premier. Code MIGRATION_FAITE si c'est déjà fait. Rien de ce qui
    se trouve déjà là n'est effacé — un nom déjà pris est mis de côté dans
    .codebyr/avant-migration-<date>.
    """
    compte = _compte_d_espace_courant()
    if not compte:
        sys.stderr.write("codebyr-space : réservé au compte d'un Espace.\n")
        return 2
    home = compte.pw_dir
    interne = os.path.join(home, DOSSIER_INTERNE)
    marqueur = os.path.join(interne, "migration.json")
    if os.path.exists(marqueur):
        sys.stderr.write("codebyr-space : données déjà déménagées dans cet Espace.\n")
        return MIGRATION_FAITE
    fichiers_surs.mkdir(interne)
    stage = tempfile.mkdtemp(prefix="import-", dir=interne)
    try:
        with tarfile.open(fileobj=sys.stdin.buffer, mode="r|*") as tar:
            _extraire_archive(tar, stage, _filtre_dossier_d_espace)
        mis_de_cote = os.path.join(interne, "avant-migration-%s" % time.strftime("%Y%m%d-%H%M%S"))
        for nom in sorted(os.listdir(stage)):
            if nom == DOSSIER_INTERNE:
                continue
            cible = os.path.join(home, nom)
            if os.path.lexists(cible):
                os.makedirs(mis_de_cote, mode=0o700, exist_ok=True)
                os.rename(cible, os.path.join(mis_de_cote, nom))
            os.rename(os.path.join(stage, nom), cible)
        with fichiers_surs.ouvrir(marqueur, "w", encoding="utf-8") as f:
            json.dump({"date": time.strftime("%Y-%m-%d %H:%M:%S")}, f)
    except (OSError, tarfile.TarError, ValueError) as exc:
        sys.stderr.write("codebyr-space : déménagement refusé (%s)\n" % exc)
        return 1
    finally:
        shutil.rmtree(stage, ignore_errors=True)
    return 0


INTERNE_RESTAURER = "interne-restaurer"
INTERNE_EFFACER = "interne-effacer"
INTERNE_CONTAGION = "interne-contagion"


def cmd_interne_restaurer():
    """Remplace le contenu de l'Espace par l'archive reçue sur l'entrée standard.

    Exécuté PAR l'Espace. Même garantie que la restauration d'un Espace
    ordinaire : l'archive est entièrement déballée AVANT de toucher à quoi que
    ce soit, et l'état d'avant est mis de côté, pas effacé — dans
    .codebyr/avant-restauration-<date>.
    """
    compte = _compte_d_espace_courant()
    if not compte:
        sys.stderr.write("codebyr-space : réservé au compte d'un Espace.\n")
        return 2
    home = compte.pw_dir
    interne = os.path.join(home, DOSSIER_INTERNE)
    fichiers_surs.mkdir(interne)
    stage = tempfile.mkdtemp(prefix="restauration-", dir=interne)
    try:
        with tarfile.open(fileobj=sys.stdin.buffer, mode="r|*") as tar:
            _extraire_archive(tar, stage, _filtre_dossier_d_espace)
        cote = os.path.join(interne, "avant-restauration-%s" % time.strftime("%Y%m%d-%H%M%S"))
        os.makedirs(cote, mode=0o700)
        mis_de_cote, poses = [], []
        try:
            for nom in sorted(os.listdir(home)):
                if nom != DOSSIER_INTERNE:
                    os.rename(os.path.join(home, nom), os.path.join(cote, nom))
                    mis_de_cote.append(nom)
            for nom in sorted(os.listdir(stage)):
                if nom != DOSSIER_INTERNE:
                    os.rename(os.path.join(stage, nom), os.path.join(home, nom))
                    poses.append(nom)
        except OSError:
            # Remettre ce qu'on a déjà bougé : un Espace à moitié restauré
            # serait pire que pas restauré du tout.
            for nom in reversed(poses):
                os.rename(os.path.join(home, nom), os.path.join(stage, nom))
            for nom in reversed(mis_de_cote):
                os.rename(os.path.join(cote, nom), os.path.join(home, nom))
            raise
    except (OSError, tarfile.TarError, ValueError) as exc:
        sys.stderr.write("codebyr-space : restauration refusée, données conservées (%s)\n" % exc)
        return 1
    finally:
        shutil.rmtree(stage, ignore_errors=True)
    sys.stdout.write(cote + "\n")
    return 0


def cmd_interne_effacer():
    """Efface les données de l'Espace, et ses deux boîtes. Exécuté PAR l'Espace.

    C'est l'Espace qui efface chez lui : root n'a pas à parcourir un dossier
    qu'un Espace compromis aurait pu garnir de liens. Les boîtes sont vidées
    aussi — un fichier en route est une donnée de l'Espace comme une autre.
    """
    compte = _compte_d_espace_courant()
    if not compte:
        sys.stderr.write("codebyr-space : réservé au compte d'un Espace.\n")
        return 2
    proprietaire, esp_id = comptes.decomposer(compte.pw_name)
    restes = []
    for dossier in (compte.pw_dir, comptes.chemin_envois(proprietaire, esp_id),
                    comptes.chemin_arrivees(proprietaire, esp_id)):
        try:
            noms = os.listdir(dossier)
        except FileNotFoundError:
            continue
        for nom in noms:
            chemin = os.path.join(dossier, nom)
            try:
                if os.path.isdir(chemin) and not os.path.islink(chemin):
                    shutil.rmtree(chemin)
                else:
                    os.unlink(chemin)
            except OSError as exc:
                restes.append("%s (%s)" % (nom, exc))
    if restes:
        sys.stderr.write("codebyr-space : non effacé : %s\n" % "; ".join(restes[:5]))
        return 1
    return 0


def cmd_interne_contagion():
    """Écrit, en JSON, la provenance de chaque fichier de l'Espace. Exécuté PAR lui.

    Seul l'attribut étendu compte ici : c'est lui qui a suivi un fichier venu
    d'ailleurs. L'emplacement ne dit rien, puisque tout est chez l'Espace.
    """
    compte = _compte_d_espace_courant()
    if not compte:
        sys.stderr.write("codebyr-space : réservé au compte d'un Espace.\n")
        return 2
    origines = []
    total = 0
    for dossier, sous, fichiers in os.walk(compte.pw_dir):
        if dossier == compte.pw_dir and DOSSIER_INTERNE in sous:
            sous.remove(DOSSIER_INTERNE)
        for nom in fichiers:
            total += 1
            origines.append(provenance.origine(os.path.join(dossier, nom)))
    json.dump({"total": total, "origines": origines}, sys.stdout)
    return 0


INTERNE_RENDU = "interne-rendu"


def cmd_interne_rendu():
    """L'Espace oublie qu'il a reçu un déménagement : ses données sont reparties.

    Sans cela, réactiver le compte dédié plus tard ferait répondre « déjà
    déménagé » à l'Espace, et tout ce que l'utilisateur aurait fait entre-temps
    sous le compte du bureau serait ignoré, sans un mot. Le marqueur est mis de
    côté, pas effacé.
    """
    compte = _compte_d_espace_courant()
    if not compte:
        sys.stderr.write("codebyr-space : réservé au compte d'un Espace.\n")
        return 2
    marqueur = os.path.join(compte.pw_dir, DOSSIER_INTERNE, "migration.json")
    try:
        if os.path.exists(marqueur):
            os.rename(marqueur, marqueur.replace(
                "migration.json", "migration-rendue-%s.json" % time.strftime("%Y%m%d-%H%M%S")))
    except OSError as exc:
        sys.stderr.write("codebyr-space : %s\n" % exc)
        return 1
    return 0


def cmd_interne_exporter():
    """Écrit sur la sortie standard les données de l'Espace, en archive.

    Exécuté PAR l'Espace : il ne peut emporter que ce que son compte peut lire.
    Le dossier interne de Codebyr reste là où il est.
    """
    compte = _compte_d_espace_courant()
    if not compte:
        sys.stderr.write("codebyr-space : réservé au compte d'un Espace.\n")
        return 2
    home = compte.pw_dir
    try:
        with tarfile.open(fileobj=sys.stdout.buffer, mode="w|") as tar:
            for nom in sorted(os.listdir(home)):
                if nom == DOSSIER_INTERNE:
                    continue
                tar.add(os.path.join(home, nom), arcname="./" + nom,
                        filter=_entree_archivable)
    except (OSError, tarfile.TarError) as exc:
        sys.stderr.write("codebyr-space : export refusé (%s)\n" % exc)
        return 1
    return 0


def _rundir():
    return os.path.join(
        os.environ.get("XDG_RUNTIME_DIR") or "/run/user/%d" % os.getuid(), "codebyr")


def _naissance_processus(pid):
    if pid <= 1:
        return None
    try:
        with open("/proc/%d/stat" % pid, encoding="utf-8") as f:
            return f.read().rsplit(")", 1)[1].split()[19]
    except (OSError, IndexError):
        return None


def _marqueur_actuel(pid, rundir):
    try:
        with fichiers_surs.ouvrir(os.path.join(rundir, "birth-%d" % pid), encoding="ascii") as f:
            attendu = f.read(128).strip()
        return bool(attendu) and attendu == _naissance_processus(pid)
    except OSError:
        return False


def _nettoyer_marqueurs():
    """Retire les marqueurs « pid-N » dont le processus n'existe plus.

    Un processus tué brutalement laissait le sien derrière lui, et l'extension
    GNOME pouvait alors attribuer la fenêtre d'un NOUVEAU processus au même
    numéro à l'Espace du défunt — donc afficher le mauvais liseré."""
    if not os.path.isdir("/proc"):
        return
    rundir = _rundir()
    try:
        noms = os.listdir(rundir)
    except OSError:
        return
    for nom in noms:
        if not nom.startswith("pid-"):
            continue
        try:
            pid = int(nom[4:])
        except ValueError:
            continue
        if not _marqueur_actuel(pid, rundir):
            for obsolete in (nom, "birth-%d" % pid):
                try:
                    os.remove(os.path.join(rundir, obsolete))
                except OSError:
                    pass


def cmd_close(espaces, esp_id):
    """Ferme toutes les fenêtres/processus ouverts d'un Espace."""
    esp = espaces.get(esp_id)
    if compte_dedie.demande(esp):
        # Ses processus tournent sous un autre compte : le bureau n'a pas le
        # droit de leur envoyer un signal, et l'essai échouait sans un mot en
        # annonçant « 0 fenêtre fermée ». C'est au service de refermer.
        try:
            complet = compte_dedie.fermer(esp_id)
        except compte_dedie.Indisponible as exc:
            sys.stderr.write("codebyr-space : %s\n" % exc)
            return 1
        _nettoyer_marqueurs()
        if not complet:
            sys.stderr.write("Espace %s refermé, mais pas entièrement rangé "
                             "(voir « journalctl -t codebyr-uid »).\n" % esp_id)
            journal("Espace %s : fermeture incomplète" % esp_id)
            return 1
        print("Espace %s refermé." % esp_id)
        journal("Espace %s : fermeture (compte dédié)" % esp_id)
        return 0
    rundir = _rundir()
    ferme = 0
    try:
        noms = os.listdir(rundir)
    except OSError:
        noms = []
    for name in noms:
        if not name.startswith("pid-"):
            continue
        path = os.path.join(rundir, name)
        try:
            with open(path, encoding="utf-8") as f:
                eid = f.read().strip()
        except OSError:
            continue
        if eid != esp_id:
            continue
        try:
            pid = int(name[4:])
        except ValueError:
            continue
        try:
            # pidfd cible un processus précis, jamais le futur porteur de son PID.
            fd = os.pidfd_open(pid)
            try:
                if not _marqueur_actuel(pid, rundir):
                    continue
                signal.pidfd_send_signal(fd, signal.SIGTERM)
                ferme += 1
            finally:
                os.close(fd)
        except OSError:
            try:
                os.remove(path)
            except OSError:
                pass
    _nettoyer_marqueurs()
    print("Espace %s : %d fenêtre(s) fermée(s)." % (esp_id, ferme))
    journal("Espace %s : fermeture (%d fenêtre(s))" % (esp_id, ferme))
    return 0


def cmd_purge(espaces, esp_id):
    esp = espaces.get(esp_id)
    if not esp:
        sys.stderr.write("Espace inconnu : %s\n" % esp_id)
        return 2
    if compte_dedie.demande(esp):
        if not _effacer_compte_dedie(espaces, esp):
            return 1
        print("Données de l'Espace %s effacées." % esp["nom"])
        journal("Espace %s : données effacées (compte dédié)" % esp_id)
        return 0
    cmd_close(espaces, esp_id)   # on ferme d'abord les fenêtres ouvertes
    d = os.path.join(DATA_ROOT, esp_id)
    if os.path.isdir(d):
        shutil.rmtree(d, ignore_errors=True)
        print("Données de l'Espace %s effacées." % esp["nom"])
        journal("Espace %s : données effacées" % esp_id)
    else:
        print("Rien à effacer pour %s." % esp["nom"])
    return 0


BACKUP_DIR = os.path.expanduser("~/Espaces-Codebyr")


def cmd_export(espaces, esp_id, dest=None):
    """Sauvegarde un Espace dans une archive portable (copiable sur clé USB)."""
    esp = espaces.get(esp_id)
    if not esp:
        sys.stderr.write("Espace inconnu : %s\n" % esp_id)
        return 2
    if compte_dedie.demande(esp):
        return _exporter_compte_dedie(esp, dest)
    home = os.path.join(DATA_ROOT, esp_id, "home")
    if not os.path.isdir(home):
        print("L'Espace %s est vide — rien à sauvegarder." % esp["nom"])
        return 0
    os.makedirs(BACKUP_DIR, exist_ok=True)
    path = dest or os.path.join(
        BACKUP_DIR, "%s-%s.tar.gz" % (esp_id, time.strftime("%Y%m%d-%H%M")))
    with tarfile.open(path, "w:gz") as tar:
        tar.add(home, arcname=".")
    print("Espace %s sauvegardé : %s" % (esp["nom"], path))
    return 0


ARCHIVE_ENTREES_MAX = 100000
ARCHIVE_TAILLE_MAX = 20 * 1024**3


def _filtre_dossier_d_espace(membre, destination):
    """Règle d'extraction pour les données d'un Espace qui changent de compte.

    La règle « data » de tarfile refuse tout lien vers un chemin absolu. Les
    applications en posent pourtant dans un dossier personnel, et un seul
    d'entre eux faisait échouer le déménagement entier : l'Espace ne se serait
    plus ouvert.

    Le lien SYMBOLIQUE est donc accepté quelle que soit sa cible : ce n'est
    qu'un nom, et tarfile refuse ensuite d'écrire À TRAVERS lui (il résout le
    chemin de chaque entrée suivante). Dans le bac à sable, une cible absolue
    se résout dans la vue de l'Espace, jamais sur le système.

    Le lien DUR, lui, reste tenu à l'intérieur : il donne accès au fichier
    lui-même. Une archive produite par un Espace compromis pourrait sinon
    poser, au retour vers le bureau, un lien dur vers la clé SSH de
    l'utilisateur — que l'Espace relirait à sa prochaine ouverture.
    """
    if membre.issym():
        return tarfile.tar_filter(membre, destination)
    return tarfile.data_filter(membre, destination)


def _extraire_archive(tar, destination, filtre="data"):
    """Extrait une archive d'Espace, entrée par entrée, selon UNE règle.

    Partagée par la restauration et par le déménagement vers un compte dédié :
    deux copies de cette règle finiraient par diverger, et c'est précisément
    le genre de règle qu'on ne veut voir diverger nulle part.

    Entrée par entrée plutôt que d'un bloc : cela fonctionne aussi sur un
    FLUX, qu'on ne peut pas relire. Une archive refusée en cours de route
    laisse une extraction partielle — l'appelant extrait donc toujours dans un
    dossier de préparation qu'il jette en cas d'erreur.
    """
    entrees = 0
    taille = 0
    for membre in tar:
        entrees += 1
        taille += membre.size
        if entrees > ARCHIVE_ENTREES_MAX or taille > ARCHIVE_TAILLE_MAX:
            raise ValueError("Archive trop volumineuse (100 000 entrées / 20 Gio maximum)")
        # Les liens sont ACCEPTÉS, les fichiers spéciaux refusés.
        #
        # Refuser tout lien paraissait prudent ; cela rendait la restauration
        # impossible sur un vrai Espace. Un dossier personnel avec un profil
        # Firefox contient des liens symboliques : « Revenir à un instantané »
        # échouait donc toujours, sur une archive produite par Codebyr
        # lui-même. On pouvait sauvegarder, jamais restaurer. Constaté le
        # 12/09/2026 sur une VM.
        #
        # Ce qu'il fallait refuser n'est pas le lien, c'est le lien qui SORT de
        # l'Espace. « filter="data" » s'en charge : chemins absolus, traversées
        # par « .. » et cibles hors destination sont rejetés par tarfile
        # lui-même, et lèvent une erreur que l'on attrape.
        if not (membre.isfile() or membre.isdir() or membre.issym() or membre.islnk()):
            raise ValueError("Archive contenant un fichier spécial")
        tar.extract(membre, destination, filter=filtre)


def _entree_archivable(info):
    """Filtre d'archivage : les fichiers spéciaux ne partent pas.

    Un tube nommé dans un dossier d'Espace ferait refuser l'archive entière à
    l'arrivée, et le déménagement avec : on ne l'emporte pas.
    """
    if info.isfile() or info.isdir() or info.issym() or info.islnk():
        return info
    return None


def cmd_import(espaces, esp_id, source=None):
    """Restaure un Espace depuis une archive (portabilité entre machines)."""
    esp = espaces.get(esp_id)
    if not esp:
        sys.stderr.write("Espace inconnu : %s\n" % esp_id)
        return 2
    if not source:
        cands = sorted(glob.glob(os.path.join(BACKUP_DIR, "%s-*.tar.gz" % esp_id)))
        if not cands:
            print("Aucune sauvegarde trouvée pour %s." % esp["nom"])
            return 1
        source = cands[-1]
    if not os.path.exists(source):
        sys.stderr.write("Archive introuvable : %s\n" % source)
        return 1
    if compte_dedie.demande(esp):
        return _restaurer_compte_dedie(espaces, esp, source)
    # Extraire avant de fermer ou toucher aux données existantes. Le dossier
    # temporaire est un frère du home, inaccessible depuis le bac à sable.
    parent = os.path.join(DATA_ROOT, esp_id)
    fichiers_surs.mkdir(parent)
    home = os.path.join(parent, "home")
    sauvegarde = None
    try:
        with tempfile.TemporaryDirectory(prefix=".restauration-", dir=parent) as stage:
            neuf = os.path.join(stage, "home")
            os.mkdir(neuf, 0o700)
            with tarfile.open(source, "r:gz") as tar:
                _extraire_archive(tar, neuf)
            cmd_close(espaces, esp_id)
            # Ne pas remplacer le dossier d'un Espace encore en activité.
            if _espace_courant() == esp_id:
                raise ValueError("Fermez cet Espace puis restaurez depuis le bureau")
            with fichiers_surs.dossier(parent):
                if os.path.lexists(home):
                    if os.path.islink(home):
                        raise ValueError("Dossier personnel symbolique refusé")
                    sauvegarde = tempfile.mkdtemp(prefix="avant-restauration-", dir=parent)
                    os.rmdir(sauvegarde)
                    os.rename(home, sauvegarde)
                try:
                    os.rename(neuf, home)
                except OSError:
                    if sauvegarde:
                        os.rename(sauvegarde, home)
                    raise
        print("Espace %s restauré." % esp["nom"])
        if sauvegarde:
            print("Anciennes données conservées : %s" % sauvegarde)
        return 0
    except (OSError, tarfile.TarError, ValueError) as exc:
        sys.stderr.write("Restauration refusée, anciennes données conservées : %s\n" % exc)
        return 1


FLATHUB_REPO = "/etc/flatpak/remotes.d/flathub.flatpakrepo"
INTERNE_FLATPAK = "interne-flatpak"
# Un identifiant Flatpak : des étiquettes séparées par des points, comme
# org.gnome.Calculator. Vérifié avant d'entrer dans une commande ET avant
# d'entrer dans un chemin — c'est le seul morceau de ces ordres qui vienne
# de l'extérieur.
FORME_APPID = re.compile(r"[A-Za-z0-9][A-Za-z0-9_-]*(\.[A-Za-z0-9][A-Za-z0-9_-]*){1,8}\Z")


def _flatpak_dir_dedie(home):
    """Installation Flatpak d'un Espace à compte dédié, dans son dossier interne.

    Sous « .codebyr » et non sous ~/.local/share : ce dossier est le seul que
    la sauvegarde et le retour au compte du bureau laissent de côté. Des
    centaines de mégaoctets de binaires, retéléchargeables d'un geste, n'ont
    rien à faire dans une archive — c'est déjà le choix fait pour les Espaces
    ordinaires, où l'installation vit à côté du dossier personnel.
    """
    return os.path.join(home, DOSSIER_INTERNE, "flatpak")


def _env_flatpak_dedie(esp, session, env):
    """L'environnement d'une application Flatpak sous compte dédié.

    Construit, jamais hérité : celui du bureau désigne SON dossier d'exécution
    et SON bus de session, auxquels le compte de l'Espace n'a aucun droit.
    L'application les chercherait, ne les trouverait pas, et échouerait sans
    dire pourquoi.

    Le bus est celui de l'Espace (voir codebyr-espace-init) : c'est par lui que
    l'application joint ses portails — « Ouvrir un fichier », l'impression.
    """
    runtime = session.runtime
    return {
        "PATH": "/usr/bin:/bin",
        "LANG": env.get("LANG") or "C.UTF-8",
        "HOME": session.home,
        "XDG_RUNTIME_DIR": runtime,
        "DBUS_SESSION_BUS_ADDRESS": "unix:path=" + os.path.join(runtime, "bus"),
        "WAYLAND_DISPLAY": os.path.basename(env.get("WAYLAND_DISPLAY") or "wayland-0"),
        "XDG_SESSION_TYPE": "wayland",
        "XDG_CURRENT_DESKTOP": "GNOME",
        "GDK_BACKEND": "wayland",
        "FLATPAK_USER_DIR": _flatpak_dir_dedie(session.home),
        "CODEBYR_ESPACE": esp["id"],
        "CODEBYR_ESPACE_COULEUR": esp.get("couleur", "#888888"),
    }


def _espace_flatpak_dir(esp_id):
    """Répertoire d'installation Flatpak DÉDIÉ à un Espace (binaires isolés)."""
    return os.path.join(DATA_ROOT, esp_id, "flatpak")


def _flatpak_env(esp_id):
    """Environnement pointant l'installation Flatpak propre à l'Espace."""
    d = _espace_flatpak_dir(esp_id)
    os.makedirs(d, exist_ok=True)
    env = dict(os.environ)
    env["FLATPAK_USER_DIR"] = d
    return env, d


def _flatpak_app_dans_espace(esp_id, appid):
    """L'application est-elle installée DANS l'Espace (et non au niveau système) ?"""
    return os.path.isdir(os.path.join(_espace_flatpak_dir(esp_id), "app", appid))


def _assurer_flathub(env):
    """Ajoute le dépôt Flathub à l'installation de l'Espace (fichier local → hors-ligne OK)."""
    src = FLATHUB_REPO if os.path.exists(FLATHUB_REPO) else \
        "https://flathub.org/repo/flathub.flatpakrepo"
    subprocess.run(["flatpak", "--user", "remote-add", "--if-not-exists", "flathub", src],
                   env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def _flatpak_nom_lisible(env, appid):
    try:
        out = subprocess.check_output(
            ["flatpak", "--user", "list", "--app", "--columns=application,name"],
            env=env, text=True, stderr=subprocess.DEVNULL)
    except (subprocess.CalledProcessError, OSError):
        return None
    for line in out.splitlines():
        parts = line.split("\t")
        if len(parts) >= 2 and parts[0] == appid:
            return parts[1].strip()
    return None


def _enregistrer_app(esp_id, nom, cmd):
    """Ajoute l'application au menu de CET Espace (personnalisation utilisateur)."""
    esp = registre.espaces().get(esp_id) or {}
    apps = list(esp.get("apps") or [])
    if not any(a.get("cmd") == cmd for a in apps):
        apps.append({"nom": nom, "cmd": cmd})
    registre.modifier_espace(esp_id, {"apps": apps})


def cmd_interne_flatpak(args):
    """Installe, désinstalle ou liste — DANS l'Espace, et par lui.

    Exécuté sous le compte de l'Espace : c'est lui qui télécharge, chez lui,
    dans un dossier où le bureau n'a aucun droit. Root n'y est pour rien : il
    n'a lancé que le premier processus de l'Espace, qui exécute ceci.

    Sur la sortie standard, une seule ligne, que le bureau lit. Tout le reste
    — progression, plaintes de flatpak — part sur l'erreur standard.
    """
    compte = _compte_d_espace_courant()
    if not compte:
        sys.stderr.write("codebyr-space : réservé au compte d'un Espace.\n")
        return 2
    geste = args[0] if args else ""
    appid = args[1] if len(args) > 1 else ""
    if geste not in ("installer", "desinstaller", "liste") or (
            geste != "liste" and not FORME_APPID.match(appid)):
        sys.stderr.write("codebyr-space : ordre Flatpak mal formé.\n")
        return 2
    if not shutil.which("flatpak"):
        sys.stderr.write("Flatpak n'est pas installé.\n")
        return 2
    dossier = _flatpak_dir_dedie(compte.pw_dir)
    os.makedirs(dossier, mode=0o700, exist_ok=True)
    env = {"PATH": "/usr/bin:/bin", "LANG": os.environ.get("LANG", "C.UTF-8"),
           "HOME": compte.pw_dir, "FLATPAK_USER_DIR": dossier,
           # Flatpak monte un bac à sable pour ses propres besoins, et le fait
           # sous le dossier d'exécution : sans lui à la place attendue, il
           # échoue (mesuré le 15/09/2026).
           "XDG_RUNTIME_DIR": "/run/user/%d" % os.getuid()}
    if geste == "liste":
        r = subprocess.run(["flatpak", "--user", "list", "--app",
                            "--columns=application,name"],
                           env=env, capture_output=True, text=True)
        sys.stdout.write(r.stdout)
        return r.returncode
    if geste == "installer":
        _assurer_flathub(env)
        code = subprocess.call(["flatpak", "--user", "install", "-y", "flathub", appid],
                               env=env, stdin=subprocess.DEVNULL, stdout=sys.stderr)
        if code == 0:
            print(_flatpak_nom_lisible(env, appid) or appid)
        return code
    return subprocess.call(["flatpak", "--user", "uninstall", "-y", appid],
                           env=env, stdin=subprocess.DEVNULL, stdout=sys.stderr)


def _flatpak_dans_l_espace(esp, geste, appid):
    """Fait faire le geste Flatpak par l'Espace. Renvoie (code, nom lu)."""
    if not FORME_APPID.match(appid or ""):
        sys.stderr.write("Identifiant d'application invalide : %s\n" % appid)
        return 2, ""
    recu = []
    code, erreurs = _geste_dans_l_espace(
        esp, INTERNE_FLATPAK, args=(geste, appid),
        consommer=lambda flux: recu.append(flux.read()))
    if code != 0 or erreurs:
        sys.stderr.write("codebyr-space : %s de %s dans l'Espace %s a échoué (%s).\n"
                         % (geste, appid, esp["nom"],
                            "; ".join(erreurs) or "code %s" % code))
        return 1, ""
    lignes = (recu[0].decode("utf-8", "replace").strip().splitlines()
              if recu and recu[0] else [])
    return 0, (lignes[-1].strip() if lignes else "")


def cmd_install(esp_id, appid):
    """Installe une application Flatpak DANS un Espace (isolée : binaires + données)."""
    espaces = load_espaces()
    esp = espaces.get(esp_id)
    if not esp:
        sys.stderr.write("Espace inconnu : %s\n" % esp_id)
        return 2
    if not shutil.which("flatpak"):
        sys.stderr.write("Flatpak n'est pas installé.\n")
        return 2
    if compte_dedie.demande(esp):
        # L'installation se fait DANS l'Espace : son dossier n'appartient plus
        # au bureau, qui ne peut ni y écrire, ni savoir ce qui s'y trouve.
        print("Installation de %s dans l'Espace %s, sous son compte "
              "(le téléchargement peut être long)..." % (appid, esp["nom"]))
        code, nom = _flatpak_dans_l_espace(esp, "installer", appid)
        if code != 0:
            return code
        nom = nom or appid
        _enregistrer_app(esp_id, nom, "flatpak run " + appid)
        print("« %s » installée dans l'Espace %s." % (nom, esp["nom"]))
        return 0
    env, _ = _flatpak_env(esp_id)
    _assurer_flathub(env)
    print("Installation de « %s » dans l'Espace %s…" % (appid, esp["nom"]))
    rc = subprocess.call(["flatpak", "--user", "install", "-y", "flathub", appid], env=env)
    if rc != 0:
        sys.stderr.write("Échec de l'installation de %s.\n" % appid)
        return rc
    nom = _flatpak_nom_lisible(env, appid) or appid
    _enregistrer_app(esp_id, nom, "flatpak run " + appid)
    print("« %s » installée dans l'Espace %s." % (nom, esp["nom"]))
    return 0


def cmd_add_app(esp_id, nom, fichier, extra):
    """Ajoute un programme LOCAL (binaire téléchargé, script…) au menu d'un Espace.
    Gère la correspondance des chemins entre l'hôte et le bac à sable."""
    espaces = load_espaces()
    esp = espaces.get(esp_id)
    if not esp:
        sys.stderr.write("Espace inconnu : %s\n" % esp_id)
        return 2
    cible = os.path.abspath(os.path.expanduser(fichier))
    esp_home = os.path.join(DATA_ROOT, esp_id, "home")
    if os.path.isfile(cible):
        try:
            os.chmod(cible, 0o755)  # rendre exécutable
        except OSError:
            pass
        # Chemin tel que vu DANS le bac à sable (le home de l'Espace est monté sur ~).
        if cible.startswith(esp_home + os.sep):
            rel = os.path.relpath(cible, esp_home)
            prog = os.path.join(os.path.expanduser("~"), rel)
        else:
            prog = cible  # hors home de l'Espace (ex. /usr, /opt en lecture seule)
    else:
        prog = fichier  # commande du PATH (ex. « gimp »)
    # La commande stockée est réinterprétée comme une ligne shell au lancement :
    # on protège le chemin (et les arguments) par des quotes, sans quoi un dossier
    # contenant une espace (« Antigravity IDE ») casse le lancement.
    cmd = shlex.quote(prog)
    if extra:
        cmd += " " + " ".join(shlex.quote(a) for a in extra)
    _enregistrer_app(esp_id, nom, cmd)
    print("« %s » ajoutée au menu de l'Espace %s." % (nom, esp["nom"]))
    print("  Commande : %s" % cmd)
    return 0


def cmd_apps(esp_id):
    """Liste les applications installées dans un Espace."""
    espaces = load_espaces()
    esp = espaces.get(esp_id)
    if not esp:
        sys.stderr.write("Espace inconnu : %s\n" % esp_id)
        return 2
    env, _ = _flatpak_env(esp_id)
    print("Applications de l'Espace %s :" % esp["nom"])
    subprocess.call(["flatpak", "--user", "list", "--app",
                     "--columns=application,name,version"], env=env)
    return 0


def cmd_remove_app(esp_id, appid):
    """Désinstalle une application d'un Espace et la retire de son menu."""
    espaces = load_espaces()
    esp = espaces.get(esp_id)
    if not esp:
        sys.stderr.write("Espace inconnu : %s\n" % esp_id)
        return 2
    if compte_dedie.demande(esp):
        rc, _ = _flatpak_dans_l_espace(esp, "desinstaller", appid)
    else:
        env, _ = _flatpak_env(esp_id)
        rc = subprocess.call(["flatpak", "--user", "uninstall", "-y", appid], env=env)
    apps = [a for a in (esp.get("apps") or [])
            if a.get("cmd") != "flatpak run " + appid]
    registre.modifier_espace(esp_id, {"apps": apps})
    print("« %s » retirée de l'Espace %s." % (appid, esp["nom"]))
    return rc


def cmd_create(nom, couleur):
    """Crée un Espace personnalisé (persistant), écrit dans le registre utilisateur."""
    nom = nom.strip()
    if not nom:
        sys.stderr.write("Nom d'Espace vide.\n")
        return 2
    if not couleur.startswith("#"):
        couleur = "#" + couleur
    # La couleur finit dans les feuilles de style du bureau (liseré, menu du
    # Sceau). L'extension la vérifie aussi en lisant le registre, mais un
    # registre ne doit pas contenir ce qu'on refuserait d'y lire.
    # fullmatch, et non match avec « $ » : « $ » tolère un saut de ligne final.
    if not re.fullmatch(r"#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})", couleur):
        sys.stderr.write("Couleur invalide : %r (attendu : #RRGGBB).\n" % couleur)
        return 2
    base = unicodedata.normalize("NFKD", nom).encode("ascii", "ignore").decode().lower()
    base = re.sub(r"[^a-z0-9]+", "-", base).strip("-") or "espace"
    esp_id = registre.identifiant_libre(base)
    registre.ajouter_espace({
        "id": esp_id, "nom": nom, "couleur": couleur,
        "app": "org.gnome.Nautilus.desktop", "ephemere": False,
    })
    print("Espace « %s » créé (%s)." % (nom, couleur))
    return 0


def cmd_delete(esp_id):
    """Supprime un Espace personnalisé. Les Espaces livrés par le système ne
    sont pas supprimables — on interroge le registre système plutôt qu'une
    liste codée en dur, qui aurait fini par diverger de son contenu."""
    if registre.est_systeme(esp_id):
        sys.stderr.write("L'Espace intégré « %s » ne peut pas être supprimé.\n" % esp_id)
        return 2
    espaces = load_espaces()
    esp = espaces.get(esp_id)
    if compte_dedie.demande(esp):
        # Ses données d'abord, effacées par lui ; puis son compte, retiré par
        # le service. Dans l'autre ordre, un compte supprimé laisserait des
        # fichiers sans propriétaire, que le prochain compte créé avec le même
        # numéro retrouverait.
        if not _effacer_compte_dedie(espaces, esp):
            return 1
        try:
            complet = compte_dedie.supprimer(esp_id)
        except compte_dedie.Indisponible as exc:
            sys.stderr.write("codebyr-space : %s\n" % exc)
            return 1
        if not complet:
            sys.stderr.write("Compte de l'Espace %s pas entièrement retiré "
                             "(voir « journalctl -t codebyr-uid »).\n" % esp_id)
            return 1
    cmd_close(espaces, esp_id)
    if not registre.supprimer_espace(esp_id):
        print("Espace introuvable : %s" % esp_id)
        return 1
    d = os.path.join(DATA_ROOT, esp_id)
    if os.path.isdir(d):
        shutil.rmtree(d, ignore_errors=True)
    print("Espace supprimé : %s" % esp_id)
    return 0


def cmd_nettoyer_registre():
    """Réduit vos réglages personnels à ce qui diffère vraiment des défauts.

    Les versions antérieures à la 1.2.0 enregistraient une COPIE INTÉGRALE de
    la configuration. Une valeur recopiée reste une valeur qui gagne : elle
    continue donc de masquer les durcissements livrés ensuite, même après la
    mise à jour. Cette commande fait le ménage une fois pour toutes."""
    avant = registre.couche()
    n_avant = sum(len(e) for e in avant.get("espaces", []) if isinstance(e, dict))
    apres = registre.reduire_couche(dict(avant))
    n_apres = sum(len(e) for e in apres.get("espaces", []) if isinstance(e, dict))
    if n_apres == n_avant:
        print("Vos réglages ne contiennent déjà que des différences. Rien à faire.")
        return 0
    registre.ecrire_couche(avant)
    print("Réglages nettoyés : %d valeur(s) recopiée(s) du système retirée(s)."
          % (n_avant - n_apres))
    print("Vos choix personnels sont intacts ; les valeurs par défaut vous "
          "atteindront de nouveau.")
    journal("Registre utilisateur réduit (%d valeurs retirées)" % (n_avant - n_apres))
    return 0


def _action_launch(espaces, args):
    """launch <espace> [--fichier <f>] [-- commande...]"""
    esp_id, reste = args[0], args[1:]
    fichier = None
    extra = []
    i = 0
    while i < len(reste):
        if reste[i] == "--fichier" and i + 1 < len(reste):
            fichier = reste[i + 1]
            i += 2
        elif reste[i] == "--":
            extra = reste[i + 1:]
            break
        else:
            i += 1
    return cmd_launch(espaces, esp_id, extra, fichier)


# Boîte d'envoi : le seul passage par lequel un fichier sort d'un Espace.
#
# Le bac à sable monte le dossier de l'Espace PAR-DESSUS « ~ ». À l'intérieur,
# DATA_ROOT désigne donc un dossier fantôme du bac à sable, sans rapport avec
# les vrais Espaces. « envoyer » y copiait le fichier et annonçait « Copié » :
# il n'arrivait jamais. Constaté le 24/08/2026.
#
# L'Espace dépose donc dans SA boîte, montée à un chemin fixe ; l'hôte relève
# et distribue. Un Espace n'écrit jamais chez un autre.
ENVOI_INTERNE = os.path.expanduser("~/.codebyr-envoi")


def boite_envoi(esp_id):
    """Boîte d'envoi d'un Espace, vue depuis l'HÔTE."""
    return os.path.join(DATA_ROOT, esp_id, "envoi")


def _boite_de_depart(esp, esp_id):
    """La boîte d'où partent les fichiers d'un Espace, selon son compte.

    Sous compte dédié, elle est hors du dossier du bureau, tenue par root, et
    le bureau peut la relever SANS ouvrir l'Espace (voir comptes.py).
    """
    if compte_dedie.demande(esp):
        return comptes.chemin_envois(os.getuid(), esp_id)
    return boite_envoi(esp_id)


def relever_envois(espaces):
    """Distribue ce que les Espaces ont déposé. Renvoie le nombre remis.

    Appelé depuis l'hôte, au lancement de n'importe quel Espace : c'est le
    moment où l'on va justement chercher ses fichiers, et cela évite un
    service qui tournerait en permanence pour un geste occasionnel.
    """
    remis = 0
    for source in list(espaces):
        try:
            racine = _boite_de_depart(espaces[source], source)
        except ValueError:
            continue            # identifiant qu'un compte dédié ne peut pas porter
        try:
            with fichiers_surs.dossier(racine) as racine_fd:
                destinations = os.listdir(racine_fd)
            for dest in destinations:
                if dest not in espaces or espaces[dest].get("ephemere"):
                    continue
                # Vers un Espace dédié : sa boîte d'arrivée, qu'il recueillera
                # à sa prochaine ouverture. Lisible par lui — le mode est posé
                # sur la copie avant qu'elle ne prenne son nom.
                mode = None
                if compte_dedie.demande(espaces[dest]):
                    try:
                        cible = comptes.chemin_arrivees(os.getuid(), dest)
                    except ValueError:
                        continue
                    if not os.path.isdir(cible):
                        continue    # jamais ouvert sous son compte : ça attend
                    mode = 0o644
                dossier = os.path.join(racine, dest)
                try:
                    with fichiers_surs.dossier(dossier) as source_fd:
                        noms = os.listdir(source_fd)
                        if mode is None:
                            cible = os.path.join(DATA_ROOT, dest, "home", PARTAGE)
                            fichiers_surs.mkdir(cible)
                        for nom in noms:
                            if nom.startswith(".codebyr-"):
                                continue
                            try:
                                # Le descripteur conserve le dossier même si son
                                # nom est remplacé pendant la remise.
                                # ouvrir() refuse /proc/self/fd (liens), donc
                                # copier depuis un fd ouvert relativement ici.
                                entree = os.open(nom, os.O_RDONLY | os.O_NOFOLLOW |
                                                os.O_NONBLOCK, dir_fd=source_fd)
                                try:
                                    import stat
                                    st = os.fstat(entree)
                                    if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
                                        continue
                                    # Copie privée : jamais de déplacement d'un
                                    # chemin fourni par l'Espace vers l'hôte.
                                    with tempfile.TemporaryDirectory(prefix="codebyr-envoi-") as t:
                                        copie = os.path.join(t, "document")
                                        with os.fdopen(os.dup(entree), "rb") as src, open(copie, "wb") as dst:
                                            shutil.copyfileobj(src, dst)
                                        fichiers_surs.copier_unique(copie, cible, nom, source, mode=mode)
                                    actuel = os.stat(nom, dir_fd=source_fd, follow_symlinks=False)
                                    if (actuel.st_dev, actuel.st_ino) == (st.st_dev, st.st_ino):
                                        os.unlink(nom, dir_fd=source_fd)
                                    remis += 1
                                finally:
                                    os.close(entree)
                            except OSError:
                                continue
                except OSError as exc:
                    # Une destination listée mais illisible n'est pas normale :
                    # les fichiers y attendent, et quelqu'un doit pouvoir le
                    # savoir. Ce silence a caché qu'aucun envoi ne partait d'un
                    # Espace à compte dédié (14/09/2026).
                    journal("relève impossible de %s vers %s : %s" % (source, dest, exc))
                    continue
        except OSError:
            continue
    if remis:
        journal("remise de %d fichier(s) entre Espaces" % remis)
    return remis


def _espace_courant():
    """L'Espace depuis lequel cette commande est lancée, ou None.

    Posée par cmd_launch dans l'environnement de chaque Espace : un processus
    qui tourne dedans la voit, un processus du bureau ne la voit pas. C'est
    donc aussi la façon de savoir qu'on est « à l'extérieur ».
    """
    esp_id = os.environ.get("CODEBYR_ESPACE", "").strip()
    return esp_id if provenance.identifiant_valide(esp_id) else None


def nom_libre(dossier, nom, existe=os.path.exists):
    """Un nom qui n'écrase rien : « rapport.pdf » → « rapport (2).pdf ».

    Décision pure (l'accès disque est injectable) parce qu'elle décide d'une
    PERTE DE DONNÉES. Écraser en silence un fichier déjà présent dans un Espace
    serait le pire comportement possible ici : l'utilisateur ne saurait même pas
    qu'il a perdu quelque chose — le geste, lui, a l'air d'avoir réussi.
    """
    if not existe(os.path.join(dossier, nom)):
        return nom
    base, ext = os.path.splitext(nom)
    for n in range(2, 1000):
        candidat = "%s (%d)%s" % (base, n, ext)
        if not existe(os.path.join(dossier, candidat)):
            return candidat
    return None


def _deposer_pour_envoi(esp, depart, source):
    """Dépose un fichier dans la boîte d'envoi, vue de l'INTÉRIEUR d'un Espace."""
    dossier = os.path.join(ENVOI_INTERNE, esp["id"])
    try:
        fichiers_surs.mkdir(dossier)
        # Les droits sont posés EXPLICITEMENT, par le descripteur. Dans la
        # boîte de départ d'un Espace dédié, le droit du bureau est hérité
        # d'une ACL par défaut — mais son masque suit le mode de création :
        # 0700 pour un dossier, 0600 pour une écriture sûre. Le droit existait
        # donc sur le papier, avec « effective: --- » : le bureau ne pouvait
        # rien relever, et rien ne le disait. Reproduit dans le WSL avec deux
        # comptes sans privilège, le 14/09/2026. Sur un objet qui porte une
        # ACL, les bits de groupe SONT le masque ; ailleurs, ces modes ne
        # donnent rien à personne d'autre que le propriétaire.
        with fichiers_surs.dossier(dossier) as fd:
            os.fchmod(fd, 0o770)
    except OSError:
        sys.stderr.write(
            "Boîte d'envoi indisponible : cet Espace a été ouvert par une "
            "version antérieure\nde Codebyr. Fermez-le et rouvrez-le.\n")
        return 1
    try:
        origine = provenance.origine(source, DATA_ROOT) or depart
        fichiers_surs.copier_unique(source, dossier, os.path.basename(source), origine,
                                    mode=0o640)
    except OSError as exc:
        sys.stderr.write("Copie impossible (%s)\n" % exc)
        _prevenir("Envoi impossible",
                  "Le fichier n'a pas pu être remis à %s." % esp["nom"])
        return 1
    journal("dépôt pour l'Espace %s" % esp["id"])
    _prevenir("En route vers %s" % esp["nom"],
              "Le fichier y sera déposé dans « %s » à la prochaine ouverture "
              "de cet Espace." % PARTAGE)
    print("Déposé pour %s — remis à la prochaine ouverture de cet Espace."
          % esp["nom"])
    return 0


def _envoyer_vers_compte_dedie(esp, source):
    """Depuis le bureau, vers un Espace dédié : dans sa boîte d'arrivée.

    Le bureau n'écrit pas chez l'Espace ; il dépose, lisible par lui, et
    l'Espace recopie chez lui à sa prochaine ouverture — sans qu'il faille
    l'ouvrir maintenant.
    """
    try:
        boite = comptes.chemin_arrivees(os.getuid(), esp["id"])
    except ValueError:
        boite = None
    if not boite or not os.path.isdir(boite):
        sys.stderr.write("L'Espace %s n'a pas encore été ouvert sous son propre "
                         "compte : ouvrez-le une première fois.\n" % esp["nom"])
        _prevenir("Envoi impossible pour l'instant",
                  "Ouvrez une première fois l'Espace %s, puis renvoyez le fichier."
                  % esp["nom"])
        return 1
    try:
        origine = provenance.origine(source, DATA_ROOT)
        fichiers_surs.copier_unique(source, boite, os.path.basename(source), origine,
                                    mode=0o644)
    except OSError as exc:
        sys.stderr.write("Copie impossible (%s)\n" % exc)
        _prevenir("Envoi impossible",
                  "Le fichier n'a pas pu être déposé pour %s." % esp["nom"])
        return 1
    journal("envoi vers l'Espace %s" % esp["id"])
    _prevenir("En route vers %s" % esp["nom"],
              "Le fichier sera dans le dossier « %s » à la prochaine ouverture "
              "de cet Espace." % PARTAGE)
    print("Déposé pour %s — dans « %s » à sa prochaine ouverture." % (esp["nom"], PARTAGE))
    return 0


def cmd_envoyer(espaces, esp_id, fichier):
    """Dépose une COPIE d'un fichier dans le sas d'un Espace.

    À ne pas confondre avec « launch --fichier », qui sert à examiner une pièce
    jointe douteuse et impose pour cela le blindage et la coupure réseau.
    Envoyer un document dans Travail est le geste inverse : on classe quelque
    chose dont on ne se méfie pas, et l'Espace doit rester ce qu'il est.

    C'est une COPIE : l'original ne bouge pas. Franchir une frontière entre
    Espaces ne doit jamais faire disparaître ce qu'on avait avant.
    """
    esp = espaces.get(esp_id)
    if not esp:
        sys.stderr.write("Espace inconnu : %s\n" % esp_id)
        return 2
    if esp.get("ephemere"):
        # Le dossier d'un Espace jetable vit en mémoire et disparaît avec lui :
        # y « classer » un document reviendrait à le jeter.
        sys.stderr.write("Un Espace jetable ne conserve rien : utilisez plutôt "
                         "« codebyr-space launch %s --fichier … ».\n" % esp_id)
        return 2
    source = os.path.abspath(os.path.expanduser(fichier))
    if not os.path.isfile(source):
        sys.stderr.write("Fichier introuvable (ou ce n'est pas un fichier) : %s\n"
                         % fichier)
        return 2

    depart = _espace_courant()
    if depart:
        # On est DANS un Espace : le bac à sable rend les autres Espaces
        # inatteignables, et c'est voulu. On dépose donc dans la boîte
        # d'envoi, que l'hôte relèvera. Sans ce chemin, la copie partait dans
        # un dossier fantôme et la commande annonçait un succès imaginaire.
        return _deposer_pour_envoi(esp, depart, source)

    if compte_dedie.demande(esp):
        return _envoyer_vers_compte_dedie(esp, source)

    partage = os.path.join(espace_home(esp), PARTAGE)
    try:
        fichiers_surs.mkdir(partage)
        origine = provenance.origine(source, DATA_ROOT)
        nom = fichiers_surs.copier_unique(source, partage, os.path.basename(source), origine)
    except OSError as exc:
        sys.stderr.write("Copie impossible (%s)\n" % exc)
        _prevenir("Envoi impossible",
                  "Le fichier n'a pas pu être copié dans %s." % esp["nom"])
        return 1

    # Le journal note l'Espace et l'action, jamais le nom du fichier.
    journal("envoi vers l'Espace %s" % esp["id"])
    _prevenir("Envoyé dans %s" % esp["nom"],
              "Le fichier vous attend dans le dossier « %s » de cet Espace."
              % PARTAGE)
    print("Copié dans %s → %s/%s" % (esp["nom"], PARTAGE, nom))
    return 0


def cmd_provenance(espaces, chemin):
    """Dit d'où vient un fichier, et si l'ouvrir ici mérite une cloche."""
    cible = os.path.abspath(os.path.expanduser(chemin))
    if not os.path.exists(cible):
        sys.stderr.write("Fichier introuvable : %s\n" % chemin)
        return 2
    venue = provenance.origine(cible, DATA_ROOT)
    if not venue:
        print("Origine inconnue — ce fichier n'a jamais transité par un Espace,"
              "\nou il a perdu sa marque (clé USB, pièce jointe, partage réseau).")
        return 0
    esp = espaces.get(venue)
    print("Vient de l'Espace : %s" % (esp["nom"] if esp else venue))
    courant = _espace_courant()
    if courant and provenance.doit_isoler(venue, courant):
        ici = espaces.get(courant)
        print("Vous êtes dans %s : l'ouvrir ici ferait franchir une frontière."
              % (ici["nom"] if ici else courant))
    return 0


def decider_ouverture(origine, espace_courant):
    """« jetable » ou « normale ». Décision pure, pour être testable.

    Un fichier venu d'un AUTRE Espace s'ouvre sous cloche : blindé, sans
    réseau, détruit à la fermeture. C'est le seul moment où la marque sert
    vraiment à quelque chose — jusqu'ici elle informait, elle protège.

    Le doute profite à l'ouverture normale. Un fichier sans origine connue, ou
    déjà chez lui, s'ouvre comme d'habitude : refuser d'ouvrir des documents
    ordinaires ferait désactiver la fonction dès la première semaine, et une
    protection désactivée ne protège personne.
    """
    return "jetable" if provenance.doit_isoler(origine, espace_courant) else "normale"


def cmd_ouvrir(espaces, chemin, lanceur=None):
    """Ouvre un fichier, sous cloche s'il vient d'un autre Espace.

    Destiné à être le gestionnaire par défaut DANS les Espaces : c'est là que
    la question se pose, puisqu'on y sait où l'on est. Sur le bureau, il n'y a
    pas d'« ici », donc rien à franchir — voir provenance.doit_isoler.
    """
    cible = os.path.abspath(os.path.expanduser(chemin))
    if not os.path.isfile(cible):
        sys.stderr.write("Fichier introuvable : %s\n" % chemin)
        return 2

    courant = _espace_courant()
    venue = provenance.origine(cible, DATA_ROOT)
    choix = decider_ouverture(venue, courant)

    if lanceur is None:
        def lanceur(argv):
            subprocess.Popen(argv, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL)

    if choix == "jetable":
        autre = espaces.get(venue)
        journal("ouverture sous cloche d'un fichier venu de %s" % venue)
        _prevenir("Ouvert sous cloche",
                  "Ce fichier vient de l'Espace %s. Il s'ouvre isolé et sans "
                  "réseau, et disparaîtra à la fermeture."
                  % (autre["nom"] if autre else venue))
        try:
            lanceur(["/usr/bin/codebyr-jetable", cible])
        except OSError as exc:
            # Échouer ici empêcherait d'ouvrir un document parfaitement
            # légitime. On le dit, et on ouvre normalement.
            sys.stderr.write("codebyr-space : Jetable indisponible (%s)\n" % exc)
            _prevenir("Ouverture refusée", "Le Jetable est indisponible. Le fichier reste fermé.")
            return 1

    if choix == "normale":
        try:
            lanceur(_visionneuse_pour(cible) + [cible])
        except OSError as exc:
            sys.stderr.write("codebyr-space : ouverture impossible (%s)\n" % exc)
            return 1
    return 0


def cmd_adopter(espaces, chemin):
    """Après examen : ce fichier appartient désormais à l'Espace courant."""
    cible = os.path.abspath(os.path.expanduser(chemin))
    if not os.path.isfile(cible):
        sys.stderr.write("Fichier introuvable : %s\n" % chemin)
        return 2
    courant = _espace_courant()
    if not courant:
        sys.stderr.write(
            "Adopter n'a de sens que DANS un Espace : c'est là qu'un fichier "
            "peut appartenir\nà quelque part. Lancez cette commande depuis "
            "l'Espace où vous voulez le garder.\n")
        return 2
    venue = provenance.origine(cible, DATA_ROOT)
    if not provenance.doit_isoler(venue, courant):
        print("Ce fichier est déjà chez lui : rien à faire.")
        return 0
    if not provenance.adopter(cible, courant):
        sys.stderr.write("Marque impossible à écrire (système de fichiers "
                         "sans attributs étendus ?).\n")
        return 1
    esp = espaces.get(courant)
    journal("adoption d'un fichier venu de %s dans %s" % (venue, courant))
    print("Adopté dans %s : ce fichier s'ouvrira désormais normalement ici."
          % (esp["nom"] if esp else courant))
    print("(Il redeviendra étranger si vous l'envoyez vers un autre Espace.)")
    return 0


def cmd_contagion(espaces, esp_id):
    """Compte, dans un Espace, les fichiers venus d'ailleurs.

    Montrer la contagion plutôt que la supposer absente : c'est le même parti
    pris que « verifier-isolation », appliqué aux fichiers. Un chiffre nul est
    une information ; un chiffre élevé aussi.
    """
    esp = espaces.get(esp_id)
    if not esp:
        sys.stderr.write("Espace inconnu : %s\n" % esp_id)
        return 2
    origines = []
    total = 0
    if compte_dedie.demande(esp):
        # Le bureau ne lit pas chez un Espace dédié : c'est lui qui relève la
        # provenance de ses fichiers, et le bureau qui fait le compte.
        lu = []
        code, erreurs = _geste_dans_l_espace(esp, INTERNE_CONTAGION,
                                             consommer=lambda flux: lu.append(json.load(flux)))
        if code != 0 or erreurs or not lu or not isinstance(lu[0], dict):
            sys.stderr.write("codebyr-space : analyse impossible (%s)\n"
                             % ("; ".join(erreurs) or "code %s" % code))
            return 1
        total = int(lu[0].get("total", 0))
        origines = [o for o in lu[0].get("origines", [])
                    if o is None or provenance.identifiant_valide(o)]
    else:
        racine = os.path.join(DATA_ROOT, esp_id, "home")
        for dossier, _, fichiers in os.walk(racine):
            for nom in fichiers:
                total += 1
                origines.append(provenance.origine(os.path.join(dossier, nom), DATA_ROOT))
    compte = provenance.resumer(origines, esp_id)
    print("Espace %s — %d fichier(s) au total." % (esp["nom"], total))
    if not compte:
        print("Aucun fichier venu d'un autre Espace.")
        return 0
    for venue, combien in sorted(compte.items(), key=lambda c: -c[1]):
        autre = espaces.get(venue)
        print("  %3d venu(s) de %s" % (combien, autre["nom"] if autre else venue))
    print("\nCes fichiers ont franchi une frontière. Pour en examiner un sous "
          "cloche :\n  codebyr-space launch %s --fichier <chemin>" % esp_id)
    return 0


# Table des actions : (nombre minimal d'arguments, usage, fonction).
# Une seule source de vérité — l'ancienne cascade de « if » laissait le message
# d'usage et le nombre d'arguments dériver l'un de l'autre à chaque ajout.
ACTIONS = {
    "list":       (0, "list", lambda espaces, a: cmd_list(espaces) or 0),
    "isolation":  (0, "isolation", lambda espaces, a: bac_a_sable.cmd_isolation()),
    "verifier-isolation": (0, "verifier-isolation",
                           lambda espaces, a: bac_a_sable.cmd_verifier_isolation()),
    "verifier-poste": (0, "verifier-poste",
                       lambda espaces, a: autotest.cmd_verifier_poste()),
    "envoyer":    (2, "envoyer <espace> <fichier>",
                   lambda espaces, a: cmd_envoyer(espaces, a[0], a[1])),
    "provenance": (1, "provenance <fichier>",
                   lambda espaces, a: cmd_provenance(espaces, a[0])),
    "ouvrir":     (1, "ouvrir <fichier>",
                   lambda espaces, a: cmd_ouvrir(espaces, a[0])),
    "adopter":    (1, "adopter <fichier>",
                   lambda espaces, a: cmd_adopter(espaces, a[0])),
    "contagion":  (1, "contagion <espace>",
                   lambda espaces, a: cmd_contagion(espaces, a[0])),
    "nettoyer-registre": (0, "nettoyer-registre",
                          lambda espaces, a: cmd_nettoyer_registre()),
    "launch":     (1, "launch <espace> [--fichier <f>] [-- commande...]",
                   _action_launch),
    "close":      (1, "close <espace>",
                   lambda espaces, a: cmd_close(espaces, a[0])),
    "purge":      (1, "purge <espace>",
                   lambda espaces, a: cmd_purge(espaces, a[0])),
    "export":     (1, "export <espace> [fichier]",
                   lambda espaces, a: cmd_export(espaces, a[0],
                                                 a[1] if len(a) > 1 else None)),
    "import":     (1, "import <espace> [fichier]",
                   lambda espaces, a: cmd_import(espaces, a[0],
                                                 a[1] if len(a) > 1 else None)),
    "create":     (2, "create <nom> <couleur>",
                   lambda espaces, a: cmd_create(a[0], a[1])),
    "delete":     (1, "delete <espace>", lambda espaces, a: cmd_delete(a[0])),
    "install":    (2, "install <espace> <app-id-flatpak>",
                   lambda espaces, a: cmd_install(a[0], a[1])),
    "apps":       (1, "apps <espace>", lambda espaces, a: cmd_apps(a[0])),
    "add-app":    (3, "add-app <espace> <nom> <fichier|commande> [args...]",
                   lambda espaces, a: cmd_add_app(a[0], a[1], a[2], a[3:])),
    "remove-app": (2, "remove-app <espace> <app-id-flatpak>",
                   lambda espaces, a: cmd_remove_app(a[0], a[1])),
}


def _aide():
    lignes = [__doc__.strip(), "", "Actions :"]
    for nom in sorted(ACTIONS):
        lignes.append("  codebyr-space " + ACTIONS[nom][1])
    return "\n".join(lignes)


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help", "help"):
        print(_aide())
        return 0
    action, args = argv[1], argv[2:]
    # Hors de la table ACTIONS, donc hors de l'aide : ce ne sont pas des gestes
    # d'utilisateur, c'est le lanceur qui les demande à un Espace.
    if action == INTERNE_PREPARER and len(args) == 1:
        return cmd_interne_preparer(args[0])
    if action == INTERNE_IMPORTER and not args:
        return cmd_interne_importer()
    if action == INTERNE_EXPORTER and not args:
        return cmd_interne_exporter()
    if action == INTERNE_RENDU and not args:
        return cmd_interne_rendu()
    if action == INTERNE_RESTAURER and not args:
        return cmd_interne_restaurer()
    if action == INTERNE_EFFACER and not args:
        return cmd_interne_effacer()
    if action == INTERNE_CONTAGION and not args:
        return cmd_interne_contagion()
    if action == INTERNE_FLATPAK and args:
        return cmd_interne_flatpak(args)
    if action not in ACTIONS:
        sys.stderr.write("Action inconnue : %s\n" % action)
        sys.stderr.write("Actions : %s\n" % ", ".join(sorted(ACTIONS)))
        return 2
    minimum, usage, executer = ACTIONS[action]
    if len(args) < minimum:
        sys.stderr.write("Usage : codebyr-space %s\n" % usage)
        return 2
    try:
        espaces = load_espaces()
        # Un seul contrôle pour tous les gestes pas encore prêts sous compte
        # dédié : un contrôle par commande finirait par en oublier une.
        if args and action in compte_dedie.GESTES_PAS_ENCORE_PRETS:
            refus = compte_dedie.refus_de_geste(action, espaces.get(args[0]))
            if refus:
                sys.stderr.write("codebyr-space : %s\n" % refus)
                _prevenir("Geste pas encore disponible", refus)
                return 1
        return executer(espaces, args)
    except (OSError, ValueError) as exc:
        sys.stderr.write("codebyr-space : opération refusée (%s)\n" % exc)
        _prevenir("Opération interrompue", "Un accès sûr aux données n'a pas pu être établi. Consultez le terminal pour le détail.")
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
