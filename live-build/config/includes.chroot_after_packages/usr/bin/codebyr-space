#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
codebyr-space — lance des applications dans un Espace isolé (Codebyr OS, Phase 2 v1).

Chaque Espace a :
  - sa propre couleur (langage visuel, voir la charte) ;
  - son propre dossier personnel isolé (données séparées entre Espaces) ;
  - un marqueur de fenêtre « codebyr-<id> » pour que l'extension GNOME
    colore ses fenêtres.

Isolation : bubblewrap si disponible (isolation réelle du système de
fichiers), sinon repli sur un dossier personnel séparé. Le bus de session de
l'hôte n'entre JAMAIS dans un Espace (voir wrap_bwrap).

La liste des actions est produite à partir de la table ACTIONS : « --help » ne
peut donc pas se désynchroniser de ce que le programme sait réellement faire.
"""
import glob
import json
import os
import re
import shlex
import shutil
import signal
import socket
import subprocess
import sys
import tarfile
import tempfile
import time
import unicodedata

# Module partagé de lecture/écriture du registre (voir /usr/share/codebyr/).
# CODEBYR_LIB permet de le charger ailleurs — tests, développement.
sys.path.insert(0, os.environ.get("CODEBYR_LIB", "/usr/share/codebyr"))
import applications  # noqa: E402
import autotest  # noqa: E402
import bac_a_sable  # noqa: E402
import provenance  # noqa: E402
import registre  # noqa: E402

DATA_ROOT = os.path.expanduser("~/.local/share/codebyr/espaces")
# Le sas d'un Espace : c'est là qu'atterrit tout fichier venu du dehors. Nom
# écrit à un seul endroit — il l'était à deux, ce qui est la façon habituelle
# dont deux moitiés d'un même système finissent par ne plus se parler.
PARTAGE = "Partagé"


def journal(message):
    """Trace une action dans le journal système (« journalctl -t codebyr »).

    Sans trace, un utilisateur qui signale « ça n'a pas marché » ne peut être
    aidé par personne. On note l'Espace et l'action — jamais le nom du fichier
    ouvert ni l'adresse visitée : ce serait consigner sur disque exactement ce
    que les Espaces servent à cloisonner."""
    try:
        import syslog
        syslog.openlog("codebyr", syslog.LOG_PID, syslog.LOG_USER)
        syslog.syslog(syslog.LOG_INFO, message)
        syslog.closelog()
    except Exception:
        pass    # un journal absent ne doit jamais empêcher un lancement


def load_espaces():
    """Les Espaces, valeurs par défaut du système recouvertes par les choix
    de l'utilisateur (voir registre.charger)."""
    return registre.espaces()


# En dessous de ce seuil, un Jetable risque de saturer la mémoire avant que
# l'utilisateur ne comprenne ce qui se passe.
JETABLE_MINIMUM = 512 * 1024 * 1024


def espace_home(esp):
    if esp.get("ephemere"):
        # Le dossier d'un Espace jetable vit dans /tmp, donc en mémoire vive :
        # rien de ce qu'on y ouvre n'atteint jamais le disque. C'est exactement
        # la promesse du Jetable, et cela vaut mieux qu'un fichier récupérable
        # sur un disque non chiffré. Le revers est qu'un téléchargement
        # volumineux se paie en RAM — autant le dire avant, pas pendant.
        try:
            libre = shutil.disk_usage(tempfile.gettempdir()).free
            if libre < JETABLE_MINIMUM:
                message = ("Il reste %d Mo de mémoire pour l'Espace jetable. "
                           "Évitez d'y télécharger de gros fichiers."
                           % (libre // (1024 * 1024)))
                sys.stderr.write("codebyr-space : %s\n" % message)
                _prevenir("Espace jetable : mémoire limitée", message)
        except OSError:
            pass
        return tempfile.mkdtemp(prefix="codebyr-jetable-%s-" % esp["id"])
    home = os.path.join(DATA_ROOT, esp["id"], "home")
    os.makedirs(home, exist_ok=True)
    return home


def build_command(esp, home, app_cmd):
    """Construit la ligne de commande, avec marqueur de fenêtre par Espace."""
    wm_class = "codebyr-" + esp["id"]
    prog = os.path.basename(app_cmd[0])

    # Firefox : classe de fenêtre par Espace (colore la fenêtre).
    # Pas de --profile : le dossier personnel isolé de l'Espace (HOME) suffit à
    # séparer le profil, et un chemin --profile serait invalide dans le bac à
    # sable bubblewrap (d'où l'erreur « Profile missing »).
    if "firefox" in prog:
        return app_cmd + ["--class", wm_class, "--name", wm_class]
    return app_cmd


def cmd_list(espaces):
    print("Espaces disponibles :")
    for e in espaces.values():
        tag = "  (éphémère)" if e.get("ephemere") else ""
        print("  \033[1m%-12s\033[0m %s  %s%s" % (e["id"], e["couleur"], e["nom"], tag))


def _preparer_profil_firefox(home, port):
    """Pré-configure le profil Firefox de l'Espace pour passer par le filtre réseau."""
    ffbase = os.path.join(home, ".mozilla", "firefox")
    ffdir = os.path.join(ffbase, "codebyr.default")
    os.makedirs(ffdir, exist_ok=True)
    ini = os.path.join(ffbase, "profiles.ini")
    if not os.path.exists(ini):
        with open(ini, "w", encoding="utf-8") as f:
            f.write("[Profile0]\nName=codebyr\nIsRelative=1\nPath=codebyr.default\n"
                    "Default=1\n\n[General]\nStartWithLastProfile=1\nVersion=2\n")
    prefs = [
        'user_pref("network.proxy.type", 1);',
        'user_pref("network.proxy.http", "127.0.0.1");',
        'user_pref("network.proxy.http_port", %d);' % port,
        'user_pref("network.proxy.ssl", "127.0.0.1");',
        'user_pref("network.proxy.ssl_port", %d);' % port,
        'user_pref("network.proxy.share_proxy_settings", true);',
        'user_pref("network.proxy.allow_hijacking_localhost", true);',
        'user_pref("network.trr.mode", 5);',
    ]
    _ajouter_prefs(os.path.join(ffdir, "user.js"), prefs)


OUVREUR = "io.codebyr.Ouvrir.desktop"


def types_ouvreur(chemin_desktop):
    """Les types MIME que l'ouvreur Codebyr prend en charge.

    Lus DANS le .desktop plutôt que recopiés ici. Cette liste existerait sinon
    à deux endroits, et ce projet sait ce que deviennent les listes livrées en
    double — c'est ainsi que quatre lectures du registre ont divergé.
    """
    try:
        with open(chemin_desktop, encoding="utf-8") as f:
            for ligne in f:
                if ligne.startswith("MimeType="):
                    return [t for t in ligne.split("=", 1)[1].strip().split(";") if t]
    except OSError:
        pass
    return []


def associer_ouvreur(contenu, types, ouvreur=OUVREUR):
    """Ajoute nos associations à un mimeapps.list, sans écraser les siennes.

    Décision pure pour être testable — elle touche à un fichier de préférences
    que l'utilisateur a le droit d'avoir rempli lui-même. Un type déjà associé
    est laissé tel quel : quelqu'un qui a choisi son visionneuse de PDF a fait
    un choix, et le lui reprendre au nom de la sécurité est le genre de geste
    qui fait désinstaller un système.
    """
    lignes = (contenu or "").splitlines()
    try:
        debut = lignes.index("[Default Applications]")
    except ValueError:
        lignes = lignes + ([""] if lignes and lignes[-1] else []) + ["[Default Applications]"]
        debut = len(lignes) - 1
    fin = len(lignes)
    for i in range(debut + 1, len(lignes)):
        if lignes[i].startswith("["):
            fin = i
            break
    deja = {ligne.split("=", 1)[0].strip()
            for ligne in lignes[debut + 1:fin] if "=" in ligne}
    ajouts = ["%s=%s" % (t, ouvreur) for t in types if t not in deja]
    if not ajouts:
        return contenu or ""
    return "\n".join(lignes[:fin] + ajouts + lignes[fin:]) + "\n"


def _preparer_ouverture(home, chemin_desktop=None):
    """Fait de l'ouvreur Codebyr le gestionnaire par défaut DANS l'Espace.

    C'est là, et seulement là, que la question a un sens : on y sait où l'on
    est, donc on peut dire qu'un fichier vient d'ailleurs. Sur le bureau il n'y
    a pas d'« ici », et rien n'est modifié.
    """
    types = types_ouvreur(chemin_desktop
                          or os.path.join("/usr/share/applications", OUVREUR))
    if not types:
        return
    cible = os.path.join(home, ".config", "mimeapps.list")
    try:
        os.makedirs(os.path.dirname(cible), exist_ok=True)
        contenu = ""
        if os.path.exists(cible):
            with open(cible, encoding="utf-8") as f:
                contenu = f.read()
        nouveau = associer_ouvreur(contenu, types)
        if nouveau != contenu:
            with open(cible, "w", encoding="utf-8") as f:
                f.write(nouveau)
    except OSError:
        pass    # un défaut de préférence ne doit jamais empêcher un lancement


def _prevenir(titre, message):
    """Dit quelque chose à l'utilisateur du bureau, sans dépendance dure.

    Un message sur la sortie standard d'un programme lancé depuis un menu ne
    sera jamais lu par personne."""
    if not shutil.which("notify-send"):
        return
    try:
        subprocess.Popen(["notify-send", "--icon=dialog-information",
                          titre, message],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


def journal_refus(esp_id):
    """Fichier où le filtre note les domaines qu'il a refusés dans cet Espace.

    « Configuration Codebyr » le relit pour proposer de les autoriser : c'est la
    réponse au cas concret « ma banque ne s'affiche plus » (site bancaire qui
    charge un CDN, un prestataire 3-D Secure ou un captcha sur un autre domaine).
    Convention de chemin partagée avec codebyr-config — si elle change ici,
    elle change là-bas."""
    return os.path.join(DATA_ROOT, esp_id, "domaines-refuses.txt")


def _demarrer_filtre_reseau(esp, home, app_cmd):
    """Si l'Espace a une liste blanche et lance Firefox : démarre le filtre
    et configure le navigateur pour l'utiliser. Renvoie le processus proxy.

    Liste VIDE = tout est bloqué, jamais « tout est permis ». Un Espace déclaré
    à liste blanche dont la liste n'est pas encore remplie doit échouer FERMÉ :
    l'utilisateur voit une page de blocage qui lui dit d'ajouter sa banque,
    au lieu de croire à tort qu'il est protégé."""
    reseau = esp.get("reseau") or {}
    if reseau.get("mode") != "liste-blanche":
        return None
    if "firefox" not in os.path.basename(app_cmd[0]):
        return None
    domaines = reseau.get("domaines") or []
    srv = None
    try:
        # On ouvre NOUS-MÊMES la socket d'écoute et on la transmet au filtre :
        # plus de course entre « trouver un port libre » et « s'y installer »,
        # et le port écoute déjà quand le navigateur démarre.
        srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        srv.bind(("127.0.0.1", 0))
        srv.listen(64)
        port = srv.getsockname()[1]

        # Le profil est configuré AVANT de lancer le filtre, volontairement : si
        # le filtre ne démarre pas, le navigateur pointe vers un port muet et ne
        # joint plus rien. L'ordre inverse laissait l'Espace Banque avec un accès
        # Internet complet quand le filtre manquait à l'appel.
        _preparer_profil_firefox(home, port)

        proc = subprocess.Popen(["codebyr-net-proxy", "--fd", str(srv.fileno()),
                                 "--journal", journal_refus(esp["id"])] + domaines,
                                pass_fds=(srv.fileno(),))
        if domaines:
            print("Réseau restreint : seuls %d domaine(s) autorisé(s) dans %s."
                  % (len(domaines), esp["nom"]))
        else:
            print("Réseau restreint : AUCUN site autorisé dans %s pour l'instant. "
                  "Ajoutez celui de votre banque dans « Configuration Codebyr »."
                  % esp["nom"])
            # En HTTPS, le navigateur affiche SA propre page d'erreur : notre
            # explication n'arrive jamais à l'écran. Or c'est le premier
            # contact d'un nouvel utilisateur avec la fonctionnalité phare —
            # il clique sur Banque, rien ne s'affiche, et il n'a aucune idée
            # de pourquoi. Une notification, elle, passe quel que soit le
            # protocole.
            _prevenir("Espace %s : aucun site autorisé" % esp["nom"],
                      "Ouvrez « Configuration Codebyr » pour déclarer votre "
                      "banque. Tant qu'elle n'est pas déclarée, cet Espace "
                      "n'ouvre aucun site — c'est voulu.")
        return proc
    except OSError as exc:
        sys.stderr.write("codebyr-space : filtre réseau indisponible (%s) — "
                         "le navigateur de cet Espace ne joindra aucun site.\n" % exc)
        return None
    finally:
        # Le filtre a sa propre copie de la socket : la nôtre n'a plus lieu d'être.
        if srv is not None:
            srv.close()


BOUCLIER_DIR = "/usr/share/codebyr/antiphishing"
BOUCLIER_ID = "antiphishing@codebyr.io"


def _domaines_proteges(espaces):
    """Domaines des banques protégées (liste blanche des Espaces à réseau restreint)."""
    out = []
    for e in espaces.values():
        r = e.get("reseau") or {}
        if r.get("mode") == "liste-blanche":
            for d in (r.get("domaines") or []):
                d = d.strip().removeprefix("*.")
                if d and d not in out:
                    out.append(d)
    return out


def _ecrire_stockage_manage(home, doms):
    """Écrit le manifeste de STOCKAGE MANAGÉ Firefox : les domaines protégés sont
    fournis en DONNÉE (pas injectés dans le code), pour que l'extension reste
    statique et signable. Firefox lit ce fichier par utilisateur sous Linux."""
    msdir = os.path.join(home, ".mozilla", "managed-storage")
    os.makedirs(msdir, exist_ok=True)
    manifeste = {
        "name": BOUCLIER_ID,
        "description": "Domaines bancaires protégés par Codebyr.",
        "type": "storage",
        "data": {"domaines": doms},
    }
    with open(os.path.join(msdir, BOUCLIER_ID + ".json"), "w", encoding="utf-8") as f:
        json.dump(manifeste, f, ensure_ascii=False)


def _ajouter_prefs(chemin, prefs):
    """Ajoute des « user_pref » à un user.js SANS le faire grossir sans fin.

    Ce fichier était réécrit en mode « ajout » à chaque lancement d'Espace : au
    bout de quelques centaines d'ouvertures, Firefox relisait la même
    préférence des centaines de fois. On dédoublonne, et on écrit une seule fois."""
    existantes = []
    try:
        with open(chemin, encoding="utf-8") as f:
            existantes = [l.rstrip("\n") for l in f if l.strip()]
    except OSError:
        pass
    for p in prefs:
        if p not in existantes:
            existantes.append(p)
    with open(chemin, "w", encoding="utf-8") as f:
        f.write("\n".join(existantes) + "\n")


def _installer_bouclier(esp, home, espaces):
    """Installe le bouclier anti-hameçonnage dans le profil Firefox d'un Espace
    de navigation : avertit si un site imite une banque protégée.

    Les domaines passent par le stockage managé : le code de l'extension reste
    STATIQUE, donc signable par Mozilla. Seul un .xpi SIGNÉ est installé.

    Il n'existe volontairement PLUS de repli « .xpi non signé » : il obligeait à
    poser xpinstall.signatures.required=false, c'est-à-dire à désactiver la
    vérification des signatures d'extensions dans le profil — un affaiblissement
    réel du navigateur pour installer une protection. Sans .xpi signé, on
    n'installe rien, et on le dit."""
    doms = _domaines_proteges(espaces)
    if not doms or not os.path.isdir(BOUCLIER_DIR):
        return
    ffbase = os.path.join(home, ".mozilla", "firefox")
    ffdir = os.path.join(ffbase, "codebyr.default")
    extdir = os.path.join(ffdir, "extensions")
    os.makedirs(extdir, exist_ok=True)
    ini = os.path.join(ffbase, "profiles.ini")
    if not os.path.exists(ini):
        with open(ini, "w", encoding="utf-8") as f:
            f.write("[Profile0]\nName=codebyr\nIsRelative=1\nPath=codebyr.default\n"
                    "Default=1\n\n[General]\nStartWithLastProfile=1\nVersion=2\n")

    # Domaines fournis en donnée (l'extension reste statique → signable).
    _ecrire_stockage_manage(home, doms)

    # .xpi signé par Mozilla, s'il y en a un (nom quelconque : AMO le génère).
    signe = None
    signed_dir = os.path.join(BOUCLIER_DIR, "signed")
    if os.path.isdir(signed_dir):
        for f in sorted(os.listdir(signed_dir)):
            if f.endswith(".xpi"):
                signe = os.path.join(signed_dir, f)
                break
    if signe is None:
        sys.stderr.write(
            "codebyr-space : bouclier anti-hameçonnage indisponible (aucune "
            "extension signée dans %s/signed). Aucune protection installée — et "
            "aucun réglage de sécurité de Firefox abaissé.\n" % BOUCLIER_DIR)
        return

    _ajouter_prefs(os.path.join(ffdir, "user.js"), [
        'user_pref("extensions.autoDisableScopes", 0);',
        'user_pref("extensions.enabledScopes", 15);',
    ])

    shutil.copy2(signe, os.path.join(extdir, BOUCLIER_ID + ".xpi"))
    print("Bouclier anti-hameçonnage actif [signé] "
          "(%d domaine(s) de banque protégé(s))." % len(doms))


def _visionneuse_pour(nom):
    """Choisit une visionneuse CONCRÈTE selon le type de fichier, pour ouvrir une
    pièce jointe sans passer par xdg-open/gvfs — qui échoue dans le bac à sable
    blindé et hors-ligne (pas de service de lancement, pas de fuse)."""
    ext = os.path.splitext(nom)[1].lower()

    def premier(*cands):
        for c in cands:
            if shutil.which(c):
                return [c]
        return None

    v = None
    if ext == ".pdf":
        v = premier("evince", "papers", "xpdf", "qpdfview")
    elif ext in (".png", ".jpg", ".jpeg", ".gif", ".bmp", ".webp",
                 ".svg", ".tiff", ".tif", ".ico"):
        v = premier("loupe", "eog")
    elif ext in (".html", ".htm", ".xhtml", ".mhtml"):
        v = premier("firefox-esr", "firefox")
    elif ext in (".odt", ".doc", ".docx", ".xls", ".xlsx", ".ods",
                 ".ppt", ".pptx", ".odp", ".rtf", ".csv"):
        v = premier("libreoffice", "soffice")
    # Défaut (texte, sans extension, type inconnu) : éditeur de texte.
    if v is None:
        v = premier("gnome-text-editor", "gedit", "evince", "papers")
    return v or ["xdg-open"]


def cmd_launch(espaces, esp_id, extra, fichier=None):
    esp = espaces.get(esp_id)
    if not esp:
        sys.stderr.write("Espace inconnu : %s\n" % esp_id)
        return 2
    home = espace_home(esp)
    # Dans un Espace, un fichier venu d'ailleurs s'ouvre sous cloche. Câblé au
    # lancement plutôt qu'à la création : un Espace existant en profite aussi,
    # sans quoi le correctif n'atteindrait que les Espaces créés après lui.
    if not esp.get("ephemere"):
        _preparer_ouverture(home)
    use_bwrap = bool(shutil.which("bwrap"))
    runtime_home = os.path.expanduser("~") if use_bwrap else home

    # Niveau d'isolation : « renforce » déclaré dans le registre (ex. Banque),
    # ou imposé automatiquement pour l'examen d'une pièce jointe.
    renforce = esp.get("blindage") == "renforce"
    hors_ligne = False
    # Son : le socket PipeWire donne aussi accès au MICRO. Un Espace peut le
    # refuser dans le registre ("audio": false) — c'est le cas de Banque, qui
    # n'a aucun besoin de son et représente la cible la plus sensible.
    audio = esp.get("audio", True) is not False

    # Fichier partagé dans l'Espace (ouverture jetable d'une pièce jointe) :
    # copié dans l'Espace pour être visible dans le bac à sable isolé.
    if fichier and os.path.isfile(fichier):
        partage = os.path.join(home, PARTAGE)
        os.makedirs(partage, exist_ok=True)
        nom = os.path.basename(fichier)
        try:
            shutil.copy2(fichier, os.path.join(partage, nom))
        except OSError as exc:
            sys.stderr.write("codebyr-space : copie du fichier impossible (%s)\n" % exc)
        if not extra:
            chemin = os.path.join(runtime_home, PARTAGE, nom)
            extra = _visionneuse_pour(nom) + [chemin]
        # Sous cloche : une pièce jointe s'examine blindée ET sans réseau.
        renforce = True
        hors_ligne = True

    app_cmd = extra if extra else applications.resoudre(esp.get("app", "org.gnome.Nautilus.desktop"))
    # Une application Flatpak s'isole DÉJÀ dans son propre bac à sable : on ne
    # peut ni l'enfermer dans le nôtre (sandbox imbriqué = échec), ni lui donner
    # un bus de session privé (elle a besoin du vrai bus pour ses portails).
    est_flatpak = os.path.basename(app_cmd[0]) == "flatpak" or app_cmd[0].endswith("/flatpak")
    cmd = build_command(esp, home, app_cmd)

    # Bus de session privé par Espace : les apps « mono-instance » (Fichiers,
    # éditeur…) démarrent alors un vrai processus isolé au lieu de rouvrir une
    # fenêtre de la session partagée — ce qui rétablit l'isolation ET le liseré.
    # Ce bus privé n'est pas un confort : c'est LUI qui remplace le bus de
    # session de l'hôte, que le bac à sable n'expose plus (voir wrap_bwrap).
    if not est_flatpak:
        if shutil.which("dbus-run-session"):
            cmd = ["dbus-run-session", "--"] + cmd
        else:
            sys.stderr.write("codebyr-space : dbus-run-session absent — l'application "
                             "n'aura aucun bus de session (paquet « dbus » manquant ?).\n")

    env = dict(os.environ)
    env["CODEBYR_ESPACE"] = esp["id"]
    env["CODEBYR_ESPACE_COULEUR"] = esp["couleur"]
    # Sous Wayland, c'est MOZ_APP_REMOTINGNAME qui fixe l'app_id de Firefox
    # (donc la « classe » que lit l'extension pour colorer la fenêtre).
    if "firefox" in os.path.basename(app_cmd[0]):
        env["MOZ_APP_REMOTINGNAME"] = "codebyr-" + esp["id"]
        # Force Firefox à utiliser NOTRE profil (profiles.ini Default=1) au lieu
        # d'en créer un « dédié par installation » — sinon les réglages proxy du
        # filtre réseau ne s'appliquent pas.
        env["MOZ_LEGACY_PROFILES"] = "1"
        env["MOZ_ALLOW_DOWNGRADE"] = "1"

    ephemere = esp.get("ephemere")
    if est_flatpak:
        appid = app_cmd[-1] if len(app_cmd) >= 2 else ""
        if appid and _flatpak_app_dans_espace(esp["id"], appid):
            # Installée DANS l'Espace : installation Flatpak dédiée +
            # données isolées (HOME de l'Espace → ~/.var/app séparé).
            env["FLATPAK_USER_DIR"] = _espace_flatpak_dir(esp["id"])
            env["HOME"] = home
            run = cmd
            print("Application Flatpak propre à l'Espace %s (isolée)." % esp["nom"])
        else:
            # App Flatpak SYSTÈME : installée pour toute la machine. Elle a son
            # propre bac à sable Flatpak, mais ses données sont communes à tous
            # les Espaces — ce qu'elle enregistre depuis Travail, elle le
            # retrouve depuis Personnel.
            #
            # L'avertissement existait, dans le terminal : c'est-à-dire nulle
            # part, pour quelqu'un qui a cliqué dans un menu. L'utilisateur
            # croyait son application cloisonnée alors qu'elle ne l'est pas, et
            # le liseré coloré le lui confirmait à tort.
            run = cmd
            nom_app = os.path.basename(app_cmd[-1] if len(app_cmd) >= 2
                                       else app_cmd[0])
            print("Note : application Flatpak système — son propre bac à sable "
                  "Flatpak ; le liseré de l'Espace reste indicatif.")
            _prevenir(
                "%s n'est pas cloisonnée dans %s" % (nom_app, esp["nom"]),
                "Cette application est installée pour toute la machine : ses "
                "données sont les mêmes dans tous les Espaces. Pour l'isoler, "
                "installez-la DANS l'Espace depuis « Configuration Codebyr ».")
            journal("Espace %s : application Flatpak système %s (non cloisonnée)"
                    % (esp["id"], nom_app))
    elif use_bwrap:
        run = bac_a_sable.wrap_bwrap(home, cmd, env, renforce=renforce, hors_ligne=hors_ligne,
                         audio=audio)
        if renforce:
            run = bac_a_sable.plafonner_ressources(run)
            detail = "Blindage actif" + (" · hors-ligne (aucun réseau)" if hors_ligne else "")
            print("🛡  %s dans l'Espace %s." % (detail, esp["nom"]))
        if not audio:
            print("🎤 Son et micro coupés dans l'Espace %s." % esp["nom"])
    else:
        env["HOME"] = home
        run = cmd
        sys.stderr.write("codebyr-space : bubblewrap absent, isolation réduite "
                         "(dossier personnel séparé).\n")

    print("Ouverture de « %s » dans l'Espace %s…" % (os.path.basename(cmd[0]), esp["nom"]))
    journal("Espace %s : ouverture de %s%s%s%s"
            % (esp["id"], os.path.basename(app_cmd[0]),
               " [blindage]" if renforce else "",
               " [hors-ligne]" if hors_ligne else "",
               "" if use_bwrap or est_flatpak else " [SANS bac à sable]"))
    # Répertoire d'exécution partagé avec l'extension GNOME : on y note
    # « ce processus (et ses enfants) appartient à tel Espace », pour que
    # l'extension colore la fenêtre par filiation, même sans marqueur de classe.
    rundir = _rundir()
    try:
        os.makedirs(rundir, exist_ok=True)
    except OSError:
        pass
    _nettoyer_marqueurs()

    proxy = _demarrer_filtre_reseau(esp, home, app_cmd)
    # Bouclier anti-hameçonnage dans TOUS les navigateurs, y compris celui de
    # l'Espace Banque. On l'en excluait au motif que sa liste blanche suffit —
    # mais cette liste est saisie à la main par l'utilisateur. Le jour où un
    # domaine imitateur y entre par erreur, plus rien ne le signale : la liste
    # blanche le laisse passer, et le bouclier n'était pas là pour crier.
    # Or l'erreur humaine est précisément la menace que cette fonctionnalité
    # existe pour couvrir.
    if "firefox" in os.path.basename(app_cmd[0]):
        try:
            _installer_bouclier(esp, home, espaces)
        except OSError as exc:
            sys.stderr.write("codebyr-space : bouclier indisponible (%s)\n" % exc)

    proc = subprocess.Popen(run, env=env)
    mapfile = os.path.join(rundir, "pid-%d" % proc.pid)
    try:
        with open(mapfile, "w", encoding="utf-8") as f:
            f.write(esp["id"])
    except OSError:
        mapfile = None
    try:
        rc = proc.wait()
    finally:
        if proxy:
            try:
                proxy.terminate()
            except OSError:
                pass
        if mapfile:
            try:
                os.remove(mapfile)
            except OSError:
                pass
        if ephemere and os.path.isdir(home) and home.startswith(tempfile.gettempdir()):
            shutil.rmtree(home, ignore_errors=True)
            print("Espace jetable détruit.")
    return rc


def _rundir():
    return os.path.join(
        os.environ.get("XDG_RUNTIME_DIR") or "/run/user/%d" % os.getuid(), "codebyr")


def _nettoyer_marqueurs():
    """Retire les marqueurs « pid-N » dont le processus n'existe plus.

    Un processus tué brutalement laissait le sien derrière lui, et l'extension
    GNOME pouvait alors attribuer la fenêtre d'un NOUVEAU processus au même
    numéro à l'Espace du défunt — donc afficher le mauvais liseré."""
    if not os.path.isdir("/proc"):
        return
    rundir = _rundir()
    try:
        noms = os.listdir(rundir)
    except OSError:
        return
    for nom in noms:
        if not nom.startswith("pid-"):
            continue
        try:
            pid = int(nom[4:])
        except ValueError:
            continue
        if not os.path.isdir("/proc/%d" % pid):
            try:
                os.remove(os.path.join(rundir, nom))
            except OSError:
                pass


def cmd_close(espaces, esp_id):
    """Ferme toutes les fenêtres/processus ouverts d'un Espace."""
    rundir = _rundir()
    ferme = 0
    try:
        noms = os.listdir(rundir)
    except OSError:
        noms = []
    for name in noms:
        if not name.startswith("pid-"):
            continue
        path = os.path.join(rundir, name)
        try:
            with open(path, encoding="utf-8") as f:
                eid = f.read().strip()
        except OSError:
            continue
        if eid != esp_id:
            continue
        try:
            pid = int(name[4:])
        except ValueError:
            continue
        try:
            os.kill(pid, signal.SIGTERM)
            ferme += 1
        except OSError:
            try:
                os.remove(path)
            except OSError:
                pass
    _nettoyer_marqueurs()
    print("Espace %s : %d fenêtre(s) fermée(s)." % (esp_id, ferme))
    journal("Espace %s : fermeture (%d fenêtre(s))" % (esp_id, ferme))
    return 0


def cmd_purge(espaces, esp_id):
    esp = espaces.get(esp_id)
    if not esp:
        sys.stderr.write("Espace inconnu : %s\n" % esp_id)
        return 2
    cmd_close(espaces, esp_id)   # on ferme d'abord les fenêtres ouvertes
    d = os.path.join(DATA_ROOT, esp_id)
    if os.path.isdir(d):
        shutil.rmtree(d, ignore_errors=True)
        print("Données de l'Espace %s effacées." % esp["nom"])
        journal("Espace %s : données effacées" % esp_id)
    else:
        print("Rien à effacer pour %s." % esp["nom"])
    return 0


BACKUP_DIR = os.path.expanduser("~/Espaces-Codebyr")


def cmd_export(espaces, esp_id, dest=None):
    """Sauvegarde un Espace dans une archive portable (copiable sur clé USB)."""
    esp = espaces.get(esp_id)
    if not esp:
        sys.stderr.write("Espace inconnu : %s\n" % esp_id)
        return 2
    home = os.path.join(DATA_ROOT, esp_id, "home")
    if not os.path.isdir(home):
        print("L'Espace %s est vide — rien à sauvegarder." % esp["nom"])
        return 0
    os.makedirs(BACKUP_DIR, exist_ok=True)
    path = dest or os.path.join(
        BACKUP_DIR, "%s-%s.tar.gz" % (esp_id, time.strftime("%Y%m%d-%H%M")))
    with tarfile.open(path, "w:gz") as tar:
        tar.add(home, arcname=".")
    print("Espace %s sauvegardé : %s" % (esp["nom"], path))
    return 0


def cmd_import(espaces, esp_id, source=None):
    """Restaure un Espace depuis une archive (portabilité entre machines)."""
    esp = espaces.get(esp_id)
    if not esp:
        sys.stderr.write("Espace inconnu : %s\n" % esp_id)
        return 2
    if not source:
        cands = sorted(glob.glob(os.path.join(BACKUP_DIR, "%s-*.tar.gz" % esp_id)))
        if not cands:
            print("Aucune sauvegarde trouvée pour %s." % esp["nom"])
            return 1
        source = cands[-1]
    if not os.path.exists(source):
        sys.stderr.write("Archive introuvable : %s\n" % source)
        return 1
    cmd_close(espaces, esp_id)
    home = os.path.join(DATA_ROOT, esp_id, "home")
    shutil.rmtree(home, ignore_errors=True)
    os.makedirs(home, exist_ok=True)
    with tarfile.open(source, "r:gz") as tar:
        try:
            tar.extractall(home, filter="data")   # sûr (Python 3.12+)
        except TypeError:
            tar.extractall(home)
    print("Espace %s restauré depuis %s" % (esp["nom"], os.path.basename(source)))
    return 0


FLATHUB_REPO = "/etc/flatpak/remotes.d/flathub.flatpakrepo"


def _espace_flatpak_dir(esp_id):
    """Répertoire d'installation Flatpak DÉDIÉ à un Espace (binaires isolés)."""
    return os.path.join(DATA_ROOT, esp_id, "flatpak")


def _flatpak_env(esp_id):
    """Environnement pointant l'installation Flatpak propre à l'Espace."""
    d = _espace_flatpak_dir(esp_id)
    os.makedirs(d, exist_ok=True)
    env = dict(os.environ)
    env["FLATPAK_USER_DIR"] = d
    return env, d


def _flatpak_app_dans_espace(esp_id, appid):
    """L'application est-elle installée DANS l'Espace (et non au niveau système) ?"""
    return os.path.isdir(os.path.join(_espace_flatpak_dir(esp_id), "app", appid))


def _assurer_flathub(env):
    """Ajoute le dépôt Flathub à l'installation de l'Espace (fichier local → hors-ligne OK)."""
    src = FLATHUB_REPO if os.path.exists(FLATHUB_REPO) else \
        "https://flathub.org/repo/flathub.flatpakrepo"
    subprocess.run(["flatpak", "--user", "remote-add", "--if-not-exists", "flathub", src],
                   env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def _flatpak_nom_lisible(env, appid):
    try:
        out = subprocess.check_output(
            ["flatpak", "--user", "list", "--app", "--columns=application,name"],
            env=env, text=True, stderr=subprocess.DEVNULL)
    except (subprocess.CalledProcessError, OSError):
        return None
    for line in out.splitlines():
        parts = line.split("\t")
        if len(parts) >= 2 and parts[0] == appid:
            return parts[1].strip()
    return None


def _enregistrer_app(esp_id, nom, cmd):
    """Ajoute l'application au menu de CET Espace (personnalisation utilisateur)."""
    esp = registre.espaces().get(esp_id) or {}
    apps = list(esp.get("apps") or [])
    if not any(a.get("cmd") == cmd for a in apps):
        apps.append({"nom": nom, "cmd": cmd})
    registre.modifier_espace(esp_id, {"apps": apps})


def cmd_install(esp_id, appid):
    """Installe une application Flatpak DANS un Espace (isolée : binaires + données)."""
    espaces = load_espaces()
    esp = espaces.get(esp_id)
    if not esp:
        sys.stderr.write("Espace inconnu : %s\n" % esp_id)
        return 2
    if not shutil.which("flatpak"):
        sys.stderr.write("Flatpak n'est pas installé.\n")
        return 2
    env, _ = _flatpak_env(esp_id)
    _assurer_flathub(env)
    print("Installation de « %s » dans l'Espace %s…" % (appid, esp["nom"]))
    rc = subprocess.call(["flatpak", "--user", "install", "-y", "flathub", appid], env=env)
    if rc != 0:
        sys.stderr.write("Échec de l'installation de %s.\n" % appid)
        return rc
    nom = _flatpak_nom_lisible(env, appid) or appid
    _enregistrer_app(esp_id, nom, "flatpak run " + appid)
    print("« %s » installée dans l'Espace %s." % (nom, esp["nom"]))
    return 0


def cmd_add_app(esp_id, nom, fichier, extra):
    """Ajoute un programme LOCAL (binaire téléchargé, script…) au menu d'un Espace.
    Gère la correspondance des chemins entre l'hôte et le bac à sable."""
    espaces = load_espaces()
    esp = espaces.get(esp_id)
    if not esp:
        sys.stderr.write("Espace inconnu : %s\n" % esp_id)
        return 2
    cible = os.path.abspath(os.path.expanduser(fichier))
    esp_home = os.path.join(DATA_ROOT, esp_id, "home")
    if os.path.isfile(cible):
        try:
            os.chmod(cible, 0o755)  # rendre exécutable
        except OSError:
            pass
        # Chemin tel que vu DANS le bac à sable (le home de l'Espace est monté sur ~).
        if cible.startswith(esp_home + os.sep):
            rel = os.path.relpath(cible, esp_home)
            prog = os.path.join(os.path.expanduser("~"), rel)
        else:
            prog = cible  # hors home de l'Espace (ex. /usr, /opt en lecture seule)
    else:
        prog = fichier  # commande du PATH (ex. « gimp »)
    # La commande stockée est réinterprétée comme une ligne shell au lancement :
    # on protège le chemin (et les arguments) par des quotes, sans quoi un dossier
    # contenant une espace (« Antigravity IDE ») casse le lancement.
    cmd = shlex.quote(prog)
    if extra:
        cmd += " " + " ".join(shlex.quote(a) for a in extra)
    _enregistrer_app(esp_id, nom, cmd)
    print("« %s » ajoutée au menu de l'Espace %s." % (nom, esp["nom"]))
    print("  Commande : %s" % cmd)
    return 0


def cmd_apps(esp_id):
    """Liste les applications installées dans un Espace."""
    espaces = load_espaces()
    esp = espaces.get(esp_id)
    if not esp:
        sys.stderr.write("Espace inconnu : %s\n" % esp_id)
        return 2
    env, _ = _flatpak_env(esp_id)
    print("Applications de l'Espace %s :" % esp["nom"])
    subprocess.call(["flatpak", "--user", "list", "--app",
                     "--columns=application,name,version"], env=env)
    return 0


def cmd_remove_app(esp_id, appid):
    """Désinstalle une application d'un Espace et la retire de son menu."""
    espaces = load_espaces()
    esp = espaces.get(esp_id)
    if not esp:
        sys.stderr.write("Espace inconnu : %s\n" % esp_id)
        return 2
    env, _ = _flatpak_env(esp_id)
    rc = subprocess.call(["flatpak", "--user", "uninstall", "-y", appid], env=env)
    apps = [a for a in (esp.get("apps") or [])
            if a.get("cmd") != "flatpak run " + appid]
    registre.modifier_espace(esp_id, {"apps": apps})
    print("« %s » retirée de l'Espace %s." % (appid, esp["nom"]))
    return rc


def cmd_create(nom, couleur):
    """Crée un Espace personnalisé (persistant), écrit dans le registre utilisateur."""
    nom = nom.strip()
    if not nom:
        sys.stderr.write("Nom d'Espace vide.\n")
        return 2
    if not couleur.startswith("#"):
        couleur = "#" + couleur
    base = unicodedata.normalize("NFKD", nom).encode("ascii", "ignore").decode().lower()
    base = re.sub(r"[^a-z0-9]+", "-", base).strip("-") or "espace"
    esp_id = registre.identifiant_libre(base)
    registre.ajouter_espace({
        "id": esp_id, "nom": nom, "couleur": couleur,
        "app": "org.gnome.Nautilus.desktop", "ephemere": False,
    })
    print("Espace « %s » créé (%s)." % (nom, couleur))
    return 0


def cmd_delete(esp_id):
    """Supprime un Espace personnalisé. Les Espaces livrés par le système ne
    sont pas supprimables — on interroge le registre système plutôt qu'une
    liste codée en dur, qui aurait fini par diverger de son contenu."""
    if registre.est_systeme(esp_id):
        sys.stderr.write("L'Espace intégré « %s » ne peut pas être supprimé.\n" % esp_id)
        return 2
    espaces = load_espaces()
    cmd_close(espaces, esp_id)
    if not registre.supprimer_espace(esp_id):
        print("Espace introuvable : %s" % esp_id)
        return 1
    d = os.path.join(DATA_ROOT, esp_id)
    if os.path.isdir(d):
        shutil.rmtree(d, ignore_errors=True)
    print("Espace supprimé : %s" % esp_id)
    return 0


def cmd_nettoyer_registre():
    """Réduit vos réglages personnels à ce qui diffère vraiment des défauts.

    Les versions antérieures à la 1.2.0 enregistraient une COPIE INTÉGRALE de
    la configuration. Une valeur recopiée reste une valeur qui gagne : elle
    continue donc de masquer les durcissements livrés ensuite, même après la
    mise à jour. Cette commande fait le ménage une fois pour toutes."""
    avant = registre.couche()
    n_avant = sum(len(e) for e in avant.get("espaces", []) if isinstance(e, dict))
    apres = registre.reduire_couche(dict(avant))
    n_apres = sum(len(e) for e in apres.get("espaces", []) if isinstance(e, dict))
    if n_apres == n_avant:
        print("Vos réglages ne contiennent déjà que des différences. Rien à faire.")
        return 0
    registre.ecrire_couche(avant)
    print("Réglages nettoyés : %d valeur(s) recopiée(s) du système retirée(s)."
          % (n_avant - n_apres))
    print("Vos choix personnels sont intacts ; les valeurs par défaut vous "
          "atteindront de nouveau.")
    journal("Registre utilisateur réduit (%d valeurs retirées)" % (n_avant - n_apres))
    return 0


def _action_launch(espaces, args):
    """launch <espace> [--fichier <f>] [-- commande...]"""
    esp_id, reste = args[0], args[1:]
    fichier = None
    extra = []
    i = 0
    while i < len(reste):
        if reste[i] == "--fichier" and i + 1 < len(reste):
            fichier = reste[i + 1]
            i += 2
        elif reste[i] == "--":
            extra = reste[i + 1:]
            break
        else:
            i += 1
    return cmd_launch(espaces, esp_id, extra, fichier)


def _espace_courant():
    """L'Espace depuis lequel cette commande est lancée, ou None.

    Posée par cmd_launch dans l'environnement de chaque Espace : un processus
    qui tourne dedans la voit, un processus du bureau ne la voit pas. C'est
    donc aussi la façon de savoir qu'on est « à l'extérieur ».
    """
    esp_id = os.environ.get("CODEBYR_ESPACE", "").strip()
    return esp_id if provenance.identifiant_valide(esp_id) else None


def nom_libre(dossier, nom, existe=os.path.exists):
    """Un nom qui n'écrase rien : « rapport.pdf » → « rapport (2).pdf ».

    Décision pure (l'accès disque est injectable) parce qu'elle décide d'une
    PERTE DE DONNÉES. Écraser en silence un fichier déjà présent dans un Espace
    serait le pire comportement possible ici : l'utilisateur ne saurait même pas
    qu'il a perdu quelque chose — le geste, lui, a l'air d'avoir réussi.
    """
    if not existe(os.path.join(dossier, nom)):
        return nom
    base, ext = os.path.splitext(nom)
    for n in range(2, 1000):
        candidat = "%s (%d)%s" % (base, n, ext)
        if not existe(os.path.join(dossier, candidat)):
            return candidat
    return None


def cmd_envoyer(espaces, esp_id, fichier):
    """Dépose une COPIE d'un fichier dans le sas d'un Espace.

    À ne pas confondre avec « launch --fichier », qui sert à examiner une pièce
    jointe douteuse et impose pour cela le blindage et la coupure réseau.
    Envoyer un document dans Travail est le geste inverse : on classe quelque
    chose dont on ne se méfie pas, et l'Espace doit rester ce qu'il est.

    C'est une COPIE : l'original ne bouge pas. Franchir une frontière entre
    Espaces ne doit jamais faire disparaître ce qu'on avait avant.
    """
    esp = espaces.get(esp_id)
    if not esp:
        sys.stderr.write("Espace inconnu : %s\n" % esp_id)
        return 2
    if esp.get("ephemere"):
        # Le dossier d'un Espace jetable vit en mémoire et disparaît avec lui :
        # y « classer » un document reviendrait à le jeter.
        sys.stderr.write("Un Espace jetable ne conserve rien : utilisez plutôt "
                         "« codebyr-space launch %s --fichier … ».\n" % esp_id)
        return 2
    source = os.path.abspath(os.path.expanduser(fichier))
    if not os.path.isfile(source):
        sys.stderr.write("Fichier introuvable (ou ce n'est pas un fichier) : %s\n"
                         % fichier)
        return 2

    partage = os.path.join(espace_home(esp), PARTAGE)
    try:
        os.makedirs(partage, exist_ok=True)
        nom = nom_libre(partage, os.path.basename(source))
        if nom is None:
            sys.stderr.write("Trop de fichiers du même nom dans %s.\n" % PARTAGE)
            return 1
        cible = os.path.join(partage, nom)
        shutil.copy2(source, cible)
        # La copie garde l'origine de l'original si elle en a une ; sinon elle
        # reçoit l'Espace d'où part l'envoi. Sans ce report, la marque
        # disparaîtrait au premier franchissement — c'est-à-dire exactement au
        # moment qu'elle sert à tracer.
        if not provenance.heriter(source, cible, DATA_ROOT):
            depart = _espace_courant()
            if depart and depart != esp_id:
                provenance.marquer(cible, depart)
    except OSError as exc:
        sys.stderr.write("Copie impossible (%s)\n" % exc)
        _prevenir("Envoi impossible",
                  "Le fichier n'a pas pu être copié dans %s." % esp["nom"])
        return 1

    # Le journal note l'Espace et l'action, jamais le nom du fichier.
    journal("envoi vers l'Espace %s" % esp["id"])
    _prevenir("Envoyé dans %s" % esp["nom"],
              "Le fichier vous attend dans le dossier « %s » de cet Espace."
              % PARTAGE)
    print("Copié dans %s → %s/%s" % (esp["nom"], PARTAGE, nom))
    return 0


def cmd_provenance(espaces, chemin):
    """Dit d'où vient un fichier, et si l'ouvrir ici mérite une cloche."""
    cible = os.path.abspath(os.path.expanduser(chemin))
    if not os.path.exists(cible):
        sys.stderr.write("Fichier introuvable : %s\n" % chemin)
        return 2
    venue = provenance.origine(cible, DATA_ROOT)
    if not venue:
        print("Origine inconnue — ce fichier n'a jamais transité par un Espace,"
              "\nou il a perdu sa marque (clé USB, pièce jointe, partage réseau).")
        return 0
    esp = espaces.get(venue)
    print("Vient de l'Espace : %s" % (esp["nom"] if esp else venue))
    courant = _espace_courant()
    if courant and provenance.doit_isoler(venue, courant):
        ici = espaces.get(courant)
        print("Vous êtes dans %s : l'ouvrir ici ferait franchir une frontière."
              % (ici["nom"] if ici else courant))
    return 0


def decider_ouverture(origine, espace_courant):
    """« jetable » ou « normale ». Décision pure, pour être testable.

    Un fichier venu d'un AUTRE Espace s'ouvre sous cloche : blindé, sans
    réseau, détruit à la fermeture. C'est le seul moment où la marque sert
    vraiment à quelque chose — jusqu'ici elle informait, elle protège.

    Le doute profite à l'ouverture normale. Un fichier sans origine connue, ou
    déjà chez lui, s'ouvre comme d'habitude : refuser d'ouvrir des documents
    ordinaires ferait désactiver la fonction dès la première semaine, et une
    protection désactivée ne protège personne.
    """
    return "jetable" if provenance.doit_isoler(origine, espace_courant) else "normale"


def cmd_ouvrir(espaces, chemin, lanceur=None):
    """Ouvre un fichier, sous cloche s'il vient d'un autre Espace.

    Destiné à être le gestionnaire par défaut DANS les Espaces : c'est là que
    la question se pose, puisqu'on y sait où l'on est. Sur le bureau, il n'y a
    pas d'« ici », donc rien à franchir — voir provenance.doit_isoler.
    """
    cible = os.path.abspath(os.path.expanduser(chemin))
    if not os.path.isfile(cible):
        sys.stderr.write("Fichier introuvable : %s\n" % chemin)
        return 2

    courant = _espace_courant()
    venue = provenance.origine(cible, DATA_ROOT)
    choix = decider_ouverture(venue, courant)

    if lanceur is None:
        def lanceur(argv):
            subprocess.Popen(argv, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL)

    if choix == "jetable":
        autre = espaces.get(venue)
        journal("ouverture sous cloche d'un fichier venu de %s" % venue)
        _prevenir("Ouvert sous cloche",
                  "Ce fichier vient de l'Espace %s. Il s'ouvre isolé et sans "
                  "réseau, et disparaîtra à la fermeture."
                  % (autre["nom"] if autre else venue))
        try:
            lanceur(["/usr/bin/codebyr-jetable", cible])
        except OSError as exc:
            # Échouer ici empêcherait d'ouvrir un document parfaitement
            # légitime. On le dit, et on ouvre normalement.
            sys.stderr.write("codebyr-space : Jetable indisponible (%s)\n" % exc)
            choix = "normale"

    if choix == "normale":
        try:
            lanceur(["xdg-open", cible])
        except OSError as exc:
            sys.stderr.write("codebyr-space : ouverture impossible (%s)\n" % exc)
            return 1
    return 0


def cmd_adopter(espaces, chemin):
    """Après examen : ce fichier appartient désormais à l'Espace courant."""
    cible = os.path.abspath(os.path.expanduser(chemin))
    if not os.path.isfile(cible):
        sys.stderr.write("Fichier introuvable : %s\n" % chemin)
        return 2
    courant = _espace_courant()
    if not courant:
        sys.stderr.write(
            "Adopter n'a de sens que DANS un Espace : c'est là qu'un fichier "
            "peut appartenir\nà quelque part. Lancez cette commande depuis "
            "l'Espace où vous voulez le garder.\n")
        return 2
    venue = provenance.origine(cible, DATA_ROOT)
    if not provenance.doit_isoler(venue, courant):
        print("Ce fichier est déjà chez lui : rien à faire.")
        return 0
    if not provenance.adopter(cible, courant):
        sys.stderr.write("Marque impossible à écrire (système de fichiers "
                         "sans attributs étendus ?).\n")
        return 1
    esp = espaces.get(courant)
    journal("adoption d'un fichier venu de %s dans %s" % (venue, courant))
    print("Adopté dans %s : ce fichier s'ouvrira désormais normalement ici."
          % (esp["nom"] if esp else courant))
    print("(Il redeviendra étranger si vous l'envoyez vers un autre Espace.)")
    return 0


def cmd_contagion(espaces, esp_id):
    """Compte, dans un Espace, les fichiers venus d'ailleurs.

    Montrer la contagion plutôt que la supposer absente : c'est le même parti
    pris que « verifier-isolation », appliqué aux fichiers. Un chiffre nul est
    une information ; un chiffre élevé aussi.
    """
    esp = espaces.get(esp_id)
    if not esp:
        sys.stderr.write("Espace inconnu : %s\n" % esp_id)
        return 2
    racine = os.path.join(DATA_ROOT, esp_id, "home")
    origines = []
    total = 0
    for dossier, _, fichiers in os.walk(racine):
        for nom in fichiers:
            total += 1
            origines.append(provenance.origine(os.path.join(dossier, nom), DATA_ROOT))
    compte = provenance.resumer(origines, esp_id)
    print("Espace %s — %d fichier(s) au total." % (esp["nom"], total))
    if not compte:
        print("Aucun fichier venu d'un autre Espace.")
        return 0
    for venue, combien in sorted(compte.items(), key=lambda c: -c[1]):
        autre = espaces.get(venue)
        print("  %3d venu(s) de %s" % (combien, autre["nom"] if autre else venue))
    print("\nCes fichiers ont franchi une frontière. Pour en examiner un sous "
          "cloche :\n  codebyr-space launch %s --fichier <chemin>" % esp_id)
    return 0


# Table des actions : (nombre minimal d'arguments, usage, fonction).
# Une seule source de vérité — l'ancienne cascade de « if » laissait le message
# d'usage et le nombre d'arguments dériver l'un de l'autre à chaque ajout.
ACTIONS = {
    "list":       (0, "list", lambda espaces, a: cmd_list(espaces) or 0),
    "isolation":  (0, "isolation", lambda espaces, a: bac_a_sable.cmd_isolation()),
    "verifier-isolation": (0, "verifier-isolation",
                           lambda espaces, a: bac_a_sable.cmd_verifier_isolation()),
    "verifier-poste": (0, "verifier-poste",
                       lambda espaces, a: autotest.cmd_verifier_poste()),
    "envoyer":    (2, "envoyer <espace> <fichier>",
                   lambda espaces, a: cmd_envoyer(espaces, a[0], a[1])),
    "provenance": (1, "provenance <fichier>",
                   lambda espaces, a: cmd_provenance(espaces, a[0])),
    "ouvrir":     (1, "ouvrir <fichier>",
                   lambda espaces, a: cmd_ouvrir(espaces, a[0])),
    "adopter":    (1, "adopter <fichier>",
                   lambda espaces, a: cmd_adopter(espaces, a[0])),
    "contagion":  (1, "contagion <espace>",
                   lambda espaces, a: cmd_contagion(espaces, a[0])),
    "nettoyer-registre": (0, "nettoyer-registre",
                          lambda espaces, a: cmd_nettoyer_registre()),
    "launch":     (1, "launch <espace> [--fichier <f>] [-- commande...]",
                   _action_launch),
    "close":      (1, "close <espace>",
                   lambda espaces, a: cmd_close(espaces, a[0])),
    "purge":      (1, "purge <espace>",
                   lambda espaces, a: cmd_purge(espaces, a[0])),
    "export":     (1, "export <espace> [fichier]",
                   lambda espaces, a: cmd_export(espaces, a[0],
                                                 a[1] if len(a) > 1 else None)),
    "import":     (1, "import <espace> [fichier]",
                   lambda espaces, a: cmd_import(espaces, a[0],
                                                 a[1] if len(a) > 1 else None)),
    "create":     (2, "create <nom> <couleur>",
                   lambda espaces, a: cmd_create(a[0], a[1])),
    "delete":     (1, "delete <espace>", lambda espaces, a: cmd_delete(a[0])),
    "install":    (2, "install <espace> <app-id-flatpak>",
                   lambda espaces, a: cmd_install(a[0], a[1])),
    "apps":       (1, "apps <espace>", lambda espaces, a: cmd_apps(a[0])),
    "add-app":    (3, "add-app <espace> <nom> <fichier|commande> [args...]",
                   lambda espaces, a: cmd_add_app(a[0], a[1], a[2], a[3:])),
    "remove-app": (2, "remove-app <espace> <app-id-flatpak>",
                   lambda espaces, a: cmd_remove_app(a[0], a[1])),
}


def _aide():
    lignes = [__doc__.strip(), "", "Actions :"]
    for nom in sorted(ACTIONS):
        lignes.append("  codebyr-space " + ACTIONS[nom][1])
    return "\n".join(lignes)


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help", "help"):
        print(_aide())
        return 0
    action, args = argv[1], argv[2:]
    if action not in ACTIONS:
        sys.stderr.write("Action inconnue : %s\n" % action)
        sys.stderr.write("Actions : %s\n" % ", ".join(sorted(ACTIONS)))
        return 2
    minimum, usage, executer = ACTIONS[action]
    if len(args) < minimum:
        sys.stderr.write("Usage : codebyr-space %s\n" % usage)
        return 2
    return executer(load_espaces(), args)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
