#!/usr/bin/python3 -IS
# -*- coding: utf-8 -*-
"""Le premier processus d'un Espace : il tourne SOUS le compte de l'Espace.

── POURQUOI CE PROGRAMME EXISTE ────────────────────────────────────────────
Le compte du bureau ne peut pas devenir un autre compte : il n'a pas
CAP_SETUID. Un Espace sous compte dédié ne peut donc être lancé que par root.

Mais le service root n'exécute rien qui vienne d'un client, et cette règle ne
se négocie pas : c'est elle qui fait qu'une faille du lanceur ne donne pas la
machine. Root ne lance donc qu'UN programme, celui-ci, à un chemin fixe. C'est
ensuite LUI — déjà dépouillé de tout privilège — qui exécute ce que le bureau
demande.

Le sens de circulation compte : le bureau dit à un compte MOINS privilégié que
lui quoi exécuter. Il pouvait déjà tout exécuter sous sa propre identité ; lui
laisser commander celle-ci ne lui donne rien de neuf. L'inverse serait une
élévation de privilège ; celui-ci n'en est pas une.

── CE QU'IL NE FAIT PAS ────────────────────────────────────────────────────
· Il ne demande jamais rien à root. Sa vie se termine quand root le termine.
· Il n'est PAS joignable depuis le bac à sable : sa socket vit dans le dépôt,
  et seules « notif » et « proxy » y sont montées dans un Espace. Un programme
  qui s'échapperait de bubblewrap retrouverait donc son propre compte, et rien
  de plus — c'est tout l'intérêt du chantier.
· Il n'accepte d'ordre que du compte du bureau ou du sien, d'après le NOYAU
  (SO_PEERCRED). La vérification est bon marché ; elle dit surtout, à qui lira
  ce fichier dans deux ans, que la liste était voulue.

── PROTOCOLE ───────────────────────────────────────────────────────────────
Une demande JSON par connexion. La connexion vit aussi longtemps que le
processus lancé : c'est elle qui en rapporte la fin.

  {"argv": ["bwrap", ...], "env": {...}}
      → {"ok": true, "pid": 1234}        (dès le lancement)
      → {"fin": 0}                       (à la sortie du processus)

  {"argv": [...], "env": {...}, "flux": ["entree"]}  + un descripteur joint
      → la commande lit ce descripteur comme entrée standard (« sortie » :
        comme sortie standard). C'est ainsi que les données d'un Espace
        entrent et sortent, par un tuyau du bureau, sans passer par root.

Lancement : par codebyr-uid, jamais à la main.
    codebyr-espace-init <uid du bureau> <fd de la socket> <fd du tuyau d'annonce>

Le tuyau d'annonce sert à dire « j'écoute ». Sans lui, un échec au lancement
serait invisible : la socket d'ordres est créée et mise en écoute par root, et
accepte donc les connexions même si personne n'y répond jamais.
"""
import json
import os
import select
import socket
import struct
import subprocess
import sys
import syslog
import threading

TAILLE_MAX = 65536


def journal(message):
    syslog.syslog(syslog.LOG_INFO, message)


def demandeur(client):
    donnees = client.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED,
                                struct.calcsize("3i"))
    _pid, uid, _gid = struct.unpack("3i", donnees)
    return uid


# Les seuls flux qu'un ordre peut transmettre, et où ils arrivent. Pas de
# numéro de descripteur libre : l'entrée et la sortie standard, rien d'autre.
FLUX = ("entree", "sortie")


def lancer(demande, descripteurs=()):
    """Exécute ce que le bureau demande, sous l'identité qui est déjà la nôtre.

    Aucun shell : la liste d'arguments est passée telle quelle au noyau. Un
    `shell=True` ferait de chaque espace et de chaque guillemet une commande.

    `descripteurs` : reçus avec la demande (SCM_RIGHTS), dans l'ordre annoncé
    par « flux ». C'est par là que passent les données d'un Espace — un tuyau
    ouvert par le bureau — sans que root les lise jamais : s'il copiait
    lui-même depuis le dossier personnel, un lien symbolique posé là lui ferait
    copier n'importe quel fichier du système dans un Espace que le bureau lit.
    """
    argv = demande.get("argv")
    if not isinstance(argv, list) or not argv or not all(
            isinstance(a, str) for a in argv):
        raise ValueError("commande absente ou mal formée")
    env = demande.get("env")
    if not isinstance(env, dict) or not all(
            isinstance(c, str) and isinstance(v, str) for c, v in env.items()):
        raise ValueError("environnement mal formé")
    flux = demande.get("flux", [])
    if (not isinstance(flux, list) or len(flux) != len(descripteurs)
            or len(set(flux)) != len(flux) or not all(f in FLUX for f in flux)):
        raise ValueError("flux annoncés et descripteurs reçus ne concordent pas")
    recus = dict(zip(flux, descripteurs))
    return subprocess.Popen(argv, env=env, cwd="/",
                            stdin=recus.get("entree", subprocess.DEVNULL),
                            stdout=recus.get("sortie"))


def servir_un(client, uid_bureau, uid_propre):
    with client:
        client.settimeout(30)
        uid = demandeur(client)
        if uid not in (uid_bureau, uid_propre):
            journal("ordre refusé : UID %d" % uid)
            client.sendall(b'{"ok": false, "erreur": "refuse"}\n')
            return
        descripteurs = []
        try:
            brut, descripteurs, _drapeaux, _adresse = socket.recv_fds(
                client, TAILLE_MAX, len(FLUX))
            demande = json.loads(brut.decode("utf-8", "replace"))
            if not isinstance(demande, dict):
                raise ValueError("demande illisible")
            proc = lancer(demande, descripteurs)
        except (ValueError, OSError) as exc:
            journal("lancement impossible : %s" % exc)
            try:
                client.sendall(b'{"ok": false, "erreur": "impossible"}\n')
            except OSError:
                pass
            return
        finally:
            # Nos copies des descripteurs reçus : le processus lancé a les
            # siennes. Les garder ouvertes empêcherait la fin d'un tuyau de se
            # voir — l'autre bout attendrait une fin de flux qui ne vient pas.
            for fd in descripteurs:
                try:
                    os.close(fd)
                except OSError:
                    pass
        try:
            client.sendall((json.dumps({"ok": True, "pid": proc.pid}) + "\n")
                           .encode("utf-8"))
            client.settimeout(None)
            code = attendre(proc, client)
        except OSError:
            code = None
        if code is None:
            arreter(proc)
            return
        try:
            client.sendall((json.dumps({"fin": code}) + "\n").encode("utf-8"))
        except OSError:
            pass


def attendre(proc, client):
    """Attend la fin du processus OU le départ du lanceur, le premier des deux.

    La connexion tient le processus : si le lanceur la referme — ou meurt, ce
    que le noyau signale de la même façon — l'application n'a plus de raison
    de vivre. Sans cela, elle survivrait à son lanceur, donc à ses sockets de
    notification et de filtre réseau : un navigateur de Banque resterait
    ouvert avec un filtre mort. C'est l'équivalent, sous compte dédié, du
    « --die-with-parent » de bubblewrap.

    Un simple proc.wait() ne voyait le départ du lanceur qu'APRÈS la fin de
    l'application. Renvoie le code de sortie, ou None si le lanceur est parti.
    """
    try:
        pidfd = os.pidfd_open(proc.pid)
    except ProcessLookupError:
        return proc.wait()      # déjà terminé avant qu'on le guette
    try:
        while True:
            prets, _, _ = select.select([client, pidfd], [], [])
            if pidfd in prets:
                return proc.wait()
            if not client.recv(64):
                return None     # fin de connexion : le lanceur est parti
    finally:
        os.close(pidfd)


def arreter(proc):
    proc.terminate()
    try:
        proc.wait(timeout=5)
    except subprocess.TimeoutExpired:
        proc.kill()
        proc.wait()


def servir(srv, uid_bureau):
    uid_propre = os.getuid()
    while True:
        try:
            client, _ = srv.accept()
        except OSError:
            return 0
        threading.Thread(target=servir_un,
                         args=(client, uid_bureau, uid_propre),
                         daemon=True).start()


def main(argv):
    if len(argv) != 4:
        sys.stderr.write("codebyr-espace-init : lancé par le service des "
                         "comptes d'Espaces, jamais à la main.\n")
        return 2
    if os.geteuid() == 0:
        # Root n'a rien à faire ici : ce programme n'existe que pour exécuter
        # sans privilège. S'il tourne en root, la protection a sauté en amont.
        sys.stderr.write("codebyr-espace-init : refuse de tourner en root.\n")
        return 2
    syslog.openlog("codebyr-espace", syslog.LOG_PID, syslog.LOG_DAEMON)
    uid_bureau = int(argv[1])
    srv = socket.socket(fileno=int(argv[2]))
    journal("Espace prêt sous l'UID %d, aux ordres du bureau %d"
            % (os.getuid(), uid_bureau))
    # L'annonce vient APRÈS tout ce qui peut échouer : elle ne veut dire
    # « j'écoute » que si c'est vrai. Si ce processus meurt avant, le tuyau se
    # ferme et celui qui l'a lancé le sait tout de suite.
    annonce = int(argv[3])
    os.write(annonce, b"1")
    os.close(annonce)
    return servir(srv, uid_bureau)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
