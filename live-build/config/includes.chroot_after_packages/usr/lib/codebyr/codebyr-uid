def journal(message):
    syslog.syslog(syslog.LOG_INFO, message)


def demandeur(client):
    """Qui parle, d'après le NOYAU. Jamais d'après ce que le client raconte."""
    donnees = client.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED,
                                struct.calcsize("3i"))
    _pid, uid, _gid = struct.unpack("3i", donnees)
    try:
        nom = pwd.getpwuid(uid).pw_name
    except KeyError:
        nom = ""
    return uid, nom


def compte_systeme(nom, home):
    """Crée le compte de l'Espace s'il manque, et vérifie ce qui existe déjà.

    Sans mot de passe utilisable ni shell de connexion : ce compte n'est pas
    fait pour ouvrir une session, seulement pour posséder des fichiers.
    """
    try:
        utilisateur = pwd.getpwnam(nom)
    except KeyError:
        # Plafond par utilisateur, vérifié au moment de CRÉER : le service
        # écoute pour tout le monde, et rien d'autre n'empêcherait un compte
        # local de faire créer des milliers de comptes système.
        proprietaire = comptes.decomposer(nom)
        if comptes.trop_d_espaces([c.pw_name for c in pwd.getpwall()],
                                  proprietaire[0], nom):
            raise ValueError("trop d'Espaces pour cet utilisateur")
        subprocess.run(["/usr/sbin/useradd", "--system", "--user-group",
                        "--no-create-home", "--home-dir", home,
                        "--shell", "/usr/sbin/nologin", "--password", "!", nom],
                       check=True, capture_output=True)
        utilisateur = pwd.getpwnam(nom)
        journal("compte créé : %s (UID %d)" % (nom, utilisateur.pw_uid))
    if utilisateur.pw_uid == 0:
        raise ValueError("Compte existant incompatible")
    return utilisateur


def dossier_root(chemin, mode=0o711):
    """Un dossier appartenant à root, qu'aucun autre compte ne peut modifier."""
    if os.path.islink(chemin):
        raise ValueError("Lien symbolique refusé : %s" % chemin)
    os.makedirs(chemin, mode=mode, exist_ok=True)
    os.chmod(chemin, mode)
    st = os.stat(chemin)
    if st.st_uid != 0 or st.st_mode & 0o022:
        raise ValueError("Dossier modifiable par un autre compte : %s" % chemin)
    return chemin


def racines():
    """Les deux dossiers que tout le reste suppose, avec des droits SÛRS.

    Ils naissaient sinon des droits par défaut du service (umask). Un umask
    plus strict — un durcissement de systemd, un jour — les aurait créés en
    0700 : plus aucun Espace n'aurait pu traverser jusqu'au sien, et rien
    n'aurait dit pourquoi. On ne laisse pas une protection dépendre d'un
    réglage qu'on ne contrôle pas.
    """
    # /run/user n'est pas dans la liste : il appartient au système (tmpfs de
    # systemd, 0755), et nous n'avons pas à le créer ni à en changer les
    # droits. On y pose seulement le dossier de chaque Espace.
    for chemin in (os.path.dirname(comptes.RACINE_ESPACES),
                   comptes.RACINE_DEPOTS.rsplit("/", 1)[0]):
        dossier_root(chemin)


ANCIENNES_PASSERELLES = "/run/codebyr/passerelles"


def ranger_les_anciennes_passerelles():
    """Ce qu'un service 1.15.0 aurait laissé derrière lui, rangé au démarrage.

    Jusqu'en 1.15.0, les sockets d'un Espace étaient présentées dans
    /run/codebyr/passerelles/<compte>. Un ancien service qui s'arrête
    normalement range tout — il ne s'arrête que quand plus aucun Espace n'est
    ouvert. Mais tué pendant une mise à jour, il laisserait des montages, et
    surtout le DROIT du compte de l'Espace sur le socket Wayland du bureau :
    un accès à l'affichage que plus personne ne saurait retirer avant la
    déconnexion. Au démarrage, aucun Espace n'est ouvert par ce service-ci :
    tout ce qui reste là-dessous est un reste, et on le retire.
    """
    if not os.path.isdir(ANCIENNES_PASSERELLES) or os.path.islink(ANCIENNES_PASSERELLES):
        return
    for compte in sorted(os.listdir(ANCIENNES_PASSERELLES)):
        dossier = os.path.join(ANCIENNES_PASSERELLES, compte)
        proprietaire = comptes.decomposer(compte) if comptes.est_compte_d_espace(compte) else None
        try:
            uid_espace = pwd.getpwnam(compte).pw_uid
        except KeyError:
            uid_espace = None
        for fichier in sorted(os.listdir(dossier)) if os.path.isdir(dossier) else []:
            echec = retirer(os.path.join(dossier, fichier))
            if echec:
                journal("ancienne passerelle %s : %s, %s" % (compte, fichier, echec))
            if proprietaire and uid_espace is not None:
                source = os.path.join("/run/user/%d" % proprietaire[0], fichier)
                if os.path.exists(source):
                    subprocess.run(["/usr/bin/setfacl", "-x", "u:%d" % uid_espace,
                                    source], capture_output=True)
        try:
            os.rmdir(dossier)
        except OSError as exc:
            journal("ancienne passerelle %s conservée : %s" % (compte, exc))
    try:
        os.rmdir(ANCIENNES_PASSERELLES)
        journal("anciennes passerelles (1.15.0) rangées")
    except OSError:
        pass


def dossier_espace(home, utilisateur):
    """Le dossier personnel de l'Espace : à lui seul, 0700."""
    dossier_root(os.path.dirname(home))
    if os.path.islink(home):
        raise ValueError("Lien symbolique refusé : %s" % home)
    os.makedirs(home, mode=0o700, exist_ok=True)
    st = os.stat(home)
    if st.st_uid not in (0, utilisateur.pw_uid):
        raise ValueError("Dossier déjà pris par un autre compte")
    os.chown(home, utilisateur.pw_uid, utilisateur.pw_gid)
    os.chmod(home, 0o700)
    return home


def dossier_depot(compte, uid_bureau, uid_espace):
    """Dossier où le bureau dépose les sockets qu'il sert à cet Espace.

    Root le possède ; le bureau y écrit ; l'Espace ne fait que le traverser.
    Les droits sont POSÉS EN ENTIER (« setfacl --set ») et non ajoutés : un
    droit oublié d'une ouverture précédente ne survit pas à la suivante.

    On ne passe pas par dossier_root() : sa règle « aucun bit d'écriture pour
    autrui » désigne exactement ce qu'on accorde ici volontairement au bureau,
    et le masque d'une ACL se lit comme un bit de groupe — la vérification
    échouerait à la deuxième ouverture du même Espace.
    """
    chemin = comptes.chemin_depot(compte)
    if os.path.islink(chemin):
        raise ValueError("Lien symbolique refusé : %s" % chemin)
    dossier_root(os.path.dirname(chemin))
    os.makedirs(chemin, mode=0o710, exist_ok=True)
    if os.stat(chemin).st_uid != 0:
        raise ValueError("Dépôt déjà pris par un autre compte")
    os.chmod(chemin, 0o710)
    subprocess.run(
        ["/usr/bin/setfacl", "--set",
         "u::rwx,g::---,o::---,u:%d:rwx,u:%d:x,m::rwx" % (uid_bureau, uid_espace),
         chemin], check=True, capture_output=True)
    return chemin


def monter_jetable(home, utilisateur, memoire):
    """Le dossier d'un Espace jetable devient un tmpfs : en mémoire, rien sur disque.

    C'est la promesse du Jetable, tenue sous compte dédié comme elle l'était
    sous le compte du bureau (/tmp). Monté à l'ouverture, démonté à la
    fermeture : son contenu disparaît avec lui.

    · taille bornée par le plafond mémoire de l'Espace, déjà validé (« 2G »,
      « 75% ») — une taille qui ne vient donc jamais du client telle quelle ;
    · noexec : ce qu'on télécharge dans un Jetable ne s'y exécute pas ;
    · un montage déjà là — laissé par une ouverture interrompue — est retiré
      d'abord : on n'empile pas, et on ne rouvre pas sur un contenu ancien.
    """
    for _ in range(8):
        if not os.path.ismount(home):
            break
        subprocess.run(["/usr/bin/umount", home], check=True, capture_output=True)
    else:
        raise OSError("montages empilés impossibles à retirer : %s" % home)
    subprocess.run(
        ["/usr/bin/mount", "-t", "tmpfs", "-o",
         "size=%s,mode=0700,uid=%d,gid=%d,nosuid,nodev,noexec"
         % (memoire, utilisateur.pw_uid, utilisateur.pw_gid),
         "codebyr-jetable", home], check=True, capture_output=True)
    journal("Espace jetable %s monté en mémoire (%s)" % (utilisateur.pw_name, memoire))


def _dossier_de_boite(chemin, proprietaire_uid, proprietaire_gid, mode):
    """Crée une boîte (persistante), sous un parent que root tient.

    Le parent appartient à root : ni le bureau ni l'Espace ne peuvent
    remplacer la boîte elle-même par un lien, seulement son contenu — que le
    bureau manipule toujours sans suivre de lien (fichiers_surs).
    """
    parent = os.path.dirname(chemin)
    dossier_root(os.path.dirname(parent))
    dossier_root(parent)
    if os.path.islink(chemin):
        raise ValueError("Lien symbolique refusé : %s" % chemin)
    os.makedirs(chemin, mode=mode, exist_ok=True)
    st = os.stat(chemin)
    if st.st_uid not in (0, proprietaire_uid):
        raise ValueError("Boîte déjà prise par un autre compte : %s" % chemin)
    os.chown(chemin, proprietaire_uid, proprietaire_gid)
    os.chmod(chemin, mode)
    return chemin


def boite_de_depart(uid_bureau, espace, utilisateur):
    """L'Espace y dépose ce qu'il envoie ; le bureau relève.

    À l'Espace, avec un droit pour le bureau — posé aussi PAR DÉFAUT sur ce
    qui y sera créé : sans lui, un fichier déposé en 0600 par l'Espace
    resterait illisible au bureau et ne partirait jamais.
    """
    chemin = _dossier_de_boite(comptes.chemin_envois(uid_bureau, espace),
                               utilisateur.pw_uid, utilisateur.pw_gid, 0o700)
    subprocess.run(
        ["/usr/bin/setfacl", "--set",
         "u::rwx,g::---,o::---,u:%d:rwx,m::rwx,"
         "d:u::rwx,d:g::---,d:o::---,d:u:%d:rwX,d:m::rwx" % (uid_bureau, uid_bureau),
         chemin], check=True, capture_output=True)
    return chemin


def boite_d_arrivee(uid_bureau, espace, utilisateur):
    """Le bureau y dépose ce qu'on envoie à l'Espace ; l'Espace le recueille.

    À root, avec un droit pour chacun des deux : ni l'un ni l'autre ne peut la
    retirer à l'autre. Le bureau y rend ses fichiers lisibles lui-même, au
    moment de les écrire (une ACL par défaut n'y suffirait pas : son masque
    suit le mode de création, 0600 pour une écriture sûre).
    """
    chemin = _dossier_de_boite(comptes.chemin_arrivees(uid_bureau, espace), 0, 0, 0o770)
    subprocess.run(
        ["/usr/bin/setfacl", "--set",
         "u::rwx,g::---,o::---,u:%d:rwx,u:%d:rwx,m::rwx" % (uid_bureau, utilisateur.pw_uid),
         chemin], check=True, capture_output=True)
    return chemin


def vider_depot(chemin):
    """Retire les sockets déposées, puis le dépôt. Ne descend dans rien.

    Ce dossier n'est censé contenir que des sockets ; s'il contient autre
    chose, on le laisse en place plutôt que d'effacer en aveugle depuis root.
    """
    if not os.path.isdir(chemin) or os.path.islink(chemin):
        return
    for nom in os.listdir(chemin):
        fichier = os.path.join(chemin, nom)
        if os.path.isdir(fichier) and not os.path.islink(fichier):
            continue
        try:
            os.unlink(fichier)
        except OSError:
            pass
    try:
        os.rmdir(chemin)
    except OSError:
        journal("dépôt non vide, conservé : %s" % chemin)


def _retirer_les_cartes(utilisateur, echecs):
    """Reprend à l'Espace l'accès aux cartes graphiques, à sa fermeture.

    Le droit est retiré de TOUTES les cartes, qu'on le lui ait accordé ou non :
    un Espace ouvert une fois avec la carte, refermé, puis rouvert sans elle ne
    doit pas la garder. Un droit qui survit à l'Espace est un droit oublié.
    """
    for chemin_carte in cartes_presentes():
        try:
            droit_sur_socket(chemin_carte, utilisateur.pw_uid, accorder=False)
        except subprocess.CalledProcessError as exc:
            echecs.append("%s, DROIT NON RETIRÉ : %s" % (
                chemin_carte, (exc.stderr or b"").decode("utf-8", "replace").strip()))


def cartes_presentes():
    """Les cartes graphiques que root peut accorder, lues sur le système.

    Le dossier est lu ici — comptes.py ne décide que de la forme des noms —
    et tout lien symbolique est écarté : un lien posé là ferait accorder un
    droit sur autre chose qu'une carte.
    """
    try:
        noms = os.listdir(comptes.RACINE_CARTES)
    except OSError:
        return []
    return [c for c in comptes.cartes_de_rendu(noms) if not os.path.islink(c)]


def droit_sur_socket(chemin, uid, accorder=True):
    """Accorde (ou retire) l'accès d'UN compte à UN fichier. Jamais un dossier.

    Sert aux sockets du bureau et aux cartes graphiques : dans les deux cas,
    c'est un droit NOMINATIF, posé le temps d'un Espace et retiré après —
    exactement ce que logind fait pour une session d'utilisateur.
    """
    regle = ["-m", "u:%d:rw" % uid] if accorder else ["-x", "u:%d" % uid]
    subprocess.run(["/usr/bin/setfacl"] + regle + [chemin],
                   check=True, capture_output=True)


def dossier_runtime(uid_espace, utilisateur):
    """Le dossier d'exécution de l'Espace : à lui, 0700, à sa place canonique.

    Root le crée — /run/user appartient au système — et le donne aussitôt à
    l'Espace, qui doit pouvoir y écrire : c'est là que Flatpak pose ses
    sockets et son « .dbus-proxy ». Lui laisser l'écriture ne lui donne
    aucune prise sur les sockets qu'on y présente : un montage lié ne peut
    être ni supprimé, ni renommé, ni remplacé par un lien piégé, fût-ce par
    le propriétaire du dossier (mesuré le 15/09/2026).
    """
    chemin = comptes.chemin_runtime(uid_espace)
    if os.path.islink(chemin):
        raise ValueError("Lien symbolique refusé : %s" % chemin)
    os.makedirs(chemin, mode=0o700, exist_ok=True)
    st = os.stat(chemin)
    if st.st_uid not in (0, utilisateur.pw_uid):
        raise ValueError("Dossier d'exécution déjà pris par un autre compte")
    os.chown(chemin, utilisateur.pw_uid, utilisateur.pw_gid)
    os.chmod(chemin, 0o700)
    return chemin


def presenter(source, destination):
    """Présente un socket du bureau dans le dossier de l'Espace, par un montage lié.

    Un montage déjà présent — laissé par une préparation interrompue — serait
    RECOUVERT par le nouveau, et la fermeture n'en retirerait qu'un : le
    dossier survivrait à l'Espace. Constaté le 14/09/2026. On retire donc
    d'abord ce qui est là, avant de monter.
    """
    for _ in range(8):
        if not os.path.ismount(destination):
            break
        subprocess.run(["/usr/bin/umount", destination],
                       check=True, capture_output=True)
    else:
        raise OSError("montages empilés impossibles à retirer : %s" % destination)
    if not os.path.exists(destination):
        with open(destination, "w"):
            pass
    subprocess.run(["/usr/bin/mount", "--bind", source, destination],
                   check=True, capture_output=True)


def retirer(destination):
    """Retire un socket présenté. Renvoie la raison d'un échec, ou None.

    Rien n'est ignoré : un démontage refusé passait ici en silence, et la
    fermeture se disait réussie en laissant le montage en place — constaté
    le 14/09/2026. Root ne prétend pas avoir rangé ce qu'il n'a pas rangé.
    """
    if os.path.ismount(destination):
        r = subprocess.run(["/usr/bin/umount", destination],
                           capture_output=True, text=True)
        if r.returncode != 0:
            return "démontage refusé : %s" % (r.stderr.strip() or r.returncode)
    try:
        os.unlink(destination)
    except FileNotFoundError:
        pass
    except OSError as exc:
        return "suppression refusée : %s" % exc
    return None


def socket_d_ordres(depot):
    """Crée la socket par laquelle le bureau commandera l'Espace.

    C'est ROOT qui la crée, pas l'Espace : ainsi l'Espace ne peut pas la
    remplacer par la sienne pour intercepter ce que le bureau lui destine.
    Le premier processus de l'Espace la reçoit déjà ouverte, en héritage — il
    n'a donc besoin d'aucun droit sur le dossier pour y écouter.
    """
    chemin = os.path.join(depot, comptes.SOCKET_EXEC)
    if os.path.exists(chemin):
        os.unlink(chemin)
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(chemin)
    # Le dossier fait le tri : seuls le bureau et cet Espace le traversent.
    os.chmod(chemin, 0o666)
    srv.listen(16)
    srv.set_inheritable(True)
    return srv


def premier_processus(utilisateur, uid_demandeur, srv, memoire, taches, affichage):
    """Lance le premier processus de l'Espace, sous son compte et sous plafond.

    Root n'exécute qu'UN chemin, écrit ici en toutes lettres. Ce qui vient du
    bureau — la ligne de commande d'une application — n'arrive jamais jusqu'à
    root : c'est ce premier processus, déjà sans privilège, qui l'exécutera.

    setpriv fait l'abandon d'identité (groupes vidés, plus aucun privilège à
    acquérir) ; systemd-run ne sert qu'au cgroup. Séparer les deux laisse à
    chacun un seul rôle, et à nous un seul mécanisme d'identité dans tout le
    projet.
    """
    fd = srv.fileno()
    # Un tuyau pour que le premier processus dise « j'écoute ». Sans lui, un
    # échec au lancement — programme absent, dossier intraversable, portée
    # refusée — ne se verrait NULLE PART : la socket d'ordres, créée et mise
    # en écoute par ROOT, accepte les connexions même si personne n'y répond.
    # Le bureau attendrait alors indéfiniment une réponse qui ne viendrait
    # jamais, et l'Espace resterait annoncé comme prêt. Constaté le 14/09/2026.
    lecture, ecriture = os.pipe()
    os.set_inheritable(ecriture, True)
    try:
        proc = subprocess.Popen(
            ["/usr/bin/systemd-run", "--scope", "--quiet",
             "--unit", comptes.unite_de_l_espace(utilisateur.pw_name),
             "-p", "MemoryMax=%s" % memoire, "-p", "MemorySwapMax=0",
             "-p", "TasksMax=%d" % taches,
             "--", "/usr/bin/setpriv",
             "--reuid", str(utilisateur.pw_uid), "--regid", str(utilisateur.pw_gid),
             "--clear-groups", "--no-new-privs",
             # L'affichage a déjà été validé par comptes.passages() : c'est le
             # nom du socket présenté dans le dossier de l'Espace, que son bus
             # transmettra aux portails.
             INIT, str(uid_demandeur), str(fd), str(ecriture), affichage],
            pass_fds=(fd, ecriture), stdin=subprocess.DEVNULL)
    finally:
        # Côté écriture fermé ici : sinon la fin du processus ne fermerait pas
        # le tuyau, et l'attente ci-dessous irait jusqu'au bout du délai.
        os.close(ecriture)
    try:
        pret, _, _ = select.select([lecture], [], [], DELAI_DEMARRAGE)
        # Tuyau fermé sans un mot = le processus est mort avant d'écouter.
        annonce = os.read(lecture, 1) if pret else b""
    finally:
        os.close(lecture)
    if annonce != b"1":
        proc.terminate()
        try:
            proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            proc.kill()
        raise OSError("le premier processus de l'Espace n'a jamais écouté "
                      "(code %s)" % proc.poll())
    return proc


def arreter_portee(compte):
    subprocess.run(["/usr/bin/systemctl", "stop", "--quiet",
                    comptes.unite_de_l_espace(compte)], capture_output=True)


def preparer(uid_demandeur, espace, affichage, son, memoire=None, taches=None,
             ephemere=False, carte=False):
    """Tout ou rien : une préparation qui échoue défait ce qu'elle a posé.

    Constaté le 14/09/2026 : le premier processus refusait de démarrer, alors
    que le socket Wayland était déjà monté chez l'Espace et le DROIT déjà
    accordé au compte de l'Espace. Rien n'était défait. L'Espace n'existait
    pas, mais son compte gardait l'accès à l'affichage du bureau — et l'essai
    suivant a monté un second socket par-dessus le premier.

    Un Espace déjà ouvert n'est pas refermé si une nouvelle préparation échoue :
    on ne ferme pas sous les yeux de l'utilisateur ce qui fonctionnait.
    """
    nom = comptes.nom_compte(uid_demandeur, espace)
    ouvert = OUVERTS.get(nom)
    deja_ouvert = bool(ouvert) and ouvert[0].poll() is None
    try:
        return _preparer(uid_demandeur, espace, affichage, son, memoire, taches,
                        ephemere, carte)
    except Exception:
        if not deja_ouvert:
            try:
                defait = fermer(uid_demandeur, espace)
                if not defait.get("ok"):
                    journal("préparation de %s défaite en partie seulement" % nom)
            except Exception as exc:
                journal("préparation de %s impossible à défaire : %s" % (nom, exc))
        raise


def _preparer(uid_demandeur, espace, affichage, son, memoire, taches,
              ephemere=False, carte=False):
    nom = comptes.nom_compte(uid_demandeur, espace)
    home = comptes.chemin_home(uid_demandeur, espace)
    utilisateur = compte_systeme(nom, home)
    dossier_espace(home, utilisateur)
    envois = boite_de_depart(uid_demandeur, espace, utilisateur)
    arrivees = boite_d_arrivee(uid_demandeur, espace, utilisateur)

    runtime = dossier_runtime(utilisateur.pw_uid, utilisateur)
    depot = dossier_depot(nom, uid_demandeur, utilisateur.pw_uid)
    presentes = []
    for source_nom, fichier in comptes.passages(affichage, son):
        source = comptes.socket_du_bureau(uid_demandeur, source_nom)
        if not os.path.exists(source):
            continue        # le son peut manquer : ce n'est pas une erreur
        destination = os.path.join(runtime, fichier)
        presenter(source, destination)
        droit_sur_socket(source, utilisateur.pw_uid, accorder=True)
        presentes.append(fichier)
    # La carte graphique, quand l'Espace y a droit. Le droit est nominatif et
    # temporaire, comme celui que logind donne à une session d'utilisateur :
    # sans lui, l'Espace dessine avec le processeur (mesuré le 15/09/2026).
    # Seuls les nœuds de RENDU sont accordés : « card0 » pilote l'écran, et
    # une application n'a pas à changer les modes d'affichage.
    for chemin_carte in (cartes_presentes() if carte else []):
        droit_sur_socket(chemin_carte, utilisateur.pw_uid, accorder=True)
        presentes.append(os.path.basename(chemin_carte))
    ouvert = OUVERTS.get(nom)
    if ouvert and ouvert[0].poll() is None:
        # Déjà ouvert : on ne relance rien. Redémarrer la portée ici fermerait
        # les fenêtres que l'utilisateur a sous les yeux.
        journal("Espace %s déjà ouvert : rien à relancer" % nom)
    else:
        # Portée laissée par un service qui a redémarré : elle ne contient plus
        # rien que nous sachions suivre, et son nom est pris.
        arreter_portee(nom)
        memoire, taches = comptes.plafonds_valides(memoire, taches)
        if ephemere:
            monter_jetable(home, utilisateur, memoire)
        srv = socket_d_ordres(depot)
        try:
            OUVERTS[nom] = (premier_processus(utilisateur, uid_demandeur, srv,
                                              memoire, taches, affichage), srv)
        except OSError:
            srv.close()
            raise
        journal("Espace %s lancé sous plafond (%s, %d tâches)"
                % (nom, memoire, taches))
    journal("Espace %s prêt pour l'UID %d : %s" % (nom, uid_demandeur,
                                                   ", ".join(presentes) or "aucun socket"))
    return {"ok": True, "compte": nom, "uid": utilisateur.pw_uid,
            "gid": utilisateur.pw_gid, "home": home,
            "runtime": runtime, "depot": depot, "presentes": presentes,
            "ordres": os.path.join(depot, comptes.SOCKET_EXEC),
            "envois": envois, "arrivees": arrivees}


def fermer(uid_demandeur, espace):
    nom = comptes.nom_compte(uid_demandeur, espace)
    try:
        utilisateur = pwd.getpwnam(nom)
    except KeyError:
        return {"ok": True}
    # L'Espace s'arrête AVANT qu'on lui retire ses sockets : dans l'autre
    # ordre, ses applications verraient l'affichage disparaître sous elles.
    ouvert = OUVERTS.pop(nom, None)
    if ouvert:
        ouvert[1].close()
        ouvert[0].terminate()
        try:
            ouvert[0].wait(timeout=10)
        except subprocess.TimeoutExpired:
            ouvert[0].kill()
    arreter_portee(nom)
    # Chaque étape est tentée même si la précédente a échoué — un montage
    # récalcitrant ne doit pas empêcher de retirer le droit sur le socket, qui
    # est la vraie barrière — mais aucun échec n'est tu.
    echecs = []
    # Un Espace jetable : son tmpfs part maintenant, et son contenu avec lui.
    home = comptes.chemin_home(uid_demandeur, espace)
    if os.path.ismount(home):
        demontage = subprocess.run(["/usr/bin/umount", home], capture_output=True, text=True)
        if demontage.returncode != 0:
            # Encore utilisé par un processus qu'on n'a pas su arrêter : on le
            # détache quand même — le contenu disparaîtra avec lui — mais on
            # le dit.
            subprocess.run(["/usr/bin/umount", "--lazy", home], capture_output=True)
            echecs.append("jetable détaché en différé : %s" % demontage.stderr.strip())
    runtime = comptes.chemin_runtime(utilisateur.pw_uid)
    if os.path.isdir(runtime):
        # Le dossier ne contient plus seulement ce que root y a présenté :
        # l'Espace y a posé ses propres fichiers (le bus, « .dbus-proxy »,
        # « .flatpak »). On démonte ce qui est monté, puis on efface le reste.
        for fichier in sorted(os.listdir(runtime)):
            chemin = os.path.join(runtime, fichier)
            if not os.path.ismount(chemin):
                continue        # un fichier de l'Espace : il partira avec le dossier
            echec = retirer(chemin)
            if echec:
                echecs.append("%s, %s" % (fichier, echec))
            source = os.path.join("/run/user/%d" % uid_demandeur, fichier)
            if os.path.exists(source):
                try:
                    droit_sur_socket(source, utilisateur.pw_uid, accorder=False)
                except subprocess.CalledProcessError as exc:
                    # Le plus grave des échecs possibles ici : le compte de
                    # l'Espace garderait l'accès au socket du bureau.
                    echecs.append("%s, DROIT NON RETIRÉ : %s" % (
                        fichier, (exc.stderr or b"").decode("utf-8", "replace").strip()))
        # rmtree sur un dossier écrit par un AUTRE compte : on ne s'y risque
        # que si Python garantit la traversée sans suivre les liens, comme
        # pour la suppression d'un Espace.
        _retirer_les_cartes(utilisateur, echecs)
        st = os.lstat(runtime)
        if not shutil.rmtree.avoids_symlink_attacks:
            echecs.append("dossier d'exécution conservé : suppression sûre "
                          "indisponible sur ce système")
        elif os.path.islink(runtime) or st.st_uid != utilisateur.pw_uid:
            # Troisième barrière, après comptes.chemin_runtime et AppArmor :
            # on n'efface que ce qui appartient au compte de CET Espace.
            echecs.append("dossier d'exécution conservé : il n'appartient pas "
                          "à %s (UID %d)" % (nom, st.st_uid))
        else:
            restes = []
            shutil.rmtree(runtime, onexc=lambda *a: restes.append(a[1]))
            if os.path.exists(runtime):
                echecs.append("dossier d'exécution conservé : %s"
                              % (restes[-1] if restes else "cause inconnue"))
    vider_depot(comptes.chemin_depot(nom))
    if echecs:
        for echec in echecs:
            journal("fermeture incomplète de %s : %s" % (nom, echec))
        return {"ok": False, "erreur": "incomplet"}
    journal("Espace %s refermé" % nom)
    return {"ok": True}


def supprimer(uid_demandeur, espace):
    """Retire le compte d'un Espace supprimé, et ce que root lui avait préparé.

    Le lanceur a fait effacer les données PAR l'Espace avant de demander ceci :
    root ne devrait trouver que des dossiers vides. S'il en reste, shutil.rmtree
    les retire sans jamais suivre un lien — et on refuse d'y aller si Python ne
    le garantit pas sur ce système.

    Le compte part en DERNIER : un compte supprimé avant ses fichiers les
    laisserait sans propriétaire, et le prochain compte créé avec le même
    numéro les retrouverait.
    """
    nom = comptes.nom_compte(uid_demandeur, espace)
    reponse = fermer(uid_demandeur, espace)
    TENUES.oublier(nom)
    echecs = [] if reponse.get("ok") else ["fermeture incomplète"]
    if not shutil.rmtree.avoids_symlink_attacks:
        return {"ok": False, "erreur": "impossible"}
    for chemin in (comptes.chemin_home(uid_demandeur, espace),
                   comptes.chemin_envois(uid_demandeur, espace),
                   comptes.chemin_arrivees(uid_demandeur, espace)):
        if os.path.islink(chemin):
            echecs.append("lien refusé : %s" % chemin)
        elif os.path.isdir(chemin):
            try:
                shutil.rmtree(chemin)
            except OSError as exc:
                echecs.append("%s : %s" % (chemin, exc))
    if not echecs:
        try:
            pwd.getpwnam(nom)
        except KeyError:
            pass
        else:
            retrait = subprocess.run(["/usr/sbin/userdel", nom],
                                     capture_output=True, text=True)
            if retrait.returncode != 0:
                echecs.append("compte non retiré : %s" % retrait.stderr.strip())
    for echec in echecs:
        journal("suppression incomplète de %s : %s" % (nom, echec))
    if echecs:
        return {"ok": False, "erreur": "incomplet"}
    journal("Espace %s supprimé, compte retiré" % nom)
    return {"ok": True}


def traiter(demande, uid, nom_demandeur):
    """Décide, puis agit. Toute erreur devient un refus sans détail.

    Appelé SOUS VERROU : préparer et fermer touchent des montages, des droits
    et la table des Espaces ouverts, et deux lanceurs du même Espace arrivent
    volontiers ensemble.
    """
    autorise, raison = comptes.demandeur_autorise(uid, nom_demandeur)
    if not autorise:
        journal("demande refusée (%s) : %s" % (nom_demandeur or uid, raison))
        return {"ok": False, "erreur": "refusé"}
    action = demande.get("action")
    espace = demande.get("espace")
    try:
        # « ouvrir » prépare comme « preparer », mais la connexion reste tenue
        # par le lanceur tant que son application vit (voir servir_client).
        if action in ("preparer", "ouvrir"):
            return preparer(uid, espace, demande.get("affichage", "wayland-0"),
                            bool(demande.get("son")),
                            demande.get("memoire"), demande.get("taches"),
                            # « is True » : seul un vrai booléen JSON monte un
                            # tmpfs, pas une chaîne ni un nombre.
                            demande.get("ephemere") is True,
                            # Pas de carte graphique par défaut : un Espace
                            # qui n'en demande pas n'y touche jamais (Banque
                            # et Jetable, par exemple).
                            demande.get("carte") is True)
        if action == "fermer":
            reponse = fermer(uid, espace)
            TENUES.oublier(comptes.nom_compte(uid, espace))
            return reponse
        if action == "supprimer":
            return supprimer(uid, espace)
    except (ValueError, OSError, subprocess.CalledProcessError) as exc:
        journal("échec pour l'UID %d (%s) : %s" % (uid, action, exc))
        return {"ok": False, "erreur": "impossible"}
    return {"ok": False, "erreur": "action inconnue"}


def tenir(client, uid, espace, jeton):
    """Garde l'Espace ouvert tant que le lanceur garde la connexion.

    C'est le NOYAU qui ferme la connexion quand le lanceur s'arrête — qu'il
    finisse proprement, soit tué, ou plante. Un compteur tenu par des messages
    « j'ai fini » fuirait au premier plantage, et l'Espace resterait ouvert,
    son compte gardant l'accès à l'affichage, jusqu'au redémarrage.
    """
    client.settimeout(None)
    try:
        while client.recv(64):
            pass            # le lanceur n'a rien à dire ; seule la fin compte
    except OSError:
        pass
    with VERROU:
        if not TENUES.rendre(jeton):
            return
        try:
            reponse = fermer(uid, espace)
        except (ValueError, OSError, subprocess.CalledProcessError) as exc:
            journal("fermeture de %s après la dernière application : %s"
                    % (jeton[0], exc))
            return
        if not reponse.get("ok"):
            journal("fermeture incomplète de %s après la dernière application"
                    % jeton[0])


def servir_client(client):
    with client:
        try:
            client.settimeout(10)
            uid, nom = demandeur(client)
            brut = client.recv(TAILLE_MAX)
            try:
                demande = json.loads(brut.decode("utf-8", "replace"))
                if not isinstance(demande, dict):
                    raise ValueError
            except ValueError:
                client.sendall(b'{"ok": false, "erreur": "demande illisible"}\n')
                return
            jeton = None
            with VERROU:
                reponse = traiter(demande, uid, nom)
                if demande.get("action") == "ouvrir" and reponse.get("ok"):
                    # Pris sous le MÊME verrou que la préparation : aucune
                    # fermeture ne peut se glisser entre les deux.
                    jeton = TENUES.prendre(reponse["compte"])
                    if jeton is None:
                        journal("trop d'applications ouvertes : ouverture refusée")
                        reponse = {"ok": False, "erreur": "trop"}
            client.sendall((json.dumps(reponse) + "\n").encode("utf-8"))
            if jeton is not None:
                tenir(client, uid, demande.get("espace"), jeton)
        except OSError:
            pass


def au_repos():
    """Plus aucun Espace ouvert, et plus personne qui en tienne un.

    S'arrêter pendant qu'un Espace vit serait le pire moment : ce service est
    le seul à savoir quels Espaces sont ouverts, et le suivant, ne le sachant
    plus, arrêterait leur portée en croyant faire le ménage — fermant sous les
    yeux de l'utilisateur ce qu'il avait ouvert.
    """
    with VERROU:
        vivants = [nom for nom, (proc, _s) in OUVERTS.items() if proc.poll() is None]
        return not vivants and TENUES.total() == 0


def servir(srv, repos=None):
    if repos:
        srv.settimeout(repos)
    while True:
        try:
            client, _ = srv.accept()
        except TimeoutError:
            # Sous-classe d'OSError : à attraper AVANT elle, sinon le service
            # s'arrêterait à chaque attente au lieu de se rendormir.
            if au_repos():
                journal("plus aucun Espace ouvert : le service s'arrête")
                return 0
            continue
        except OSError:
            return 0
        if threading.active_count() > TENUES.maximum + 16:
            client.close()          # garde-fou : root ne se laisse pas noyer
            continue
        threading.Thread(target=servir_client, args=(client,), daemon=True).start()


def main(argv):
    if os.geteuid() != 0:
        sys.stderr.write("codebyr-uid : service réservé à l'administrateur.\n")
        return 2
    syslog.openlog("codebyr-uid", syslog.LOG_PID, syslog.LOG_DAEMON)
    racines()
    try:
        ranger_les_anciennes_passerelles()
    except Exception as exc:
        # Un rangement raté ne doit pas empêcher tout Espace de s'ouvrir :
        # on le dit, et on sert quand même.
        journal("rangement des anciennes passerelles impossible : %s" % exc)
    if len(argv) >= 3 and argv[1] == "--essai":
        chemin = argv[2]
        if os.path.exists(chemin):
            os.unlink(chemin)
        srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        srv.bind(chemin)
        os.chmod(chemin, 0o666)
        srv.listen(8)
        journal("service d'essai sur %s" % chemin)
    else:
        # Activation par socket : systemd passe la socket déjà en écoute.
        if os.environ.get("LISTEN_FDS") != "1":
            sys.stderr.write("codebyr-uid : lancé par systemd (codebyr-uid.socket).\n")
            return 2
        srv = socket.socket(fileno=3)
        # Le repos ne vaut que lancé par systemd : lui seul sait relancer le
        # service à la connexion suivante. En essai, le service est lancé à la
        # main, et doit rester tant qu'on l'éprouve.
        return servir(srv, repos=DELAI_REPOS)
    return servir(srv)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
