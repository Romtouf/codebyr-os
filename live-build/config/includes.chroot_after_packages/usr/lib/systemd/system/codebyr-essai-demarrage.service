# Codebyr OS — essai de démarrage de l'image, pour la CI (construire-iso.yml).
# Inerte sans « codebyr.essai=1 » sur la ligne du noyau, que seule la CI pose ;
# retiré du système installé par codebyr-nettoyage-installation.
[Unit]
Description=Codebyr OS — essai de démarrage (CI)
ConditionKernelCommandLine=codebyr.essai=1
After=graphical.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/codebyr-essai-demarrage
# Un port série à lui seul : sur ttyS0, la console du noyau, systemd ouvre une
# invite de connexion qui, en prenant le port, coupe la parole à l'essai.
StandardOutput=tty
StandardError=tty
TTYPath=/dev/ttyS1
TTYReset=no
TTYVHangup=no
TimeoutStartSec=40min

[Install]
WantedBy=graphical.target
