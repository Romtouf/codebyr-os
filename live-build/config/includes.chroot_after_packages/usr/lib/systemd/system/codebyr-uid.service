[Unit]
Description=Comptes d'Espaces Codebyr
Documentation=file:/usr/share/codebyr/comptes.py
Requires=codebyr-uid.socket
After=codebyr-uid.socket

[Service]
ExecStart=/usr/lib/codebyr/codebyr-uid
# Démarré à la demande, à la première ouverture d'Espace : rien ne tourne tant
# que personne n'en ouvre.
#
# AUCUN DURCISSEMENT D'UNITÉ ICI, et c'est délibéré. Deux raisons, qui tiennent
# toutes deux à ce que ce service n'est pas une feuille : ce qu'on lui impose,
# les applications des Espaces l'héritent.
#
# · TOUT CE QUI PASSE PAR SECCOMP EST HÉRITÉ. Un filtre seccomp survit au fork,
#   à l'exec, et au passage dans la portée de l'Espace. MemoryDenyWriteExecute=
#   aurait interdit au navigateur d'un Espace de compiler son JavaScript ;
#   RestrictAddressFamilies= lui aurait coupé le réseau ;
#   SystemCallArchitectures= aurait refusé tout programme 32 bits.
#
# · TOUT CE QUI PASSE PAR UN ESPACE DE NOMS DE MONTAGE cache les montages que
#   ce service pose. ProtectKernelTunables=, ProtectHome=, PrivateTmp= en
#   créent un : la passerelle d'un Espace y serait montée pour le service seul,
#   et l'Espace n'y verrait rien — sans le moindre message d'erreur.
#
# NoNewPrivileges= n'y est pas non plus, pour une troisième raison : sur un
# service qui tourne en root il n'interdit rien de réel, et il empêche les
# transitions de profil AppArmor (« Ux »), dont celle par laquelle un Espace
# sort du confinement de ce service. Le premier processus d'un Espace, lui, le
# reçoit de setpriv, en même temps qu'il abandonne ses privilèges.
#
# Ce qui confine ce service est donc son profil AppArmor
# (/etc/apparmor.d/codebyr-uid) : il borne les chemins qu'il écrit et les
# programmes qu'il lance, sans rien imposer aux applications des Espaces.
#
# Et ce qui le protège vraiment n'est ni l'un ni l'autre : c'est qu'il refuse
# tout chemin et toute commande venant du client, et qu'il n'obéit qu'à un
# compte d'utilisateur du bureau (voir comptes.py).

[Install]
WantedBy=multi-user.target
