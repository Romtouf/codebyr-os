[Desktop Entry]
Type=Application
Name=Install Codebyr OS
Name[fr]=Installer Codebyr OS
Comment=Install Codebyr OS on this disk
Comment[fr]=Installer Codebyr OS sur ce disque
Exec=codebyr-installer
TryExec=calamares
Icon=io.codebyr.Installer
Terminal=false
Categories=System;
Keywords=install;installer;calamares;disk;
Keywords[fr]=install;installer;calamares;disque;
StartupNotify=true
# La fenêtre de Calamares porte la classe « calamares ». Sans cette ligne,
# GNOME la rattachait au lanceur caché de Debian (« Install Debian »), et
# affichait son icône — un losange bleu — dans le dock, la vue d'ensemble et
# Alt+Tab pendant toute l'installation.
StartupWMClass=calamares
