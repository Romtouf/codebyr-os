# Codebyr OS — réglages GNOME par défaut
# Compilé par le hook de branding. Ces valeurs sont les défauts ;
# l'utilisateur reste libre de tout changer.

[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/codebyr/codebyr-clair.png'
picture-uri-dark='file:///usr/share/backgrounds/codebyr/codebyr-sombre.png'
picture-options='zoom'
primary-color='#0B1419'
secondary-color='#0B1419'

[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/codebyr/codebyr-sombre.png'
picture-options='zoom'
primary-color='#0B1419'

[org.gnome.desktop.interface]
# Accent GNOME = « Sentinelle » (le teal de Codebyr)
accent-color='teal'
color-scheme='default'
enable-hot-corners=true

[org.gnome.desktop.wm.preferences]
# Boutons Réduire / Agrandir / Fermer (GNOME les cache par défaut — inacceptable
# pour un OS grand public, surtout venant de Windows).
button-layout='appmenu:minimize,maximize,close'

[org.gnome.desktop.input-sources]
# Clavier AZERTY (français) par défaut.
sources=[('xkb', 'fr')]
# Verr. Maj à la manière de Windows : il agit comme Maj sur TOUTES les touches,
# pas seulement sur les lettres — Verr. Maj + « & » donne « 1 », + « ; » donne
# « . ». C'est le geste de qui vient de Windows pour taper des chiffres.
# Vaut pour la session et pour l'écran de connexion. La console et la saisie
# de la phrase de passe du disque suivent /etc/default/keyboard (posé à
# l'installation, voir codebyr-nettoyage-installation).
xkb-options=['caps:shiftlock']

[org.gnome.shell]
favorite-apps=['io.codebyr.Assistant.desktop', 'firefox-esr.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Software.desktop', 'org.gnome.Console.desktop', 'org.gnome.Settings.desktop']
enabled-extensions=['codebyr@codebyr.io', 'dash-to-dock@micxgx.gmail.com']
disable-user-extensions=false

[org.gnome.shell.extensions.dash-to-dock]
# Le dock, toujours visible en bas de l'écran : qui vient de Windows y retrouve
# ses applications sans ouvrir la vue d'ensemble. Sous chaque application
# ouverte, l'extension Codebyr pose une pastille par fenêtre, à la couleur de
# son Espace : c'est pourquoi le dock garde l'indicateur de GNOME (« DEFAULT »),
# que l'extension remplace, plutôt que ses propres points.
dock-position='BOTTOM'
dock-fixed=true
intellihide=false
autohide=false
extend-height=false
dash-max-icon-size=48
running-indicator-style='DEFAULT'
show-trash=false
show-mounts=false
# Un clic sur une application ouverte dans plusieurs Espaces montre ses
# fenêtres, pour choisir la bonne.
click-action='focus-or-previews'
# Super+1… reste le raccourci de GNOME, et la session s'ouvre sur le bureau.
hot-keys=false
disable-overview-on-startup=true

[org.gnome.login-screen]
# Logo affiché sur l'écran de connexion / déverrouillage (le Sceau, pas Debian)
logo='/usr/share/backgrounds/codebyr/codebyr-logo.png'

