// Codebyr OS — thème Plymouth (langage script Plymouth)
// Fond noir bleuté #080F14, le Sceau centré avec une pulsation douce,
// et une invite de déverrouillage pour le disque chiffré (LUKS).
//
// ── POURQUOI DES VARIABLES « global » ───────────────────────────────────────
// Dans le langage de Plymouth, une variable affectée DANS une fonction est
// locale : ses images et ses sprites sont détruits au retour de la fonction,
// donc jamais dessinés. L'invite de déverrouillage était bien demandée par le
// système — « Please unlock disk luks-… » apparaissait en appuyant sur Échap —
// mais l'écran graphique, lui, restait muet : l'utilisateur voyait une machine
// figée, sans aucun moyen de deviner qu'il fallait taper quelque chose.
//
// ── MISE EN PAGE ────────────────────────────────────────────────────────────
// Une seule chose à lire à la fois. Pendant la saisie, le libellé « codebyr OS »
// s'efface et le bloc de déverrouillage prend sa place : sinon les deux textes
// se chevauchaient, chacun placé de son côté sans se savoir voisins.
// Toutes les hauteurs découlent du logo, jamais de valeurs devinées.
//
// ── LA TAILLE DE L'ÉCRAN CHANGE EN COURS DE ROUTE ───────────────────────────
// Plymouth démarre sur l'affichage du micrologiciel ; le pilote graphique
// prend ensuite la main, souvent dans une autre résolution. Les positions,
// calculées une fois au départ, restaient celles de l'ancien écran : le logo
// et son libellé glissaient vers la gauche pendant le chargement. Tout est
// donc replacé dès que la taille change —
// TOUT : le logo et son libellé d'abord (1.17.2~essai1), mais aussi le message
// du bas et l'invite. Le message « cryptsetup: … set up successfully » arrive
// juste avant le changement de définition, et glissait encore (même jour) ;
// il est tu depuis (voir les messages système, en fin de fichier).

// ── LANGUE ──────────────────────────────────────────────────────────────────
// Ce script est le thème français. Le langage de Plymouth ne sait rien de la
// langue du système : la construction du paquet en produit donc un thème par
// langue traduite (codebyr-en…), où chaque traduire("…") reçoit sa traduction
// (packaging/traductions.py), et codebyr-durcir-poste choisit le thème selon
// la langue du système.
fun traduire(texte) {
	return texte;
}

Window.SetBackgroundTopColor(0.031, 0.059, 0.078);
Window.SetBackgroundBottomColor(0.031, 0.059, 0.078);

// — Le Sceau —
logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);

// — Libellé « codebyr OS » —
label.image = Image.Text("codebyr OS", 0.90, 0.93, 0.96);
label.sprite = Sprite(label.image);

interligne = 34;

// Place le logo et le libellé au centre de l'écran tel qu'il est MAINTENANT.
// Première ligne de texte, juste sous le logo : le libellé du produit au
// repos, le titre de l'invite pendant la saisie.
fun placer() {
	global.screen_w = Window.GetWidth();
	global.screen_h = Window.GetHeight();
	global.logo_y = global.screen_h / 2 - logo.image.GetHeight() / 2 - 24;
	logo.sprite.SetPosition(global.screen_w / 2 - logo.image.GetWidth() / 2, global.logo_y, 0);
	global.ligne_1 = global.logo_y + logo.image.GetHeight() + 22;
	label.sprite.SetPosition(global.screen_w / 2 - label.image.GetWidth() / 2, global.ligne_1, 0);
}
placer();

// — Pulsation du logo, suspendue pendant la saisie —
global.saisie = 0;
global.message_affiche = 0;
progress = 0;
fun refresh_callback() {
	if (Window.GetWidth() != global.screen_w || Window.GetHeight() != global.screen_h) {
		placer();
		// Ce qui est déjà à l'écran est redessiné à sa place dans le nouvel
		// écran, avec le même contenu.
		if (global.message_affiche == 1) {
			message_callback(global.message_texte);
		}
		if (global.saisie == 1) {
			display_password_callback(global.invite_texte, global.invite_nb_puces);
		}
	}
	progress++;
	if (global.saisie == 1) {
		logo.sprite.SetOpacity(1);
	} else {
		logo.sprite.SetOpacity(0.55 + 0.45 * Math.Sin(progress / 18));
	}
}
Plymouth.SetRefreshFunction(refresh_callback);

// — Une ligne de texte centrée, rendue à la hauteur demandée —
fun ligne(texte, r, v, b, y) {
	image = Image.Text(texte, r, v, b);
	sprite = Sprite(image);
	sprite.SetPosition(screen_w / 2 - image.GetWidth() / 2, y, 10);
	sprite.SetOpacity(1);
	return sprite;
}

fun effacer_invite() {
	global.invite_titre = NULL;
	global.invite_aide = NULL;
	global.invite_puces = NULL;
}

// — Invite de déverrouillage (LUKS) —
//
// Le texte de cryptsetup (« Please unlock disk luks-c3a5a056-… ») est en
// anglais et se termine par un identifiant illisible : on écrit le nôtre.
fun display_password_callback(prompt, puces) {
	global.saisie = 1;
	global.invite_texte = prompt;
	global.invite_nb_puces = puces;
	label.sprite.SetOpacity(0);       // le libellé cède la place

	global.invite_titre = ligne(traduire("Phrase de passe du disque"),
	                            0.90, 0.93, 0.96, ligne_1);

	chaine = "";
	for (i = 0; i < puces; i++) {
		chaine = chaine + "●";
	}
	if (chaine == "") {
		global.invite_puces = NULL;
	} else {
		global.invite_puces = ligne(chaine, 0.26, 0.73, 0.85,
		                            ligne_1 + interligne);
	}

	global.invite_aide = ligne(traduire("Tapez-la, puis appuyez sur Entrée"),
	                           0.55, 0.62, 0.68, ligne_1 + 2 * interligne);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

// — Retour à l'écran ordinaire : l'invite disparaît, le libellé revient —
fun display_normal_callback() {
	global.saisie = 0;
	effacer_invite();
	label.sprite.SetOpacity(1);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

// — Messages système (fsck, phrase de passe refusée…) —
// Placés en bas, hors du bloc de déverrouillage.
//
// Ceux de cryptsetup sont en anglais et portent le nom du volume
// (« cryptsetup: luks-f49e6cb5-…: set up successfully ») : du texte technique,
// entre le logo et l'écran de connexion. Le succès est tu — l'invite qui
// s'efface et le démarrage qui reprend le disent déjà. Les deux refus qu'on
// peut rencontrer sont dits dans la langue du système. Tout autre message
// passe tel quel : rare, et précieux à qui dépanne.
//
// Les textes de cryptsetup viennent de Debian 13 (cryptsetup-initramfs,
// scripts/local-top/cryptroot) ; s'ils changeaient, le message anglais
// d'origine reviendrait — rien de pire.
//
// Le langage de Plymouth ne lit une chaîne qu'à travers String(…) : écrire
// texte.Length() remplacerait la variable par un objet vide.
fun commence_par(texte, debut) {
	return String(texte).SubString(0, String(debut).Length()) == debut;
}

fun finit_par(texte, fin) {
	n = String(texte).Length();
	k = String(fin).Length();
	if (n < k) {
		return 0;
	}
	return String(texte).SubString(n - k, n) == fin;
}

fun message_callback(texte) {
	global.message_texte = texte;
	if (commence_par(texte, "cryptsetup: ") && finit_par(texte, ": set up successfully")) {
		global.message_affiche = 0;
		global.message = NULL;
	} else {
		if (commence_par(texte, "cryptsetup: ERROR: ")
		    && finit_par(texte, ": cryptsetup failed, bad password or options?")) {
			texte = traduire("Phrase de passe incorrecte. Réessayez.");
		}
		if (commence_par(texte, "cryptsetup: ERROR: ")
		    && finit_par(texte, ": maximum number of tries exceeded")) {
			texte = traduire("Trop d'essais. Redémarrez l'ordinateur pour réessayer.");
		}
		global.message_affiche = 1;
		global.message = ligne(texte, 0.6, 0.66, 0.72, screen_h - 64);
	}
}
Plymouth.SetMessageFunction(message_callback);
