# Codebyr OS — composants propres à la distribution

# Écran de démarrage brandé (thème Plymouth « codebyr »)
plymouth
plymouth-themes
plymouth-label

# Outils utilisés par les hooks de branding (rasterisation du logo, etc.)
librsvg2-bin

# Administration (compte user de la session live)
sudo

# notify-send : le seul moyen, pour un script shell, de dire quelque chose à
# l'utilisateur d'un bureau. Sans lui, un refus poli (« ce système est déjà
# installé ») se perd dans un fichier de journal que personne n'ouvrira.
libnotify-bin

# Phase 2 — isolation des Espaces (bubblewrap)
bubblewrap

# setfacl : le service des comptes d'Espaces prête l'affichage et la carte
# graphique à un Espace par un droit nominatif. Présent jusqu'ici par ricochet
# (colord, libsane1) — dépendance du paquet codebyr-tools depuis la 1.16.1.
acl

# Ouvre, une fois le système démarré, les volumes chiffrés de /etc/crypttab
# autres que le disque principal — l'espace d'échange. Sorti de systemd dans
# un paquet à part par Debian 13 ; absent, l'espace d'échange ne s'ouvrait
# jamais et chaque démarrage l'attendait 90 secondes (constaté le 28/09/2026).
systemd-cryptsetup

# Bus de session PRIVÉ par Espace (dbus-run-session). Load-bearing pour la
# sécurité : le bus de session de l'hôte n'est plus exposé au bac à sable, ce
# bus privé est donc le seul que voit l'application. Listé explicitement car
# --apt-recommends false ne pardonne rien.
dbus-user-session

# Langues : support multilingue complet (comme une distro haut de gamme)
# locales-all = TOUTES les langues disponibles ; français par défaut (hook 0600).
locales
locales-all
firefox-esr-l10n-fr
# Polices pour que tous les alphabets s'affichent (latin, cyrillique, grec,
# arabe, hébreu, thaï, indien… + chinois/japonais/coréen).
fonts-noto-core
fonts-noto-cjk
fonts-noto-color-emoji

# NOTE Phase 2 : codebyr-spaced et codebyr-shell (gestion des Espaces)
# seront ajoutés ici une fois empaquetés.
