# Installeur graphique Calamares + socle Debian éprouvé (séquence de modules)
calamares
calamares-settings-debian

# Le diaporama de l'installation (branding/debian/show.qml). Calamares 3.3 est
# construit avec Qt 6, et calamares-settings-debian ne tire que les modules QML
# de Qt 5 : sans ceux-ci, le diaporama ne se charge pas et reste blanc.
qml6-module-qtquick
qml6-module-qtquick-window

# Contrôle de qualité des mots de passe (libpwquality exige ce dictionnaire ;
# sans lui, TOUT mot de passe est rejeté avec « error loading dictionary »)
cracklib-runtime

# Copie du système sur le disque (module unpackfs : décompresse le squashfs)
squashfs-tools

# Enregistrement de l'entrée de démarrage UEFI (appelé par grub-install)
efibootmgr

# Outils de partitionnement / chiffrement requis par l'installeur
# (keyutils : exigé par le helper bootloader-config en cas de LUKS)
cryptsetup
cryptsetup-initramfs
keyutils

# Clavier AZERTY au déverrouillage du disque chiffré. Sans console-setup (qui
# tire kbd et keyboard-configuration), l'initramfs ne peut charger aucune
# disposition : si l'écran graphique échoue, la phrase de passe se tape en
# QWERTY. Voir etc/initramfs-tools/conf.d/codebyr-clavier. La disposition « fr »
# reste fixée après coup par le hook 0500-debrand et par Calamares.
console-setup
kbd
dosfstools
e2fsprogs
os-prober
parted

# Amorçage posé par Calamares dans le système cible.
# (Recommends désactivés au build → on liste tout explicitement.)
grub-common
grub2-common
grub-pc-bin
grub-efi-amd64-bin
grub-efi-amd64-signed
shim-signed

# Root GUI fiable via XWayland (xhost autorise root sur l'affichage)
x11-xserver-utils
