#!/bin/sh
# Codebyr OS — post-installation de codebyr-tools.
set -e

case "$1" in
	configure)
		# Les scripts codebyr-* doivent être exécutables (ceinture + bretelles).
		for f in /usr/bin/codebyr-*; do
			[ -f "$f" ] && chmod 755 "$f" || true
		done

		# Identité du système : /etc/os-release doit désigner la copie livrée
		# par ce paquet (voir le preinst). Les images jusqu'à la 1.16.0 en
		# faisaient un fichier ordinaire, figé à la version de l'ISO et à un
		# domaine qui n'existe pas (codebyr.io) — et c'est lui que les outils
		# lisent en premier. On rétablit le lien que Debian livre, à la seule
		# condition que la copie Codebyr soit bien là.
		#
		# Écrit à côté puis déplacé : rename() remplace le fichier d'un coup,
		# jamais un instant sans identité.
		if [ ! -L /etc/os-release ] && grep -q '^ID=codebyr$' /usr/lib/os-release 2>/dev/null; then
			rm -f /etc/os-release.codebyr-neuf
			ln -s ../usr/lib/os-release /etc/os-release.codebyr-neuf
			mv -f /etc/os-release.codebyr-neuf /etc/os-release
		fi
		# L'extension GNOME est déjà activable par l'utilisateur ; on ne force
		# rien ici (pas de session graphique garantie pendant apt). Un
		# rechargement de l'extension nécessite une reconnexion — signalé au
		# besoin par GNOME lui-même.
		if command -v update-desktop-database >/dev/null 2>&1; then
			update-desktop-database -q /usr/share/applications 2>/dev/null || true
		fi
		# Cache d'icônes. Dès qu'un cache existe, GTK s'y fie et IGNORE les
		# fichiers qui n'y figurent pas : une icône livrée par ce paquet
		# resterait invisible, remplacée par l'icône générique du bureau — un
		# losange gris dans le dock et la vue d'ensemble. Constaté le
		# 13/09/2026 sur une machine où une installation apt avait créé le
		# cache avant que l'icône n'arrive.
		#
		# L'image, elle, n'a aucun cache : GTK y parcourt les dossiers, et les
		# icônes s'affichent sans rien faire.
		if [ -x /usr/sbin/update-icon-caches ]; then
			/usr/sbin/update-icon-caches /usr/share/icons/hicolor 2>/dev/null || true
		elif command -v gtk-update-icon-cache >/dev/null 2>&1; then
			gtk-update-icon-cache -f /usr/share/icons/hicolor 2>/dev/null || true
		fi
		# Trousseau apt : la clé publique du projet évolue (ajout d'une
		# sous-clé de signature, rotation). Le trousseau, lui, a été figé à
		# l'installation — et apt refuse alors une signature parfaitement
		# légitime : « Missing key …, which is needed to verify signature ».
		# Le paquet embarque donc la clé à jour et rafraîchit le trousseau.
		#
		# Ce n'est pas une porte ouverte : ce paquet est déjà signé par cette
		# même clé. Qui peut le remplacer contrôle déjà la machine.
		CLE=/usr/share/codebyr/codebyr-signing-key.asc
		TROUSSEAU=/usr/share/keyrings/codebyr-archive-keyring.gpg
		if [ -f "$CLE" ] && command -v gpg >/dev/null 2>&1; then
			# On écrit à côté puis on déplace : un trousseau à moitié écrit
			# rendrait le dépôt invérifiable, donc la machine non maintenable.
			if gpg --dearmor < "$CLE" > "$TROUSSEAU.neuf" 2>/dev/null; then
				chmod 0644 "$TROUSSEAU.neuf"
				mv "$TROUSSEAU.neuf" "$TROUSSEAU"
			else
				rm -f "$TROUSSEAU.neuf"
			fi
		fi

		# Réglages noyau : un fichier dans /etc/sysctl.d n'est lu qu'au
		# démarrage. Sans cette ligne, la protection arriverait avec la mise à
		# jour mais n'agirait qu'au prochain redémarrage — des jours ou des
		# semaines plus tard sur un portable qu'on met en veille.
		# « || true » : dans un conteneur ou un chroot, le noyau refuse ; ce
		# n'est pas une raison de faire échouer la mise à jour.
		#
		# Chemin absolu : systemd-sysctl n'est PAS dans le PATH sur Debian
		# (/usr/lib/systemd). Un « command -v » le cherchait en vain, la
		# condition restait fausse, et rien ne s'appliquait avant le
		# redémarrage — sans la moindre trace.
		SYSCTL_CODEBYR=/etc/sysctl.d/91-codebyr-noyau.conf
		if [ -f "$SYSCTL_CODEBYR" ] && [ -x /usr/lib/systemd/systemd-sysctl ]; then
			/usr/lib/systemd/systemd-sysctl "$SYSCTL_CODEBYR" 2>/dev/null || true
		fi

		# Le démarrage selon Codebyr : options du noyau
		# (/etc/default/grub.d/90-codebyr-noyau.cfg), menu caché et silence
		# (91-codebyr-demarrage.cfg, /etc/grub.d/35_codebyr_menu et
		# /etc/grub.d/10_linux). Rien n'agit avant d'être inscrit dans la
		# configuration de GRUB (/boot/grub/grub.cfg), puis au redémarrage.
		#
		# On ne la régénère que si ces fichiers ont changé depuis la dernière
		# fois (empreinte gardée dans /var/lib/codebyr, comme pour l'écran de
		# démarrage), ou si grub.cfg ne porte pas les options du noyau : pas à
		# chaque mise à jour. Surtout pas en comparant les dates — dpkg donne
		# aux fichiers celle du PAQUET : sur une machine dont le noyau a été
		# mis à jour depuis, grub.cfg serait « plus récent » et rien
		# n'arriverait jamais. Ni dans un chroot de construction ni sur le live
		# (pas de /boot/grub/grub.cfg) : là, l'installeur régénère GRUB
		# lui-même et lit ces fichiers.
		GRUB_CODEBYR="/etc/default/grub.d/90-codebyr-noyau.cfg /etc/default/grub.d/91-codebyr-demarrage.cfg /etc/grub.d/35_codebyr_menu /etc/grub.d/10_linux"
		GRUB_TEMOIN=/var/lib/codebyr/grub.sha256
		if [ -f /boot/grub/grub.cfg ] && [ -x /usr/sbin/update-grub ] \
				&& [ -d /run/systemd/system ] && [ ! -d /run/live ]; then
			GRUB_EMPREINTE="$(cat $GRUB_CODEBYR 2>/dev/null | sha256sum | cut -d' ' -f1)"
			if [ "$(cat "$GRUB_TEMOIN" 2>/dev/null)" != "$GRUB_EMPREINTE" ] \
					|| ! grep -q 'slab_nomerge page_alloc.shuffle=1' /boot/grub/grub.cfg; then
				if /usr/sbin/update-grub >/dev/null 2>&1; then
					mkdir -p /var/lib/codebyr
					echo "$GRUB_EMPREINTE" > "$GRUB_TEMOIN"
				else
					echo "codebyr : update-grub a échoué — relancez-le à la main." >&2
				fi
			fi
		fi

		# Profil AppArmor du filtre réseau. Au démarrage, apparmor.service
		# charge tout /etc/apparmor.d ; sur une machine déjà en marche, un
		# nouveau profil n'agit qu'une fois chargé — d'où cette ligne.
		# Le filtre en cours (Espace Banque ouvert) reste tel quel ; le
		# prochain lancement est confiné.
		# Chemins absolus, pour la même raison que systemd-sysctl ci-dessus.
		if [ -x /usr/sbin/apparmor_parser ] && /usr/bin/aa-enabled --quiet 2>/dev/null; then
			for PROFIL in /etc/apparmor.d/codebyr-net-proxy /etc/apparmor.d/codebyr-uid; do
				[ -f "$PROFIL" ] || continue
				/usr/sbin/apparmor_parser --replace --write-cache "$PROFIL" 2>/dev/null || true
			done
		fi

		# Service des comptes d'Espaces. La socket est activée dès
		# l'installation, mais RIEN ne tourne tant qu'aucun Espace ne demande
		# un compte dédié : le service démarre à la première connexion, et se
		# rendort quand plus aucun Espace n'est ouvert. Depuis la 1.16.1,
		# chaque Espace livré le demande : sans cette socket, aucun ne
		# s'ouvrirait.
		#
		# L'activer maintenant plutôt qu'au premier besoin évite le pire des
		# messages : « cet Espace ne s'ouvre pas, redémarrez ».
		if [ -d /run/systemd/system ] && [ -x /usr/bin/systemctl ]; then
			/usr/bin/systemctl daemon-reload 2>/dev/null || true
			/usr/bin/systemctl enable --now codebyr-uid.socket 2>/dev/null || true
		fi

		# Rattrapage des machines DÉJÀ installées : dossiers personnels privés
		# (0700) et neutralisation du mot de passe public du compte invité.
		# Ces deux correctifs vivaient dans l'image live ou dans le script
		# d'installation — ils n'atteignaient donc jamais un poste existant.
		# « || true » : un durcissement qui échoue ne doit pas bloquer la mise à
		# jour de sécurité du reste du parc.
		if [ -f /usr/bin/codebyr-durcir-poste ]; then
			sh /usr/bin/codebyr-durcir-poste || true
		fi

		# Écran de démarrage (thème Plymouth « codebyr », ou sa version
		# traduite « codebyr-en »… que codebyr-durcir-poste vient de choisir
		# selon la langue du système). Il n'agit pas depuis /usr/share : il
		# est COPIÉ dans l'image de démarrage (initramfs), qui ne voit que ce
		# qu'elle contenait à sa dernière génération. Un thème corrigé, ou qui
		# change de langue, n'arriverait donc jamais à l'écran.
		#
		# APRÈS codebyr-durcir-poste, et pas avant : c'est lui qui choisit le
		# thème. On ne régénère que si le thème actif, ou son contenu, a changé
		# depuis la dernière fois (empreinte gardée dans /var/lib/codebyr) : pas
		# à chaque mise à jour, l'opération prend de longues secondes. Et
		# seulement là où elle sert : un système démarré (pas un chroot de
		# construction, où l'image se génère seule), qui n'est pas une session
		# live, et dont le thème est l'un de ceux de Codebyr.
		#
		# « update-initramfs -u », exactement : dans un script de paquet, il ne
		# s'exécute pas aussitôt, il se donne rendez-vous à la fin d'apt — une
		# seule génération, même si un nouveau noyau arrive en même temps.
		THEMES=/usr/share/plymouth/themes
		TEMOIN=/var/lib/codebyr/plymouth-theme.sha256
		ACTIF=""
		if [ -x /usr/sbin/plymouth-set-default-theme ]; then
			ACTIF="$(/usr/sbin/plymouth-set-default-theme 2>/dev/null || true)"
		fi
		case "$ACTIF" in
			codebyr|codebyr-*) ;;
			*) ACTIF="" ;;
		esac
		if [ -n "$ACTIF" ] && [ -f "$THEMES/$ACTIF/$ACTIF.script" ] \
				&& [ -d /run/systemd/system ] && [ ! -d /run/live ] \
				&& [ -x /usr/sbin/update-initramfs ]; then
			EMPREINTE="$( { echo "$ACTIF"; cat "$THEMES/$ACTIF/$ACTIF.plymouth" \
				"$THEMES/$ACTIF/$ACTIF.script" "$THEMES/codebyr/logo.png"; } 2>/dev/null \
				| sha256sum | cut -d' ' -f1)"
			if [ "$(cat "$TEMOIN" 2>/dev/null)" != "$EMPREINTE" ]; then
				if /usr/sbin/update-initramfs -u; then
					mkdir -p /var/lib/codebyr
					echo "$EMPREINTE" > "$TEMOIN"
				else
					echo "codebyr : update-initramfs a échoué — relancez-le à la main." >&2
				fi
			fi
		fi
		;;
esac

exit 0
