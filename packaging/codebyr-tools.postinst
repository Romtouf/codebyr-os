#!/bin/sh
# Codebyr OS — post-installation de codebyr-tools.
set -e

case "$1" in
	configure)
		# Les scripts codebyr-* doivent être exécutables (ceinture + bretelles).
		for f in /usr/bin/codebyr-*; do
			[ -f "$f" ] && chmod 755 "$f" || true
		done
		# L'extension GNOME est déjà activable par l'utilisateur ; on ne force
		# rien ici (pas de session graphique garantie pendant apt). Un
		# rechargement de l'extension nécessite une reconnexion — signalé au
		# besoin par GNOME lui-même.
		if command -v update-desktop-database >/dev/null 2>&1; then
			update-desktop-database -q /usr/share/applications 2>/dev/null || true
		fi
		# Cache d'icônes. Dès qu'un cache existe, GTK s'y fie et IGNORE les
		# fichiers qui n'y figurent pas : une icône livrée par ce paquet
		# resterait invisible, remplacée par l'icône générique du bureau — un
		# losange gris dans le dock et la vue d'ensemble. Constaté le
		# 13/09/2026 sur une machine où une installation apt avait créé le
		# cache avant que l'icône n'arrive.
		#
		# L'image, elle, n'a aucun cache : GTK y parcourt les dossiers, et les
		# icônes s'affichent sans rien faire.
		if [ -x /usr/sbin/update-icon-caches ]; then
			/usr/sbin/update-icon-caches /usr/share/icons/hicolor 2>/dev/null || true
		elif command -v gtk-update-icon-cache >/dev/null 2>&1; then
			gtk-update-icon-cache -f /usr/share/icons/hicolor 2>/dev/null || true
		fi
		# Trousseau apt : la clé publique du projet évolue (ajout d'une
		# sous-clé de signature, rotation). Le trousseau, lui, a été figé à
		# l'installation — et apt refuse alors une signature parfaitement
		# légitime : « Missing key …, which is needed to verify signature ».
		# Le paquet embarque donc la clé à jour et rafraîchit le trousseau.
		#
		# Ce n'est pas une porte ouverte : ce paquet est déjà signé par cette
		# même clé. Qui peut le remplacer contrôle déjà la machine.
		CLE=/usr/share/codebyr/codebyr-signing-key.asc
		TROUSSEAU=/usr/share/keyrings/codebyr-archive-keyring.gpg
		if [ -f "$CLE" ] && command -v gpg >/dev/null 2>&1; then
			# On écrit à côté puis on déplace : un trousseau à moitié écrit
			# rendrait le dépôt invérifiable, donc la machine non maintenable.
			if gpg --dearmor < "$CLE" > "$TROUSSEAU.neuf" 2>/dev/null; then
				chmod 0644 "$TROUSSEAU.neuf"
				mv "$TROUSSEAU.neuf" "$TROUSSEAU"
			else
				rm -f "$TROUSSEAU.neuf"
			fi
		fi

		# Réglages noyau : un fichier dans /etc/sysctl.d n'est lu qu'au
		# démarrage. Sans cette ligne, la protection arriverait avec la mise à
		# jour mais n'agirait qu'au prochain redémarrage — des jours ou des
		# semaines plus tard sur un portable qu'on met en veille.
		# « || true » : dans un conteneur ou un chroot, le noyau refuse ; ce
		# n'est pas une raison de faire échouer la mise à jour.
		#
		# Chemin absolu : systemd-sysctl n'est PAS dans le PATH sur Debian
		# (/usr/lib/systemd). Un « command -v » le cherchait en vain, la
		# condition restait fausse, et rien ne s'appliquait avant le
		# redémarrage — sans la moindre trace.
		SYSCTL_CODEBYR=/etc/sysctl.d/91-codebyr-noyau.conf
		if [ -f "$SYSCTL_CODEBYR" ] && [ -x /usr/lib/systemd/systemd-sysctl ]; then
			/usr/lib/systemd/systemd-sysctl "$SYSCTL_CODEBYR" 2>/dev/null || true
		fi

		# Profil AppArmor du filtre réseau. Au démarrage, apparmor.service
		# charge tout /etc/apparmor.d ; sur une machine déjà en marche, un
		# nouveau profil n'agit qu'une fois chargé — d'où cette ligne.
		# Le filtre en cours (Espace Banque ouvert) reste tel quel ; le
		# prochain lancement est confiné.
		# Chemins absolus, pour la même raison que systemd-sysctl ci-dessus.
		PROFIL_FILTRE=/etc/apparmor.d/codebyr-net-proxy
		if [ -f "$PROFIL_FILTRE" ] && [ -x /usr/sbin/apparmor_parser ] \
				&& /usr/bin/aa-enabled --quiet 2>/dev/null; then
			/usr/sbin/apparmor_parser --replace --write-cache "$PROFIL_FILTRE" 2>/dev/null || true
		fi

		# Rattrapage des machines DÉJÀ installées : dossiers personnels privés
		# (0700) et neutralisation du mot de passe public du compte invité.
		# Ces deux correctifs vivaient dans l'image live ou dans le script
		# d'installation — ils n'atteignaient donc jamais un poste existant.
		# « || true » : un durcissement qui échoue ne doit pas bloquer la mise à
		# jour de sécurité du reste du parc.
		if [ -f /usr/bin/codebyr-durcir-poste ]; then
			sh /usr/bin/codebyr-durcir-poste || true
		fi
		;;
esac

exit 0
