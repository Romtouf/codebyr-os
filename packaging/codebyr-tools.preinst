#!/bin/sh
# Codebyr OS — pré-installation de codebyr-tools.
set -e

# L'identité du système (/usr/lib/os-release, que /etc/os-release désigne)
# appartient au paquet Debian base-files. Codebyr l'écrivait par un hook de
# l'image : base-files se réinstalle à chaque version mineure de Debian
# (13.5 → 13.6…), et chaque réinstallation aurait rendu « Debian GNU/Linux »
# à toutes les machines, sans que personne ne le décide.
#
# On la DÉTOURNE, comme dpkg le prévoit pour ce cas : la copie de base-files
# est rangée sous /usr/lib/os-release.debian, et celle de Codebyr, livrée par
# ce paquet, suit ses mises à jour — version comprise. Le postrm défait tout.
#
# Avant l'installation des fichiers, et pas après : c'est ce qui permet à ce
# paquet de livrer un chemin qui appartient à un autre.
#
# COPIER, ET NON DÉPLACER (« --no-rename ») : base-files est un paquet
# « Essential », dont les fichiers ne doivent jamais manquer, pas même le
# temps d'une installation. « --rename » les déplaçait, et dpkg le signalait
# à l'écran (« dangereux, utilisez --no-rename »).
# On range donc une COPIE, et le fichier reste en place jusqu'à ce que celui
# de Codebyr le remplace. Seulement à la création de la déviation : ensuite,
# /usr/lib/os-release est celui de Codebyr, et la copie de base-files est
# tenue à jour par dpkg lui-même.
DEBIAN_OS_RELEASE=/usr/lib/os-release.debian

# L'avatar par défaut des nouveaux comptes (/etc/skel/.face) appartient à
# desktop-base : c'est la spirale Debian, que GNOME montrait sur l'écran de
# connexion et de verrouillage. Détourné de la même façon, pour livrer le
# Sceau ; la copie de desktop-base est rangée à côté (.face.desktop-base).
#
# C'est une conffile de desktop-base. dpkg suit la déviation : une mise à jour
# de desktop-base compare et remplace la copie rangée, sans question (vérifié
# sur une copie du système de l'ISO 1.16.8). unattended-upgrades,
# lui, lit /etc/skel/.face sans la suivre : il ne laisserait desktop-base de
# côté que si Debian changeait cette image — un nouveau thème, donc une
# nouvelle version majeure, qu'il n'installe pas de toute façon.
DEBIAN_FACE=/etc/skel/.face.desktop-base

# Le script qui écrit les entrées Linux du menu de GRUB (/etc/grub.d/10_linux)
# appartient à grub-common, dont c'est une conffile. Détourné de la même façon,
# vers un sous-dossier que grub-mkconfig ne parcourt pas (/etc/grub.d/debian/) :
# celui de Codebyr l'appelle, et retire de ce qu'il écrit les messages
# « Loading Linux … » de l'entrée par défaut (voir packaging/grub/10_linux).
# Jamais une copie de celui de Codebyr, qui s'appellerait alors lui-même.
DEBIAN_10_LINUX=/etc/grub.d/debian/10_linux

case "$1" in
	install|upgrade)
		if [ "$(dpkg-divert --listpackage /usr/lib/os-release)" != "codebyr-tools" ]; then
			if [ -e /usr/lib/os-release ] && [ ! -e "$DEBIAN_OS_RELEASE" ]; then
				cp -a /usr/lib/os-release "$DEBIAN_OS_RELEASE"
			fi
			dpkg-divert --package codebyr-tools --add --no-rename \
				--divert "$DEBIAN_OS_RELEASE" /usr/lib/os-release >/dev/null
		fi
		if [ "$(dpkg-divert --listpackage /etc/skel/.face)" != "codebyr-tools" ]; then
			if [ -e /etc/skel/.face ] && [ ! -e "$DEBIAN_FACE" ]; then
				cp -a /etc/skel/.face "$DEBIAN_FACE"
			fi
			dpkg-divert --package codebyr-tools --add --no-rename \
				--divert "$DEBIAN_FACE" /etc/skel/.face >/dev/null
		fi
		if [ "$(dpkg-divert --listpackage /etc/grub.d/10_linux)" != "codebyr-tools" ]; then
			mkdir -p /etc/grub.d/debian
			if [ -e /etc/grub.d/10_linux ] && [ ! -e "$DEBIAN_10_LINUX" ] \
					&& ! grep -q "codebyr:enveloppe-10_linux" /etc/grub.d/10_linux; then
				cp -a /etc/grub.d/10_linux "$DEBIAN_10_LINUX"
			fi
			dpkg-divert --package codebyr-tools --add --no-rename \
				--divert "$DEBIAN_10_LINUX" /etc/grub.d/10_linux >/dev/null
		fi
		;;
esac

exit 0
