msgid "Ouvrir un lien en Jetable"
msgstr "Open a link in Disposable"

#: usr/share/gnome-shell/extensions/codebyr@codebyr.io/extension.js
msgid "Le lien s'ouvrira dans une bulle isolée qui s'autodétruit à la fermeture."
msgstr "The link will open in an isolated bubble that self-destructs when closed."

