msgid "Rien à transférer. Copiez d'abord un texte (Ctrl+C) dans un Espace, puis rouvrez ce menu."
msgstr "Nothing to send. First copy some text (Ctrl+C) in a Space, then reopen this menu."

#: usr/share/gnome-shell/extensions/codebyr@codebyr.io/extension.js
msgid "Transférer le presse-papiers"
msgstr "Send the clipboard"

#: usr/share/gnome-shell/extensions/codebyr@codebyr.io/extension.js
msgid "Contenu copié depuis « {source} » ({n} caractère)."
msgid_plural "Contenu copié depuis « {source} » ({n} caractères)."
msgstr[0] "Copied from “{source}” ({n} character)."
msgstr[1] "Copied from “{source}” ({n} characters)."

#: usr/share/gnome-shell/extensions/codebyr@codebyr.io/extension.js
msgid "Contenu copié ({n} caractère)."
